---
export interface Props {
	zh: string;
	en: string;
	as?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "strong" | "small" | "label" | "summary" | "option";
	class?: string;
}
const { zh, en, as: Tag = "span", class: className }: Props = Astro.props;
---
<Tag class={className} data-i18n="explore.text" data-i18n-zh={zh} data-i18n-en={en}>{zh}</Tag>
