---
import Text from "@/components/common/BilingualText.astro";

const links = [
	[
		"/world/",
		"研究岛",
		"Research island",
		"进入智能研究工作室",
		"Enter the research workshop",
	],
	[
		"/graph/",
		"认知星系",
		"Knowledge graph",
		"全站知识拓扑与生命周期",
		"Topological cosmos & idea lifecycles",
	],
	[
		"/rsi/",
		"RSI 导读",
		"RSI guide",
		"从长期问题开始",
		"Start with the question",
	],
	["/library/", "文献架", "Library", "回到原始资料", "Go to the sources"],
	["/lab/", "实验室", "Lab", "动手改变一个参数", "Change a parameter"],
	[
		"/essays/",
		"交互长卷",
		"Interactive essays",
		"可以动手读的长文",
		"Essays you can operate",
	],
];
---

<details class="explore-menu">
	<summary>
		<Text zh="探索" en="Explore" />
		<span aria-hidden="true">＋</span>
	</summary>
	<div class="explore-dropdown">
		{links.map(([href, title, titleEn, description, descriptionEn]) => (
			<a href={href}>
				<Text as="strong" zh={title} en={titleEn} />
				<Text as="small" zh={description} en={descriptionEn} />
			</a>
		))}
	</div>
</details>
<script>
	document
		.querySelectorAll<HTMLDetailsElement>(".explore-menu")
		.forEach((menu) => {
			menu.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && menu.open) {
					menu.open = false;
					menu.querySelector("summary")?.focus();
				}
			});
			document.addEventListener("click", (event) => {
				if (event.target instanceof Node && !menu.contains(event.target))
					menu.open = false;
			});
		});
</script>
<style>
	.explore-menu {
		position: relative;
		color: var(--brand-body);
		font: 12px/1 var(--font-sans, Inter, "PingFang SC", sans-serif);
		flex-shrink: 0;
	}
	.explore-menu summary {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 36px;
		padding: 0 12px;
		border: 1px solid var(--brand-line);
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
		list-style: none;
		white-space: nowrap;
		transition:
			border-color var(--motion-fast, 160ms),
			color var(--motion-fast, 160ms),
			background-color var(--motion-fast, 160ms);
	}
	.explore-menu summary::-webkit-details-marker {
		display: none;
	}
	.explore-menu summary:hover,
	.explore-menu[open] summary {
		border-color: var(--brand-accent);
		color: var(--brand-accent);
		background: var(--brand-surface);
	}
	.explore-menu summary > span:last-child {
		font-size: 12px;
		color: var(--brand-accent);
	}
	.explore-dropdown {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		width: 256px;
		max-width: 85vw;
		z-index: 80;
		padding: 10px;
		border: 1px solid var(--brand-line);
		border-radius: 14px;
		background: var(--brand-paper);
		box-shadow: 0 16px 40px rgba(37, 60, 52, 0.12);
	}
	.explore-dropdown a {
		display: grid;
		gap: 5px;
		padding: 11px 12px;
		border-radius: 8px;
		text-decoration: none;
		color: var(--brand-ink);
		transition: background-color var(--motion-fast, 160ms);
	}
	.explore-dropdown a:hover {
		background: var(--brand-surface);
	}
	.explore-dropdown :global(strong) {
		font: 500 13px/1.5 var(--font-sans, Inter, sans-serif);
	}
	.explore-dropdown :global(small) {
		font: 11px/1.5 var(--font-sans, Inter, sans-serif);
		color: var(--brand-muted);
	}
	@media (max-width: 700px) {
		.explore-menu summary {
			height: 40px;
			padding: 0 11px;
		}
	}
</style>
