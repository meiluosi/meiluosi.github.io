---
import Text from "@/components/common/BilingualText.astro";

const links = [
	[
		"/routes/",
		"智能路线",
		"20 Routes",
		"人类探索智能的 20 个解释家族与思想罗盘",
		"Twenty paradigm families & quadrant compass",
	],
	[
		"/books/",
		"书稿与专著",
		"Living Books",
		"三部体系化分卷连载的在线交互专著",
		"Multi-volume interactive monographs",
	],
	[
		"/lab/",
		"交互实验室",
		"Interactive Lab",
		"算法沙盒、风吹动力兽与交互长卷",
		"Algorithm sandboxes, Strandbeest & interactive essays",
	],
	[
		"/graph/",
		"知识星图与文献",
		"Cosmos & Library",
		"全站知识拓扑网络与原始文献资料架",
		"Knowledge graph cosmos & annotated reference library",
	],
];
---

<details class="explore-menu">
	<summary>
		<Text zh="探索" en="Explore" />
		<span aria-hidden="true">＋</span>
	</summary>
	<div class="explore-dropdown">
		{links.map(([href, title, titleEn, description, descriptionEn]) => (
			<a href={href}>
				<Text as="strong" zh={title} en={titleEn} />
				<Text as="small" zh={description} en={descriptionEn} />
			</a>
		))}
	</div>
</details>
<script>
	document
		.querySelectorAll<HTMLDetailsElement>(".explore-menu")
		.forEach((menu) => {
			menu.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && menu.open) {
					menu.open = false;
					menu.querySelector("summary")?.focus();
				}
			});
			document.addEventListener("click", (event) => {
				if (event.target instanceof Node && !menu.contains(event.target))
					menu.open = false;
			});
		});
</script>
<style>
	.explore-menu {
		position: relative;
		color: var(--brand-body);
		font: 12px/1 var(--font-sans, Inter, "PingFang SC", sans-serif);
		flex-shrink: 0;
	}
	.explore-menu summary {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		height: 36px;
		padding: 0 12px;
		border: 1px solid var(--brand-line);
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
		list-style: none;
		white-space: nowrap;
		transition:
			border-color var(--motion-fast, 160ms),
			color var(--motion-fast, 160ms),
			background-color var(--motion-fast, 160ms);
	}
	.explore-menu summary::-webkit-details-marker {
		display: none;
	}
	.explore-menu summary:hover,
	.explore-menu[open] summary {
		border-color: var(--brand-accent);
		color: var(--brand-accent);
		background: var(--brand-surface);
	}
	.explore-menu summary > span:last-child {
		font-size: 12px;
		color: var(--brand-accent);
	}
	.explore-dropdown {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		width: 268px;
		max-width: 85vw;
		z-index: 80;
		padding: 10px;
		border: 1px solid var(--brand-line);
		border-radius: 14px;
		background: var(--brand-paper);
		box-shadow: 0 16px 40px rgba(37, 60, 52, 0.12);
	}
	.explore-dropdown a {
		display: grid;
		gap: 5px;
		padding: 11px 12px;
		border-radius: 8px;
		text-decoration: none;
		color: var(--brand-ink);
		transition: background-color var(--motion-fast, 160ms);
	}
	.explore-dropdown a:hover {
		background: var(--brand-surface);
	}
	.explore-dropdown :global(strong) {
		font: 500 13px/1.5 var(--font-sans, Inter, sans-serif);
	}
	.explore-dropdown :global(small) {
		font: 11px/1.5 var(--font-sans, Inter, sans-serif);
		color: var(--brand-muted);
	}
	@media (max-width: 700px) {
		.explore-menu summary {
			height: 40px;
			padding: 0 11px;
		}
	}
</style>
