---
/**
 * GardenMaturityBadge.astro
 *
 * Displays Digital Garden thought maturity lifecycle for an article:
 * 🌱 Seedling | 🌿 Budding | 🌳 Evergreen | 🔬 Speculative | ⚙️ Lab
 * Includes interactive disclosure explaining digital garden evergreen philosophy.
 */
import { getPostMaturity, type MaturityMeta } from "@/utils/digital-garden";

interface Props {
	post: {
		id: string;
		data: {
			maturity?: "seedling" | "budding" | "evergreen" | "speculative";
			format?: string;
			title?: string;
			category?: string | null;
		};
	};
	lang?: "zh" | "en";
}

const { post, lang = "zh" } = Astro.props;
const maturity: MaturityMeta = getPostMaturity(post);
const isZh = lang === "zh";
---

<div class="garden-maturity-container onload-animation" data-garden-maturity>
	<div class="maturity-main-row">
		<div class="badge-tag" style={`--badge-color: ${maturity.color}; --badge-bg: ${maturity.badgeBg};`}>
			<span class="badge-icon" aria-hidden="true">{maturity.icon}</span>
			<span class="badge-label" data-i18n-zh={maturity.labelZh} data-i18n-en={maturity.labelEn}>
				{isZh ? maturity.labelZh : maturity.labelEn}
			</span>
		</div>

		<p class="maturity-desc" data-i18n-zh={maturity.descriptionZh} data-i18n-en={maturity.descriptionEn}>
			{isZh ? maturity.descriptionZh : maturity.descriptionEn}
		</p>

		<details class="garden-philosophy-drawer">
			<summary class="philosophy-trigger">
				<span class="trigger-icon">ℹ</span>
				<span class="trigger-text" data-i18n-zh="数字花园" data-i18n-en="Digital Garden">
					{isZh ? "数字花园" : "Digital Garden"}
				</span>
			</summary>
			<div class="philosophy-popover">
				<h4 data-i18n-zh="🌿 什么是数字花园与思想演进？" data-i18n-en="🌿 What is a Digital Garden?">
					{isZh ? "🌿 什么是数字花园与思想演进？" : "🌿 What is a Digital Garden?"}
				</h4>
				<p data-i18n-zh="遵循 Maggie Appleton 与 Andy Matuschak 的常青笔记理念：这里不是按时间沉底的流水账，而是持续修剪打磨的知识生态。文章按成熟度经历：" data-i18n-en="Rooted in Andy Matuschak & Maggie Appleton's evergreen note taxonomy: articles are not ephemeral chronologies, but living organisms tended over time:">
					{isZh ? "遵循 Maggie Appleton 与 Andy Matuschak 的常青笔记理念：这里不是按时间沉底的流水账，而是持续修剪打磨的知识生态。文章按成熟度经历：" : "Rooted in Andy Matuschak & Maggie Appleton's evergreen note taxonomy: articles are not ephemeral chronologies, but living organisms tended over time:"}
				</p>
				<ul class="stages-list">
					<li><strong>🌱 {isZh ? "萌芽 (Seedling)" : "Seedling"}</strong>: {isZh ? "发散灵感、读书摘录、开放猜想" : "Raw inspiration, reading logs, open questions"}</li>
					<li><strong>🌿 {isZh ? "演进 (Budding)" : "Budding"}</strong>: {isZh ? "结构渐明、初步代码推导、积极修正" : "Structured thesis, early proofs, actively revised"}</li>
					<li><strong>🌳 {isZh ? "常青 (Evergreen)" : "Evergreen"}</strong>: {isZh ? "逻辑闭环、持久经得起检验的基石" : "Closed logic, enduring, foundational reference"}</li>
					<li><strong>🔬 {isZh ? "实验待证 (Speculative)" : "Speculative"}</strong>: {isZh ? "结合沙盒与仿真探针的理论探索" : "Empirical hypotheses coupled with lab instruments"}</li>
				</ul>
				<a href="/notes/" class="garden-explore-link" data-i18n-zh="浏览全站数字花园与笔记全景 →" data-i18n-en="Explore full Digital Garden →">
					{isZh ? "浏览全站数字花园与笔记全景 →" : "Explore full Digital Garden →"}
				</a>
			</div>
		</details>
	</div>
</div>

<style>
	.garden-maturity-container {
		margin-bottom: 1.25rem;
		padding: 0.65rem 0.9rem;
		border-radius: 10px;
		background: var(--brand-surface);
		border: 1px solid var(--brand-line);
		font-size: 13px;
		transition: border-color 0.2s ease;
	}

	.garden-maturity-container:hover {
		border-color: var(--brand-accent);
	}

	.maturity-main-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.badge-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--badge-bg);
		border: 1px solid var(--badge-color);
		color: var(--badge-color);
		font-size: 12px;
		font-weight: 600;
		line-height: 1.3;
		white-space: nowrap;
	}

	.badge-icon {
		font-size: 14px;
	}

	.maturity-desc {
		margin: 0;
		flex: 1 1 200px;
		color: var(--brand-muted);
		font-size: 12.5px;
		line-height: 1.45;
	}

	.garden-philosophy-drawer {
		position: relative;
		margin-left: auto;
	}

	.philosophy-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 11.5px;
		color: var(--brand-muted);
		cursor: pointer;
		user-select: none;
		list-style: none;
		padding: 2px 6px;
		border-radius: 4px;
		border: 1px dashed var(--brand-line);
		transition: all 0.15s ease;
	}

	.philosophy-trigger::-webkit-details-marker {
		display: none;
	}

	.philosophy-trigger:hover {
		color: var(--brand-accent);
		border-color: var(--brand-accent);
	}

	.trigger-icon {
		font-size: 11px;
		font-weight: bold;
		opacity: 0.75;
	}

	.philosophy-popover {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		z-index: 40;
		width: min(340px, 90vw);
		background: var(--brand-paper);
		border: 1px solid var(--brand-line);
		border-radius: 10px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
		padding: 14px;
		color: var(--brand-ink);
		font-size: 12px;
		line-height: 1.5;
	}

	.philosophy-popover h4 {
		margin: 0 0 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--brand-accent);
	}

	.philosophy-popover p {
		margin: 0 0 8px;
		color: var(--brand-body);
	}

	.stages-list {
		margin: 0 0 10px;
		padding-left: 16px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		color: var(--brand-muted);
	}

	.stages-list strong {
		color: var(--brand-ink);
	}

	.garden-explore-link {
		display: inline-block;
		font-size: 11.5px;
		color: var(--brand-accent);
		text-decoration: none;
		font-weight: 500;
		margin-top: 4px;
	}

	.garden-explore-link:hover {
		text-decoration: underline;
	}
</style>
