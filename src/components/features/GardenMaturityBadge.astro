---
/**
 * GardenMaturityBadge.astro
 *
 * Displays Digital Garden thought maturity lifecycle for an article:
 * 🌱 Seedling | 🌿 Budding | 🌳 Evergreen | 🔬 Speculative | ⚙️ Lab
 * Includes interactive disclosure explaining digital garden evergreen philosophy.
 */
import { getPostMaturity, type MaturityMeta } from "@/utils/digital-garden";

interface Props {
	post: {
		id: string;
		data: {
			maturity?: "seedling" | "budding" | "evergreen" | "speculative";
			format?: string;
			title?: string;
			category?: string | null;
		};
	};
	lang?: "zh" | "en";
}

const { post, lang = "zh" } = Astro.props;
const maturity: MaturityMeta = getPostMaturity(post);
const isZh = lang === "zh";

// The badge is rendered on Chinese article pages, so it starts in Chinese. The
// `data-i18n` key is what lets the client-side language switch rewrite it:
// both the pre-paint pass and the switcher look for the key plus an explicit
// per-language value. Without the key the badge stayed Chinese on English
// pages.
const gardenCopy = {
	trigger: { zh: "数字花园", en: "Digital Garden" },
	title: {
		zh: "🌿 什么是数字花园与思想演进？",
		en: "🌿 What is a Digital Garden?",
	},
	intro: {
		zh: "遵循 Maggie Appleton 与 Andy Matuschak 的常青笔记理念：这里不是按时间沉底的流水账，而是持续修剪打磨的知识生态。文章按成熟度经历：",
		en: "Rooted in Andy Matuschak & Maggie Appleton's evergreen note taxonomy: articles are not ephemeral chronologies, but living organisms tended over time:",
	},
	explore: {
		zh: "浏览全站数字花园与笔记全景 →",
		en: "Explore full Digital Garden →",
	},
	stages: [
		{
			zh: "<strong>🌱 萌芽 (Seedling)</strong>: 发散灵感、读书摘录、开放猜想",
			en: "<strong>🌱 Seedling</strong>: Raw inspiration, reading logs, open questions",
		},
		{
			zh: "<strong>🌿 演进 (Budding)</strong>: 结构渐明、初步代码推导、积极修正",
			en: "<strong>🌿 Budding</strong>: Structured thesis, early proofs, actively revised",
		},
		{
			zh: "<strong>🌳 常青 (Evergreen)</strong>: 逻辑闭环、持久经得起检验的基石",
			en: "<strong>🌳 Evergreen</strong>: Closed logic, enduring, foundational reference",
		},
		{
			zh: "<strong>🔬 实验待证 (Speculative)</strong>: 结合沙盒与仿真探针的理论探索",
			en: "<strong>🔬 Speculative</strong>: Empirical hypotheses coupled with lab instruments",
		},
	],
};
---

<div class="garden-maturity-container onload-animation" data-garden-maturity>
	<div class="maturity-main-row">
		<div class="badge-tag" style={`--badge-color: ${maturity.color}; --badge-bg: ${maturity.badgeBg};`}>
			<span class="badge-icon" aria-hidden="true">{maturity.icon}</span>
			<span class="badge-label" data-i18n={`notes.maturity.${maturity.level}`} data-i18n-zh={maturity.labelZh} data-i18n-en={maturity.labelEn}>
				{isZh ? maturity.labelZh : maturity.labelEn}
			</span>
		</div>

		<p class="maturity-desc" data-i18n="garden.maturity.desc" data-i18n-zh={maturity.descriptionZh} data-i18n-en={maturity.descriptionEn}>
			{isZh ? maturity.descriptionZh : maturity.descriptionEn}
		</p>

		<details class="garden-philosophy-drawer">
			<summary class="philosophy-trigger">
				<span class="trigger-icon">ℹ</span>
				<span class="trigger-text" data-i18n="garden.trigger" data-i18n-zh={gardenCopy.trigger.zh} data-i18n-en={gardenCopy.trigger.en}>
					{isZh ? gardenCopy.trigger.zh : gardenCopy.trigger.en}
				</span>
			</summary>
			<div class="philosophy-popover">
				<h4 data-i18n="garden.title" data-i18n-zh={gardenCopy.title.zh} data-i18n-en={gardenCopy.title.en}>
					{isZh ? gardenCopy.title.zh : gardenCopy.title.en}
				</h4>
				<p data-i18n="garden.intro" data-i18n-zh={gardenCopy.intro.zh} data-i18n-en={gardenCopy.intro.en}>
					{isZh ? gardenCopy.intro.zh : gardenCopy.intro.en}
				</p>
				<ul class="stages-list">
					{gardenCopy.stages.map((stage) => (
						<li
							data-i18n="garden.stage"
							data-i18n-html="true"
							data-i18n-zh={stage.zh}
							data-i18n-en={stage.en}
							set:html={isZh ? stage.zh : stage.en}
						/>
					))}
				</ul>
				<a href="/notes/" class="garden-explore-link" data-i18n="garden.explore" data-i18n-zh={gardenCopy.explore.zh} data-i18n-en={gardenCopy.explore.en}>
					{isZh ? gardenCopy.explore.zh : gardenCopy.explore.en}
				</a>
			</div>
		</details>
	</div>
</div>

<style>
	.garden-maturity-container {
		margin-bottom: 1.25rem;
		padding: 0.65rem 0.9rem;
		border-radius: 10px;
		background: var(--brand-surface);
		border: 1px solid var(--brand-line);
		font-size: 13px;
		transition: border-color 0.2s ease;
	}

	.garden-maturity-container:hover {
		border-color: var(--brand-accent);
	}

	.maturity-main-row {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.badge-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.55rem;
		border-radius: 6px;
		background: var(--badge-bg);
		border: 1px solid var(--badge-color);
		color: var(--badge-color);
		font-size: 12px;
		font-weight: 600;
		line-height: 1.3;
		white-space: nowrap;
	}

	.badge-icon {
		font-size: 14px;
	}

	.maturity-desc {
		margin: 0;
		flex: 1 1 200px;
		color: var(--brand-muted);
		font-size: 12.5px;
		line-height: 1.45;
	}

	.garden-philosophy-drawer {
		position: relative;
		margin-left: auto;
	}

	.philosophy-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 11.5px;
		color: var(--brand-muted);
		cursor: pointer;
		user-select: none;
		list-style: none;
		padding: 2px 6px;
		border-radius: 4px;
		border: 1px dashed var(--brand-line);
		transition: all 0.15s ease;
	}

	.philosophy-trigger::-webkit-details-marker {
		display: none;
	}

	.philosophy-trigger:hover {
		color: var(--brand-accent);
		border-color: var(--brand-accent);
	}

	.trigger-icon {
		font-size: 11px;
		font-weight: bold;
		opacity: 0.75;
	}

	.philosophy-popover {
		position: absolute;
		right: 0;
		top: calc(100% + 8px);
		z-index: 40;
		width: min(340px, 90vw);
		background: var(--brand-paper);
		border: 1px solid var(--brand-line);
		border-radius: 10px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
		padding: 14px;
		color: var(--brand-ink);
		font-size: 12px;
		line-height: 1.5;
	}

	.philosophy-popover h4 {
		margin: 0 0 8px;
		font-size: 13px;
		font-weight: 600;
		color: var(--brand-accent);
	}

	.philosophy-popover p {
		margin: 0 0 8px;
		color: var(--brand-body);
	}

	.stages-list {
		margin: 0 0 10px;
		padding-left: 16px;
		display: flex;
		flex-direction: column;
		gap: 4px;
		color: var(--brand-muted);
	}

	.stages-list strong {
		color: var(--brand-ink);
	}

	.garden-explore-link {
		display: inline-block;
		font-size: 11.5px;
		color: var(--brand-accent);
		text-decoration: none;
		font-weight: 500;
		margin-top: 4px;
	}

	.garden-explore-link:hover {
		text-decoration: underline;
	}
</style>
