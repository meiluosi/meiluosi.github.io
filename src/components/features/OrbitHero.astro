---

<section class="orbit-hero-wrapper" aria-label="核心思考与探索轨道">
	<div class="orbit-stage" id="orbit-stage" data-brand-motion>
		<!-- 漫射光晕与星云场 -->
		<div class="space-glow" aria-hidden="true"></div>

		<!-- 天体轨道与星体系统 -->
		<div class="kepler-system" id="kepler-system">
			<!-- 轨道线与行星 -->
			{planets.map((planet) => (
				<div 
					class={`orbit-ring orbit-ring-${planet.orbitIndex}`} 
					style={`--orbit-duration: ${planet.speed}; --orbit-delay: ${planet.delay};`}
					data-planet-id={planet.id}
				>
					<div class="orbit-track" aria-hidden="true"></div>
					<div class="planet-carrier">
						<button 
							type="button"
							class="planet-node" 
							data-planet-btn={planet.id}
							aria-label={`${planet.nameZh} / ${planet.nameEn}`}
							title={`${planet.nameZh}: ${planet.questionZh}`}
						>
							<span class="planet-sphere" style={`--planet-color: ${planet.color};`}>
								<span class="planet-core"></span>
								<span class="planet-aura"></span>
							</span>
							<span class="planet-badge">
								<span class="badge-roman">{planet.roman}</span>
								<Text class="badge-label" zh={planet.nameZh} en={planet.nameEn} />
							</span>
						</button>
					</div>
				</div>
			))}

			<!-- 核心引力源：何谓智能？ -->
			<div class="gravitational-center">
				<div class="sun-flare" aria-hidden="true"></div>
				<div class="center-content">
					<p class="super-title">
						<Text zh="本质课题" en="FOUNDATIONAL INQUIRY" />
					</p>
					<h1 class="core-title">
						<Text zh="何谓智能？" en="What is Intelligence?" />
					</h1>
					<p class="core-sub">
						<Text 
							zh="从物理具身、语言表征，到因果决策与递归自我重构。" 
							en="From embodied physics and latent spaces to causal reasoning and recursive self-improvement." 
						/>
					</p>
				</div>
			</div>
		</div>

		<!-- 动态问答展板（随悬停或点击行星而共振联动） -->
		<div class="orbit-inspector" id="orbit-inspector" aria-live="polite">
			{planets.map((planet, idx) => (
				<div 
					class={`inspector-card ${idx === 0 ? "is-active" : ""}`} 
					data-card-id={planet.id}
				>
					<div class="card-meta">
						<span class="card-tag">
							<span class="tag-roman">{planet.roman}</span>
							<Text zh={planet.nameZh} en={planet.nameEn} />
						</span>
						<span class="card-clues">
							<Text zh={planet.cluesZh} en={planet.cluesEn} />
						</span>
					</div>
					<p class="card-question">
						<Text zh={planet.questionZh} en={planet.questionEn} />
					</p>
					<div class="card-routes">
						<span class="routes-label"><Text zh="覆盖路线专题：" en="Inquiry Routes:" /></span>
						<div class="routes-pills">
							{planet.routes.map((r) => (
								<a href={`/routes/${r.id}/`} class="planet-route-pill" title={`进入路线专题：${r.roman} ${r.nameZh}`}>
									<span class="pill-roman">{r.roman}</span>
									<Text zh={r.nameZh} en={r.nameEn} />
									<span aria-hidden="true" class="mini-arrow">↗</span>
								</a>
							))}
						</div>
					</div>
					<div class="card-action">
						<a href={planet.href} class="inspector-link">
							<Text zh={planet.linkTextZh} en={planet.linkTextEn} />
							<span aria-hidden="true" class="arrow">→</span>
						</a>
					</div>
				</div>
			))}
		</div>

		<!-- 移动端与键盘可访问快捷导航按键 -->
		<div class="orbit-quick-nav" role="tablist" aria-label="探索轨道选择">
			{planets.map((planet, idx) => (
				<button 
					type="button" 
					role="tab"
					class={`quick-btn ${idx === 0 ? "active" : ""}`} 
					data-quick-target={planet.id}
					aria-selected={idx === 0 ? "true" : "false"}
				>
					<span class="nav-dot" style={`background-color: ${planet.color};`}></span>
					<Text zh={planet.nameZh} en={planet.nameEn} />
				</button>
			))}
		</div>

		<!-- 通往 20 路线地图的专属入口 -->
		<div class="atlas-bridge">
			<a href="/routes/" class="atlas-link">
				<span class="atlas-icon">🧭</span>
				<Text zh="查看智能的 20 个路线家族与分歧地图" en="Explore the 20 Paradigm Families & Divergence Map" />
				<span aria-hidden="true" class="arrow">↗</span>
			</a>
		</div>
	</div>
</section>

<script>
	function initOrbitHero() {
		const stage = document.getElementById("orbit-stage");
		const kepler = document.getElementById("kepler-system");
		if (!stage || !kepler) return;

		const cards = stage.querySelectorAll<HTMLElement>(".inspector-card");
		const planetBtns = stage.querySelectorAll<HTMLElement>("[data-planet-btn]");
		const quickBtns = stage.querySelectorAll<HTMLElement>("[data-quick-target]");
		const rings = stage.querySelectorAll<HTMLElement>(".orbit-ring");

		let isLockedByUser = false;
		let lockTimer: number | undefined;

		function activatePlanet(id: string, lock = false) {
			if (lock) {
				isLockedByUser = true;
				window.clearTimeout(lockTimer);
				lockTimer = window.setTimeout(() => {
					isLockedByUser = false;
				}, 6000);
			}

			// 更新卡片激活状态
			cards.forEach((card) => {
				const matches = card.dataset.cardId === id;
				card.classList.toggle("is-active", matches);
			});

			// 更新快捷按钮状态
			quickBtns.forEach((btn) => {
				const matches = btn.dataset.quickTarget === id;
				btn.classList.toggle("active", matches);
				btn.setAttribute("aria-selected", matches ? "true" : "false");
			});

			// 高亮对应轨道
			rings.forEach((ring) => {
				const matches = ring.dataset.planetId === id;
				ring.classList.toggle("is-focused", matches);
			});
		}

		// 绑定行星按钮悬停与点击
		planetBtns.forEach((btn) => {
			const id = btn.dataset.planetBtn;
			if (!id) return;

			btn.addEventListener("mouseenter", () => {
				if (!isLockedByUser) {
					activatePlanet(id, false);
				}
			});

			btn.addEventListener("click", (e) => {
				e.stopPropagation();
				activatePlanet(id, true);
			});

			btn.addEventListener("focus", () => {
				activatePlanet(id, false);
			});
		});

		// 绑定快捷按钮点击
		quickBtns.forEach((btn) => {
			const id = btn.dataset.quickTarget;
			if (!id) return;

			btn.addEventListener("click", () => {
				activatePlanet(id, true);
			});
		});

		// 3D 鼠标引力透镜视差交互（克制微妙）
		let mouseMoveReq: number | undefined;
		const handlePointerMove = (e: PointerEvent) => {
			if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
			const rect = stage.getBoundingClientRect();
			const x = e.clientX - rect.left - rect.width / 2;
			const y = e.clientY - rect.top - rect.height / 2;

			if (mouseMoveReq) cancelAnimationFrame(mouseMoveReq);
			mouseMoveReq = requestAnimationFrame(() => {
				const tiltX = -(y / (rect.height / 2)) * 3.5; // max ±3.5deg
				const tiltY = (x / (rect.width / 2)) * 4.5;  // max ±4.5deg
				kepler.style.setProperty("--tilt-x", `${tiltX.toFixed(2)}deg`);
				kepler.style.setProperty("--tilt-y", `${tiltY.toFixed(2)}deg`);
			});
		};

		const handlePointerLeave = () => {
			if (mouseMoveReq) cancelAnimationFrame(mouseMoveReq);
			kepler.style.setProperty("--tilt-x", "0deg");
			kepler.style.setProperty("--tilt-y", "0deg");
		};

		stage.addEventListener("pointermove", handlePointerMove, { passive: true });
		stage.addEventListener("pointerleave", handlePointerLeave, { passive: true });
	}

	// 监听初次加载以及 Swup 页面转换
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initOrbitHero, { once: true });
	} else {
		initOrbitHero();
	}
	document.addEventListener("swup:contentReplaced", initOrbitHero);
</script>

<style>
	.orbit-hero-wrapper {
		position: relative;
		width: 100%;
		padding-top: 18px;
		padding-bottom: 34px;
		border-bottom: 1px solid var(--brand-line);
		overflow: hidden;
	}

	.orbit-stage {
		position: relative;
		width: 100%;
		max-width: 1100px;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-block: 28px 16px;
		perspective: 1200px;
	}

	/* 柔和背景微晕 */
	.space-glow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: 
			radial-gradient(circle at 50% 40%, rgb(243 199 172 / 24%) 0%, transparent 58%),
			radial-gradient(circle at 30% 65%, rgb(213 228 216 / 45%) 0%, transparent 62%),
			radial-gradient(circle at 75% 35%, rgb(77 111 128 / 10%) 0%, transparent 55%);
		filter: blur(28px);
		z-index: 0;
	}

	/* 开普勒天体轨道系统容器 */
	.kepler-system {
		position: relative;
		width: 100%;
		height: 380px;
		display: grid;
		place-items: center;
		transform-style: preserve-3d;
		transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.4, 1);
		z-index: 1;
	}

	/* 引力中心核心 */
	.gravitational-center {
		position: relative;
		z-index: 10;
		text-align: center;
		pointer-events: auto;
		max-width: 32em;
		padding: 12px 24px;
		border-radius: 999px;
		background: radial-gradient(circle, rgb(250 251 248 / 92%) 0%, rgb(243 246 241 / 82%) 65%, transparent 100%);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.sun-flare {
		position: absolute;
		inset: -14px;
		border-radius: 999px;
		background: radial-gradient(circle, rgb(243 199 172 / 45%) 0%, rgb(65 99 79 / 8%) 60%, transparent 80%);
		filter: blur(12px);
		z-index: -1;
		animation: pulseFlare 6s ease-in-out infinite alternate;
	}

	@keyframes pulseFlare {
		0% { transform: scale(0.96); opacity: 0.6; }
		100% { transform: scale(1.05); opacity: 0.95; }
	}

	.super-title {
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--brand-clay);
		margin: 0 0 6px 0;
		font-weight: 500;
	}

	.core-title {
		margin: 0;
		font-family: var(--font-serif, "Songti SC", Georgia, serif);
		font-size: clamp(34px, 4.4vw, 52px);
		line-height: 1.25;
		font-weight: 400;
		color: var(--brand-ink);
		letter-spacing: -0.015em;
	}

	.core-sub {
		margin: 8px 0 0;
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--brand-body);
		font-family: var(--font-sans, sans-serif);
		letter-spacing: 0.01em;
	}

	/* 轨道环结构 */
	.orbit-ring {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		pointer-events: none;
		z-index: 2;
	}

	/* 椭圆与倾角透视 */
	.orbit-ring-1 {
		width: 320px;
		height: 190px;
	}

	.orbit-ring-2 {
		width: 480px;
		height: 250px;
	}

	.orbit-ring-3 {
		width: 660px;
		height: 310px;
	}

	.orbit-ring-4 {
		width: 860px;
		height: 360px;
	}

	/* 轨道虚线轨迹 */
	.orbit-track {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 1px dashed rgb(37 60 52 / 18%);
		transition: border-color 0.3s ease, border-style 0.3s ease, box-shadow 0.3s ease;
	}

	.orbit-ring.is-focused .orbit-track {
		border-color: var(--brand-clay);
		border-style: solid;
		box-shadow: 0 0 12px rgb(145 86 56 / 15%);
	}

	/* 行星载体沿轨道自转 */
	.planet-carrier {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		animation: orbitRotate var(--orbit-duration, 40s) linear infinite;
		animation-delay: var(--orbit-delay, 0s);
	}

	.orbit-ring:hover .planet-carrier,
	.orbit-ring.is-focused .planet-carrier {
		animation-play-state: paused;
	}

	@keyframes orbitRotate {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(360deg);
		}
	}

	/* 行星按钮节点 */
	.planet-node {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		background: none;
		border: none;
		padding: 10px;
		margin: 0;
		cursor: pointer;
		pointer-events: auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		outline: none;
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.4, 1);
	}

	/* 反向旋转让字和行星始终朝正立方向 */
	.planet-node {
		animation: counterRotate var(--orbit-duration, 40s) linear infinite;
		animation-delay: var(--orbit-delay, 0s);
	}

	.orbit-ring:hover .planet-node,
	.orbit-ring.is-focused .planet-node {
		animation-play-state: paused;
		transform: translate(-50%, -50%) scale(1.18);
	}

	@keyframes counterRotate {
		from {
			transform: translate(-50%, -50%) rotate(0deg);
		}
		to {
			transform: translate(-50%, -50%) rotate(-360deg);
		}
	}

	/* 行星外观 */
	.planet-sphere {
		position: relative;
		width: 14px;
		height: 14px;
		display: grid;
		place-items: center;
	}

	.planet-core {
		position: absolute;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--planet-color, var(--brand-ink));
		box-shadow: 0 0 6px var(--planet-color);
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.planet-aura {
		position: absolute;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		border: 1px solid var(--planet-color);
		opacity: 0.35;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.planet-node:hover .planet-core,
	.orbit-ring.is-focused .planet-core {
		transform: scale(1.3);
		box-shadow: 0 0 10px var(--planet-color);
	}

