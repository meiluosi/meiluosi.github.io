		linkTextEn: "Read RSI Notes",
		routes: [
			{
				id: "developmental-openended",
				roman: "11",
				nameZh: "开放式学习与 RSI",
				nameEn: "Open-ended Learning",
			},
			{
				id: "cognitive-architectures",
				roman: "09",
				nameZh: "认知架构与元认知",
				nameEn: "Meta-cognition",
			},
			{
				id: "learning-efficiency",
				roman: "03",
				nameZh: "学习效率与泛化",
				nameEn: "Sample Efficiency",
			},
			{
				id: "wisdom-values",
				roman: "19",
				nameZh: "实践智慧与价值",
				nameEn: "Wisdom & Ethics",
			},
