---
import { categoryLabels } from "@/data/category-labels";
import type { ReadingChainLink } from "@/utils/reading-chain";

interface Props {
	prev: ReadingChainLink | null;
	next: ReadingChainLink | null;
	/** 文章路由前缀：中文 `/posts/`，英文 `/en/posts/`。 */
	basePath: string;
	allHref: string;
	lang?: "zh" | "en";
}

const { prev, next, basePath, allHref, lang = "zh" } = Astro.props;
const isZh = lang === "zh";
const href = (link: ReadingChainLink): string => `${basePath}${link.slug}/`;

const reasonLabel = (link: ReadingChainLink): string => {
	if (!link.sameTopic || !link.topic) {
		return isZh ? "按发布时间" : "By publication date";
	}
	const label = isZh ? (categoryLabels[link.topic] ?? link.topic) : link.topic;
	return isZh ? `同主题 · ${label}` : `Same topic · ${label}`;
};

const allLabel = isZh ? "全部文章" : "All writing";
---

<nav class="reading-chain" aria-label={isZh ? "阅读路径" : "Reading path"}>
	<a class="reading-chain-card is-prev" href={prev ? href(prev) : allHref}>
		<span class="chain-direction">
			{
				prev
					? isZh
						? "← 上一篇"
						: "← Previous"
					: isZh
						? "← 全部文章"
						: "← All writing"
			}
		</span>
		<span class="chain-title">{prev ? prev.title : allLabel}</span>
		{prev && <span class="chain-reason">{reasonLabel(prev)}</span>}
	</a>
	<a class="reading-chain-card is-next" href={next ? href(next) : allHref}>
		<span class="chain-direction">
			{
				next
					? isZh
						? "下一篇 →"
						: "Next →"
					: isZh
						? "全部文章 →"
						: "All writing →"
			}
		</span>
		<span class="chain-title">{next ? next.title : allLabel}</span>
		{next && <span class="chain-reason">{reasonLabel(next)}</span>}
	</a>
</nav>

<style>
	.reading-chain {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
		margin: 8px 0 40px;
	}
	.reading-chain-card {
		display: flex;
		flex-direction: column;
		gap: 6px;
		min-width: 0;
		padding: 16px 18px;
		border: 1px solid var(--brand-line);
		border-radius: 12px;
		background: var(--brand-surface);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease;
	}
	.reading-chain-card.is-next {
		align-items: flex-end;
		text-align: right;
	}
	.reading-chain-card:hover {
		border-color: var(--brand-accent);
		background: var(--brand-paper);
	}
	.reading-chain-card:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 3px;
	}
	.chain-direction {
		font-family: "JetBrains Mono", monospace;
		font-size: 10px;
		line-height: 1.6;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--brand-accent);
	}
	.chain-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		font-size: 14px;
		font-weight: 500;
		line-height: 1.6;
		color: var(--brand-ink);
	}
	.chain-reason {
		font-size: 11px;
		line-height: 1.7;
		color: var(--brand-muted);
	}
	@media (max-width: 700px) {
		.reading-chain {
			grid-template-columns: minmax(0, 1fr);
			gap: 10px;
		}
		.reading-chain-card.is-next {
			align-items: flex-start;
			text-align: left;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.reading-chain-card {
			transition: none;
		}
	}
</style>
