---
/**
 * 相关阅读窄条：按共同标签推荐 1–3 篇旧文。
 *
 * 纯静态渲染，无客户端脚本；`items` 为空时不输出任何容器，由页面决定是否调用。
 * 视觉只占用一行：等宽小标题 + 可换行链接（标题最多两行 + muted 的共同标签原因）。
 */
import type { RelatedArticle } from "@/utils/related-articles";

interface Props {
	items: RelatedArticle[];
	basePath: string;
	lang?: "zh" | "en";
}

const { items, basePath, lang = "zh" } = Astro.props;
const isEnglish = lang === "en";
const label = isEnglish ? "Related reading" : "相关阅读";
const reasonPrefix = isEnglish ? "Shared tags: " : "共同标签：";
const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
const buildHref = (slug: string): string =>
	`${normalizedBase}${slug.replace(/^\/+/, "").replace(/\/+$/, "")}/`;
---

{
	items.length > 0 && (
		<aside class="related-articles" aria-label={label} data-related-articles>
			<p class="related-articles-title">{label}</p>
			<ul class="related-articles-list">
				{items.map((item) => (
					<li class="related-articles-item">
						<a class="related-articles-link" href={buildHref(item.slug)}>
							<span class="related-articles-name">{item.title}</span>
							{item.sharedTags.length > 0 && (
								<span class="related-articles-reason">
									{`${reasonPrefix}${item.sharedTags.join(" · ")}`}
								</span>
							)}
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.related-articles {
		min-width: 0;
		margin: 0;
		color: var(--brand-body);
	}

	.related-articles-title {
		margin: 0 0 10px;
		color: var(--brand-muted);
		font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 10px;
		letter-spacing: 0.1em;
		line-height: 1.8;
	}

	.related-articles-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 32px;
		min-width: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.related-articles-item {
		flex: 1 1 240px;
		min-width: 0;
		max-width: 100%;
	}

	.related-articles-link {
		display: block;
		min-width: 0;
		color: var(--brand-ink);
		text-decoration: none;
		transition: color 0.18s ease;
	}

	.related-articles-link:hover {
		color: var(--brand-accent);
	}

	.related-articles-link:focus-visible {
		border-radius: 4px;
		outline: 2px solid var(--brand-accent);
		outline-offset: 4px;
	}

	.related-articles-name {
		display: -webkit-box;
		overflow: hidden;
		overflow-wrap: anywhere;
		font-size: 14px;
		line-height: 1.7;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.related-articles-reason {
		display: block;
		margin-top: 3px;
		overflow-wrap: anywhere;
		color: var(--brand-muted);
		font-size: 12px;
		line-height: 1.55;
	}

	@media (max-width: 700px) {
		.related-articles-list {
			gap: 12px;
		}

		.related-articles-item {
			flex-basis: 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.related-articles-link {
			transition: none;
		}
	}
</style>
