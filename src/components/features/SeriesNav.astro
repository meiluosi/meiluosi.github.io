---
/**
 * 系列文章导航条：显示「系列名 · 第 n/总篇」与 1..N 数字链接。
 * 纯静态渲染，无客户端脚本；当前篇用 span[aria-current="page"] 表示不可点。
 */
interface Props {
	series: string;
	order: number;
	items: { slug: string; title: string; order: number }[];
	basePath: string;
	lang?: "zh" | "en";
}

const { series, order, items, basePath, lang = "zh" } = Astro.props;
const isEnglish = lang === "en";
const total = items.length;
const sorted = [...items].sort((a, b) => a.order - b.order);
const label = isEnglish
	? `Series · ${series} — ${order}/${total}`
	: `系列：${series} · 第 ${order}/${total} 篇`;
---

{
	sorted.length > 0 && (
		<nav
			class="series-nav"
			aria-label={isEnglish ? "Series navigation" : "系列导航"}
			data-series-nav
		>
			<p class="series-nav-label">{label}</p>
			<ol class="series-nav-list">
				{sorted.map((item) => (
					<li>
						{item.order === order ? (
							<span class="series-nav-current" aria-current="page">
								{item.order}
							</span>
						) : (
							<a
								class="series-nav-link"
								href={`${basePath}${item.slug}/`}
								data-series-slug={item.slug}
								aria-label={
									isEnglish
										? `Part ${item.order}: ${item.title}`
										: `第 ${item.order} 篇：${item.title}`
								}
							>
								{item.order}
							</a>
						)}
					</li>
				))}
			</ol>
		</nav>
	)
}

<script>
	// Mark current series article as visited/read in localStorage and badge visited links.
	(function initSeriesProgress() {
		const KEY = "feng-yu-series-read";
		const nav = document.querySelector<HTMLElement>("[data-series-nav]");
		if (!nav) return;
		try {
			const raw = localStorage.getItem(KEY);
			const readSet = new Set<string>(raw ? JSON.parse(raw) : []);
			const currentSlug = location.pathname
				.replace(/^\/(en\/)?posts\//, "")
				.replace(/\/$/, "");
			if (currentSlug) {
				readSet.add(currentSlug);
				localStorage.setItem(KEY, JSON.stringify([...readSet]));
			}
			nav
				.querySelectorAll<HTMLAnchorElement>("[data-series-slug]")
				.forEach((link) => {
					const slug = link.dataset.seriesSlug;
					if (slug && readSet.has(slug)) {
						link.dataset.read = "true";
					}
				});
		} catch {
			/* Storage unavailable; series links remain normal. */
		}
	})();
</script>

<style>
	.series-nav {
		display: flex;
		align-items: center;
		gap: 12px;
		min-width: 0;
		margin: 18px 0;
		padding: 9px 12px;
		border: 1px solid var(--brand-line);
		border-radius: 12px;
		background: var(--brand-surface);
		color: var(--brand-ink);
	}

	.series-nav-label {
		min-width: 0;
		max-width: 55%;
		margin: 0;
		overflow: hidden;
		color: var(--brand-muted);
		font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 10px;
		letter-spacing: 0.02em;
		line-height: 1.8;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.series-nav-list {
		display: flex;
		gap: 6px;
		min-width: 0;
		margin: 0 0 0 auto;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scrollbar-width: thin;
	}

	.series-nav-list li {
		flex: 0 0 auto;
	}

	.series-nav-link,
	.series-nav-current {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		min-width: 26px;
		height: 26px;
		padding: 0 5px;
		border: 1px solid var(--brand-line);
		border-radius: 10px;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		text-decoration: none;
	}

	.series-nav-link {
		background: var(--brand-paper);
		color: var(--brand-ink);
		transition:
			border-color 0.16s ease,
			color 0.16s ease,
			background-color 0.16s ease;
	}

	.series-nav-link:hover {
		border-color: var(--brand-accent);
		color: var(--brand-accent);
	}

	.series-nav-link[data-read="true"] {
		background: var(--brand-sage);
		border-color: rgba(65, 99, 79, 0.35);
	}

	.series-nav-link:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 2px;
	}

	.series-nav-current {
		border-color: var(--brand-accent);
		background: var(--brand-accent);
		color: var(--brand-paper);
		font-weight: 600;
	}

	@media (max-width: 700px) {
		.series-nav {
			flex-direction: column;
			align-items: stretch;
			gap: 6px;
			margin: 16px 0;
		}

		.series-nav-label {
			max-width: 100%;
		}

		.series-nav-list {
			margin-left: 0;
			padding-bottom: 2px;
		}

		.series-nav-link,
		.series-nav-current {
			min-width: 32px;
			height: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.series-nav-link {
			transition: none;
		}
	}
</style>
