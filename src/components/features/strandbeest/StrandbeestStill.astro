---
import {
	polygonPath,
	rodPath,
	solveStrandbeest,
	STRANDBEEST_VIEWBOX,
	traceStrandbeest,
} from "@/utils/strandbeest-geometry";
interface Props {
	title?: string;
	titleEn?: string;
	angle?: number;
}
const {
	title = "Jansen 式连杆的理想平面几何示意",
	titleEn = "An ideal planar Jansen-style linkage",
	angle = 205,
} = Astro.props;
const pose = solveStrandbeest(angle);
const trace = traceStrandbeest();
const ghost = solveStrandbeest(angle + 95);
const { G, O, C, F } = pose.points;
---
<svg class="strandbeest-still" viewBox={STRANDBEEST_VIEWBOX} role="img" aria-label={title} data-i18n-aria-label-zh={title} data-i18n-aria-label-en={titleEn} xmlns="http://www.w3.org/2000/svg">
	<title data-i18n="explore.text" data-i18n-zh={title} data-i18n-en={titleEn}>{title}</title>
	<desc data-i18n="explore.text" data-i18n-zh="两处固定铰、一个旋转曲柄与相连的三角形。虚线表示脚端一周的计算轨迹。" data-i18n-en="Two fixed pivots, a rotating crank, and connected triangles. The dashed line shows the calculated foot path over one turn.">两处固定铰、一个旋转曲柄与相连的三角形。虚线表示脚端一周的计算轨迹。</desc>
	<path d="M-86 99H77" stroke="currentColor" stroke-width=".4" opacity=".18" />
	<path d={rodPath(ghost)} fill="none" stroke="currentColor" stroke-width=".65" opacity=".12" />
	<path d={trace.path} fill="none" stroke="var(--brand-clay, #915638)" stroke-width=".85" stroke-dasharray="1.2 2" opacity=".6" />
	<path d={polygonPath(pose, ["G", "K", "L"])} fill="var(--brand-sage, #d5e4d8)" fill-opacity=".65" />
	<path d={polygonPath(pose, ["M", "N", "F"])} fill="var(--brand-peach, #f3c7ac)" fill-opacity=".6" />
	{O && <circle cx={O.x} cy={-O.y} r="15" fill="none" stroke="currentColor" stroke-width=".45" stroke-dasharray="1.2 1.8" opacity=".3" />}
	<path d={rodPath(pose)} fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round" />
	{O && C && <line x1={O.x} y1={-O.y} x2={C.x} y2={-C.y} stroke="var(--brand-clay, #915638)" stroke-width="2" stroke-linecap="round" />}
	{Object.entries(pose.points).map(([name, p]) => p && <circle cx={p.x} cy={-p.y} r={name === "F" ? 1.8 : 1.25} fill={name === "F" ? "var(--brand-clay, #915638)" : "var(--brand-paper, #f3f6f1)"} stroke="currentColor" stroke-width=".65" />)}
	{[G, O].map((p) => p && <circle cx={p.x} cy={-p.y} r="3" fill="none" stroke="currentColor" stroke-width=".55" />)}
	{F && <path d={`M${F.x - 4},${-F.y + 3}h8`} stroke="var(--brand-clay, #915638)" stroke-width="1" stroke-linecap="round" />}
</svg>
<style>.strandbeest-still{display:block;width:100%;height:100%;min-width:0;color:var(--brand-ink,#253c34);overflow:visible}</style>
