---
import Text from "@/components/common/BilingualText.astro";
import ExploreMenu from "@/components/features/ExploreMenu.astro";
import LanguageSwitcher from "@/components/features/LanguageSwitcher.svelte";
import { navBarConfig } from "@/config";
import { getBrandTranslation } from "@/i18n/brand";

const className = Astro.props.class;
const initialLocale = Astro.url.pathname.startsWith("/en/") ? "en" : "zh-CN";
const labelKeys: Record<string, string> = {
	"/notes/": "nav.notes",
	"/work/": "nav.work",
	"/about/": "nav.about",
	"/contact/": "nav.contact",
};
---

<header id="navbar" class:list={["folio-navbar", className]}>
	<a
		class="folio-brand"
		href="/"
		aria-label="枫语个人主页"
		data-i18n-aria-label-zh="枫语个人主页"
		data-i18n-aria-label-en="Feng Yu’s personal site"
	>
		<span class="folio-mark" aria-hidden="true">F.</span>
		<span class="brand-name"><Text zh="枫语" en="Feng Yu" /></span>
	</a>
	<div class="folio-nav-actions">
		<nav
			aria-label="主导航"
			data-i18n-aria-label-zh="主导航"
			data-i18n-aria-label-en="Main navigation"
		>
			{navBarConfig.links.map((link) => (
				<a
					href={link.url}
					data-i18n={labelKeys[link.url]}
					aria-current={Astro.url.pathname === link.url ? "page" : undefined}
					target={link.external ? "_blank" : undefined}
					rel={link.external ? "noreferrer" : undefined}
				>
					{getBrandTranslation(initialLocale, labelKeys[link.url]) ?? link.name}
				</a>
			))}
		</nav>
		<button
			type="button"
			class="palette-trigger"
			data-palette-open
			aria-haspopup="dialog"
			aria-keyshortcuts="Control+K Meta+K"
		>
			<svg
				class="palette-trigger-icon"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.8"
				aria-hidden="true"
			>
				<circle cx="11" cy="11" r="7"></circle>
				<path d="m20 20-3.6-3.6" stroke-linecap="round"></path>
			</svg>
			<span class="palette-trigger-label"><Text zh="搜索" en="Search" /></span>
			<kbd class="palette-trigger-kbd" aria-hidden="true">⌘K</kbd>
		</button>
		<ExploreMenu />
		<LanguageSwitcher client:load />
	</div>
</header>

<script>
	// One delegated listener per page; sets a pending flag in case CommandPalette (client:idle) hasn't hydrated yet.
	document.addEventListener("click", (event) => {
		const target = event.target;
		const trigger =
			target instanceof Element ? target.closest("[data-palette-open]") : null;
		if (!trigger) return;
		(window as Window & { __paletteOpenPending?: boolean }).__paletteOpenPending =
			true;
		window.dispatchEvent(new CustomEvent("palette:open"));
	});
</script>

<style>
	.folio-navbar {
		min-height: 76px;
		padding: 12px 6vw;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		border-bottom: 1px solid var(--brand-line);
		background: var(--brand-paper);
		color: var(--brand-ink);
		position: relative;
		z-index: 50;
	}
	.folio-brand {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		gap: 11px;
		color: inherit;
		text-decoration: none;
	}
	.brand-name {
		font: 400 22px/1.4 var(--font-serif, "Iowan Old Style", "Songti SC", STSong, Georgia, serif);
		letter-spacing: 0.03em;
	}
	.folio-mark {
		display: grid;
		place-items: center;
		width: 33px;
		height: 33px;
		border: 1px solid var(--brand-muted);
		border-radius: 50%;
		color: var(--brand-accent);
		font: italic 16px Georgia, serif;
		letter-spacing: -0.08em;
	}
	.folio-nav-actions {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 24px;
		margin-right: 4px;
	}
	nav a {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		font: 13px/1.5 var(--font-sans, Inter, "PingFang SC", sans-serif);
		color: var(--brand-body);
		text-decoration: none;
		white-space: nowrap;
		transition: color var(--motion-fast, 160ms);
	}
	nav a:hover,
	nav a[aria-current="page"] {
		color: var(--brand-accent);
		text-decoration: underline;
		text-underline-offset: 0.45em;
		text-decoration-color: var(--brand-clay);
	}
	.palette-trigger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		position: relative;
		height: 36px;
		padding: 0 12px;
		border: 1px solid var(--brand-line);
		border-radius: 999px;
		background: var(--brand-surface);
		color: var(--brand-body);
		font: 12px/1 var(--font-sans, Inter, "PingFang SC", sans-serif);
		cursor: pointer;
		flex-shrink: 0;
		transition:
			border-color var(--motion-fast, 160ms),
			color var(--motion-fast, 160ms);
	}
	.palette-trigger:hover {
		border-color: var(--brand-accent);
		color: var(--brand-accent);
	}
	.palette-trigger:focus-visible {
		outline: 2px solid var(--brand-accent);
		outline-offset: 3px;
	}
	.palette-trigger-icon {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
	}
	.palette-trigger-kbd {
		border: 1px solid var(--brand-line);
		border-radius: 5px;
		padding: 2px 5px;
		font: 10px/1.2 var(--font-mono, ui-monospace, SFMono-Regular, monospace);
		color: var(--brand-muted);
	}
	@media (max-width: 700px) {
		.folio-navbar {
			padding: 12px 6vw;
			flex-wrap: wrap;
			gap: 10px;
		}
		.brand-name {
			font-size: 20px;
		}
		.folio-nav-actions {
			gap: 10px;
		}
		nav {
			gap: 16px;
			margin-right: 0;
		}
		nav a {
			font-size: 12px;
			min-height: 40px;
		}
		.palette-trigger {
			height: 40px;
		}
		.palette-trigger-kbd {
			display: none;
		}
	}
	@media (max-width: 520px) {
		.folio-nav-actions {
			width: 100%;
			justify-content: space-between;
			gap: 8px;
		}
		nav {
			gap: 16px;
		}
	}
	@media (max-width: 360px) {
		.palette-trigger {
			width: 40px;
			height: 40px;
			padding: 0;
		}
		.palette-trigger-label {
			position: absolute;
			width: 1px;
			height: 1px;
			margin: -1px;
			padding: 0;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
			border: 0;
		}
		nav {
			gap: 12px;
		}
	}
</style>
