---
import { navBarConfig } from "@/config";
import Text from "@/components/common/BilingualText.astro";
import ExploreMenu from "@/components/features/ExploreMenu.astro";
import LanguageSwitcher from "@/components/features/LanguageSwitcher.svelte";
import { getBrandTranslation } from "@/i18n/brand";

const className = Astro.props.class;
const initialLocale = Astro.url.pathname.startsWith("/en/") ? "en" : "zh-CN";
const labelKeys: Record<string, string> = {
	"/notes/": "nav.notes",
	"/work/": "nav.work",
	"/about/": "nav.about",
	"/contact/": "nav.contact",
};
---

<header id="navbar" class:list={["folio-navbar", className]}>
	<a class="folio-brand" href="/" aria-label="枫语个人主页" data-i18n-aria-label-zh="枫语个人主页" data-i18n-aria-label-en="Feng Yu’s personal site"><span class="folio-mark" aria-hidden="true">F.</span><span class="brand-name"><Text zh="枫语" en="Feng Yu" /></span></a>
	<div class="folio-nav-actions">
		<nav aria-label="主导航" data-i18n-aria-label-zh="主导航" data-i18n-aria-label-en="Main navigation">
			{navBarConfig.links.map((link) => <a href={link.url} data-i18n={labelKeys[link.url]} aria-current={Astro.url.pathname === link.url ? "page" : undefined} target={link.external ? "_blank" : undefined} rel={link.external ? "noreferrer" : undefined}>{getBrandTranslation(initialLocale, labelKeys[link.url]) ?? link.name}</a>)}
		</nav>
		<ExploreMenu />
		<LanguageSwitcher client:load />
	</div>
</header>

<style>
	.folio-navbar { min-height: 78px; padding: 12px 6vw; display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--brand-line); background: var(--brand-paper); color: var(--brand-ink); position: relative; z-index: 50; }
	.folio-brand { display: flex; flex-shrink: 0; align-items: center; gap: 11px; color: inherit; text-decoration: none; }
	.brand-name { font: 400 23px/1.4 "Iowan Old Style", "Songti SC", STSong, Georgia, serif; letter-spacing: .035em; }
	.folio-mark { display: grid; place-items: center; width: 33px; height: 33px; border: 1px solid var(--brand-muted); border-radius: 50%; color: var(--brand-accent); font: italic 16px Georgia, serif; letter-spacing: -.08em; }
	.folio-nav-actions { display: flex; align-items: center; gap: 25px; }
	#navbar.folio-navbar > .folio-nav-actions { background: transparent; border: 0; box-shadow: none; backdrop-filter: none; }
	nav { display: flex; align-items: center; gap: 28px; }
	nav a { display: inline-flex; align-items: center; min-height: 40px; font: 13px/1.5 Inter, "PingFang SC", sans-serif; color: var(--brand-body); text-decoration: none; white-space: nowrap; transition: color .2s; }
	nav a:hover, nav a[aria-current="page"] { color: var(--brand-accent); text-decoration: underline; text-underline-offset: .45em; text-decoration-color: var(--brand-clay); }
	@media (max-width: 700px) {
		.folio-navbar { padding: 14px 6vw 10px; flex-wrap: wrap; gap: 10px; }
		.brand-name { font-size: 21px; }
		.folio-nav-actions { gap: 16px; }
		nav { gap: 18px; }
		nav a { font-size: 12px; }
	}
	@media (max-width: 520px) {
		.folio-nav-actions { width: 100%; justify-content: space-between; gap: 10px; }
		nav { gap: 20px; }
	}
	@media (max-width: 350px) {
		nav { gap: 12px; }
	}
</style>
