---
import { Icon } from "astro-icon/components";
import { commentConfig } from "@/config";
import { getCategoryLabel } from "@/data/category-labels";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryUrl, getTagUrl } from "@/utils/url-utils";

export interface Props {
	published: Date;
	updated?: Date;
	category?: string;
	tags?: string[];
	hideUpdateDate?: boolean;
	hideTagsForMobile?: boolean;
	isHome?: boolean;
	className?: string;
	id?: string;
	showPublished?: boolean;
	showCategory?: boolean;
	showTags?: boolean;
	maxTags?: number;
	showNoTags?: boolean;
	customPath?: string;
	pinned?: boolean;
	password?: boolean;
}

const {
	published,
	updated,
	category,
	tags,
	hideUpdateDate,
	hideTagsForMobile,
	isHome,
	className = "",
	id,
	showPublished = true,
	showCategory = true,
	showTags = true,
	maxTags,
	showNoTags = true,
	customPath,
	pinned,
} = Astro.props;

const path = customPath || (id ? `/posts/${id}` : "");
const visibleTags =
	typeof maxTags === "number" ? tags?.slice(0, maxTags) : tags;
// 分类值来自内容集合，中英文两种写法都存在；这里各准备一份显示名，
// 交给语言切换器在两种界面之间替换。
const categoryLabelZh = category
	? getCategoryLabel(category, "zh")
	: i18n(I18nKey.uncategorized);
const categoryLabelEn = category
	? getCategoryLabel(category, "en")
	: i18n(I18nKey.uncategorized);
---

<div
  class:list={[
    "post-meta-root flex flex-wrap text-(--content-meta) items-center gap-4 gap-x-4 gap-y-2",
    className,
  ]}
>
  {
    pinned && (
      <div class="pinned-btn flex items-center gap-1 bg-(--btn-regular-bg) text-(--btn-content) rounded-md px-2 py-1.5 font-bold">
        <Icon is:inline name="material-symbols:pinboard" class="text-xl" />
        <span class="text-sm">{i18n(I18nKey.pinned)}</span>
      </div>
    )
  }

  {
    showPublished && (
      <div class="flex items-center">
        <div class="meta-icon">
          <Icon
            is:inline
            name="material-symbols:calendar-today-outline-rounded"
            class="text-xl"
          />
        </div>
        <span class="text-(--content-meta) text-sm font-medium">
          {formatDateToYYYYMMDD(published)}
        </span>
      </div>
    )
  }

  {
    showPublished &&
      !hideUpdateDate &&
      updated &&
      updated.getTime() !== published.getTime() && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:edit-calendar-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-(--content-meta) text-sm font-medium">
            {formatDateToYYYYMMDD(updated)}
          </span>
        </div>
      )
  }

  {
    showCategory && (
      <div class="flex flex-wrap items-center min-w-0 max-w-full">
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:book-2-outline-rounded" class="text-xl" />
        </div>
        <div class="flex flex-wrap items-center min-w-0">
          <a
            href={getCategoryUrl(category || "")}
            aria-label={`View all posts in the ${category} category`}
            data-i18n="post.category"
            data-i18n-zh={categoryLabelZh}
            data-i18n-en={categoryLabelEn}
            class="link-lg transition text-(--content-meta) text-sm font-medium
              hover:text-(--primary) dark:hover:text-(--primary)"
          >
            {categoryLabelZh}
          </a>
        </div>
      </div>
    )
  }

  {
    showTags && (
      <div
        class:list={[
          "items-center min-w-0 max-w-full",
          { flex: !hideTagsForMobile, "hidden md:flex": hideTagsForMobile },
        ]}
      >
        <div class="meta-icon">
          <Icon is:inline name="material-symbols:tag-rounded" class="text-xl" />
        </div>
        <div class="flex flex-wrap items-center min-w-0">
          {visibleTags &&
            visibleTags.length > 0 &&
            visibleTags.map((tag, i) => (
              <span class="inline-flex items-center whitespace-nowrap">
                <a
                  href={getTagUrl(tag)}
                  aria-label={`View all posts with the ${tag.trim()} tag`}
                  class="link-lg transition text-(--content-meta) text-sm font-medium
                    hover:text-(--primary) dark:hover:text-(--primary)"
                >
                  {tag.trim()}
                </a>
                {i < visibleTags.length - 1 && (
                  <span class="mx-1.5 text-(--brand-line) text-sm" aria-hidden="true">
                    /
                  </span>
                )}
              </span>
            ))}
          {showNoTags && !(visibleTags && visibleTags.length > 0) && (
            <div class="transition text-(--content-meta) text-sm font-medium">
              {i18n(I18nKey.noTags)}
            </div>
          )}
        </div>
      </div>
    )
  }

  {
    !isHome &&
      commentConfig.type === "twikoo" &&
      commentConfig.twikoo?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-(--content-meta) text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span class="text-(--content-meta) text-sm font-medium" id="twikoo_visitors">
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }

  {
    !isHome &&
      commentConfig.type === "waline" &&
      commentConfig.waline?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-(--content-meta) text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span
            class="text-(--content-meta) text-sm font-medium waline-pageview-count"
            data-path={path}
          >
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }

  {
    !isHome &&
      commentConfig.type === "artalk" &&
      commentConfig.artalk?.visitorCount &&
      id && (
        <div class="flex items-center">
          <div class="meta-icon">
            <Icon
              is:inline
              name="material-symbols:visibility-outline-rounded"
              class="text-xl"
            />
          </div>
          <span class="text-(--content-meta) text-sm font-medium mr-1">
            {i18n(I18nKey.pageViews)}
          </span>
          <span
            class="text-(--content-meta) text-sm font-medium artalk-pv-count"
            data-path={path}
          >
            {i18n(I18nKey.pageViewsLoading)}
          </span>
        </div>
      )
  }
</div>
