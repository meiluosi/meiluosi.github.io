---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { brandTranslations } from "@/i18n/brand";

interface Props {
	title: string;
	authors?: string;
	pubDate: Date;
	url: string;
	slug: string;
}

const { title, authors, pubDate, url, slug } = Astro.props;

const authorName = authors || profileConfig.name;
const year = pubDate.getFullYear();
const month = pubDate.toLocaleDateString("en-US", { month: "short" });

const bibtexEntry = `@article{${slug},
  author  = {${authorName}},
  title   = {${title}},
  journal = {${siteConfig.title}},
  year    = {${year}},
  month   = {${month.toLowerCase()}},
  url     = {${url}}
}`;
---

<section class="bibtex-card onload-animation" aria-labelledby="bibtex-heading">
	<div class="bibtex-head">
		<div class="bibtex-label">
			<span class="bibtex-kicker">BIBTEX</span>
			<h3 id="bibtex-heading">
				<span
					data-i18n="post.citationTitle"
					data-i18n-zh={brandTranslations["zh-CN"]["post.citationTitle"]}
					data-i18n-en={brandTranslations.en["post.citationTitle"]}
				>
					{i18n(I18nKey.citationTitle)}
				</span>
			</h3>
		</div>
		<button
			id="bibtex-copy-btn"
			type="button"
			class="bibtex-copy"
			data-bibtex={bibtexEntry}
			data-copied-text={i18n(I18nKey.citationCopied)}
		>
			<Icon is:inline name="material-symbols:content-copy-outline" class="text-sm" />
			<span
				id="bibtex-copy-text"
				data-i18n="post.copyCitation"
				data-i18n-zh={brandTranslations["zh-CN"]["post.copyCitation"]}
				data-i18n-en={brandTranslations.en["post.copyCitation"]}
			>
				{i18n(I18nKey.citationCopy)}
			</span>
		</button>
	</div>
	<pre class="bibtex-pre">{bibtexEntry}</pre>
</section>

<script>
	const btn = document.getElementById("bibtex-copy-btn");
	const textEl = document.getElementById("bibtex-copy-text");
	if (btn && textEl) {
		const originalText = textEl.textContent || "";
		const copiedText = btn.dataset.copiedText || "✓";
		btn.addEventListener("click", () => {
			const bibtex = btn.dataset.bibtex || "";
			navigator.clipboard.writeText(bibtex).then(() => {
				textEl.textContent = copiedText;
				btn.dataset.copied = "true";
				setTimeout(() => {
					textEl.textContent = originalText;
					delete btn.dataset.copied;
				}, 2000);
			});
		});
	}
</script>

<style>
	.bibtex-card {
		margin-bottom: 18px;
		padding: 16px 20px;
		border: 1px solid var(--brand-line);
		border-radius: 12px;
		background: var(--brand-paper);
	}
	.bibtex-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 10px;
	}
	.bibtex-label {
		display: flex;
		align-items: baseline;
		gap: 10px;
	}
	.bibtex-kicker {
		font: 10px/1.6 var(--font-mono, "JetBrains Mono", monospace);
		letter-spacing: 0.08em;
		color: var(--brand-muted);
	}
	.bibtex-label h3 {
		margin: 0;
		font-size: 14px !important;
		font-weight: 600 !important;
		color: var(--brand-ink);
	}
	.bibtex-copy {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 11px;
		border: 1px solid var(--brand-line);
		border-radius: 999px;
		background: var(--brand-surface);
		color: var(--brand-accent);
		font: 12px/1.4 var(--font-sans, Inter, sans-serif);
		cursor: pointer;
		transition:
			border-color var(--motion-fast, 160ms),
			background-color var(--motion-fast, 160ms);
	}
	.bibtex-copy:hover,
	.bibtex-copy[data-copied="true"] {
		border-color: var(--brand-accent);
		background: var(--brand-sage);
		color: var(--brand-ink);
	}
	.bibtex-pre {
		margin: 0;
		padding: 12px 14px;
		border: 1px solid var(--brand-line);
		border-radius: 8px;
		background: var(--brand-surface);
		color: var(--brand-body);
		font: 12px/1.65 var(--font-mono, "JetBrains Mono", monospace);
		overflow-x: auto;
	}
</style>
