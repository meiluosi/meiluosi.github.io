---
import Text from "@/components/common/BilingualText.astro";
import { researchArticles, researchReview } from "@/data/intelligenceResearch";
interface Props {
	routeId?: string;
}
const { routeId } = Astro.props;
const articles = routeId
	? researchArticles.filter((article) =>
			researchReview.reviews.some(
				(review) =>
					review.article === article.id && review.routes.includes(routeId),
			),
		)
	: researchArticles;
---
<aside class="research-entry" aria-label="跨路线研究 / Cross-route research">
	<Text as="strong" zh="从路线地图走向共同问题" en="From paradigm maps to shared questions" />
	<Text as="p" zh={articles.length ? "三篇综合研究共同复核了18条有条件的结论。沿原文定位、反方与可编辑图继续阅读。" : "本路线尚未形成第四轮专篇；可从共同问题查看已完成的综合与仍未解决的边界。"} en={articles.length ? "Three syntheses review 18 conditional conclusions, with source locations, objections and editable diagrams. Chinese-language research." : "No fourth-round synthesis is specific to this route yet. Explore the reviewed shared questions and remaining gaps."} />
	<div>{routeId && <a href={`/research/intelligence/timelines/${routeId}/`}><Text zh="路线演进时间线" en="Route timeline" /> →</a>}<a href="/research/intelligence/map/"><Text zh="智能问题地图" en="Intelligence question map" /> →</a><a href="/research/intelligence/revisit/"><Text zh="关键缺口与反方补读" en="Research gaps and counterarguments" /> →</a><a href="/research/intelligence/timelines/"><Text zh="20条路线的演进" en="20 research timelines" /> →</a><a href="/research/intelligence/"><Text zh="研究总览" en="Research overview" /> ↗</a>{articles.map(article => <a href={`/research/intelligence/${article.id}/`}><Text zh={article.title} en={article.titleEn} /> →</a>)}</div>
</aside>
<style>.research-entry{border:1px solid var(--brand-line);border-radius:14px;padding:22px;margin:28px 0;color:var(--brand-ink);background:var(--brand-surface);font-size:14px;line-height:1.8}.research-entry strong{font-size:18px}.research-entry p{margin:8px 0 14px;color:var(--brand-body)}.research-entry div{display:flex;flex-wrap:wrap;gap:10px 22px}.research-entry a{color:var(--brand-accent);text-decoration:underline;text-underline-offset:4px}</style>
