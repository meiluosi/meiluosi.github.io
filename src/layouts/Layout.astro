---
import GoogleAnalytics from "@components/analytics/GoogleAnalytics.astro";
import La51Analytics from "@components/analytics/La51Analytics.astro";
import MicrosoftClarity from "@components/analytics/MicrosoftClarity.astro";
import UmamiAnalytics from "@components/analytics/UmamiAnalytics.astro";
import BrandMotion from "@components/features/BrandMotion.astro";
import CommandPalette from "@components/features/CommandPalette.svelte";
import FancyboxManager from "@components/features/FancyboxManager.astro";
import FontSetup from "@components/features/FontSetup.astro";
import HoverPreviewCard from "@/components/features/HoverPreviewCard.svelte";

import {
	analyticsConfig,
	expressiveCodeConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import { PAGE_WIDTH } from "@/constants/constants";
import { defaultFavicons } from "@/constants/icon";
import type { Favicon } from "@/types/config";
import { url } from "@/utils/url-utils";

import "@/styles/main.css";
import "@/styles/variables.styl";
import "@/styles/markdown-extend.styl";
import "@rehype-callouts-theme";
import "@/styles/brand-theme.css";
import "@/styles/site-typography.css";
import "@/styles/a11y.css";

interface Props {
	title?: string;
	titleEn?: string;
	banner?: string;
	description?: string;
	descriptionEn?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	shareImage?: string;
	localeZhUrl?: string;
	localeEnUrl?: string;
}

let {
	title,
	titleEn,
	description,
	descriptionEn,
	lang,
	setOGTypeArticle,
	postSlug,
	shareImage,
	localeZhUrl,
	localeEnUrl,
} = Astro.props;

const configHue = siteConfig.themeColor.hue;

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = siteConfig.subtitle
		? `${siteConfig.title} - ${siteConfig.subtitle}`
		: siteConfig.title;
}

let ogImageUrl: string | undefined = shareImage
	? new URL(shareImage, siteConfig.site_url).toString()
	: undefined;
if (siteConfig.post.generateOgImages && postSlug) {
	ogImageUrl = new URL(`/og/${postSlug}.png`, Astro.site).toString();
}
const canonicalUrl = new URL(
	Astro.url.pathname,
	siteConfig.site_url,
).toString();
const localeZhAbsoluteUrl = localeZhUrl
	? new URL(localeZhUrl, siteConfig.site_url).toString()
	: undefined;
const localeEnAbsoluteUrl = localeEnUrl
	? new URL(localeEnUrl, siteConfig.site_url).toString()
	: undefined;
const brandOgImageUrl = new URL(
	"/assets/images/brand/social-card.png",
	siteConfig.site_url,
).toString();

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");
---

<!doctype html>
<html
	lang={siteLang}
	class="bg-(--page-bg) text-[14px] md:text-[16px]"
	data-brand-theme="sage"
	data-theme={expressiveCodeConfig.lightTheme}
>
	<head>
		<meta charset="UTF-8" />
		{analyticsConfig?.googleAnalyticsId && (
			<GoogleAnalytics analyticsId={analyticsConfig.googleAnalyticsId} />
		)}
		{analyticsConfig?.microsoftClarityId && (
			<MicrosoftClarity clarityId={analyticsConfig.microsoftClarityId} />
		)}
		{analyticsConfig?.umamiAnalytics?.websiteId && (
			<UmamiAnalytics
				websiteId={analyticsConfig.umamiAnalytics.websiteId}
				scriptUrl={analyticsConfig.umamiAnalytics.scriptUrl}
				replaysScriptUrl={analyticsConfig.umamiAnalytics.replaysScriptUrl}
				trackOutboundLinks={analyticsConfig.umamiAnalytics.trackOutboundLinks}
				collectWebVitals={analyticsConfig.umamiAnalytics.collectWebVitals}
				replays={analyticsConfig.umamiAnalytics.replays}
			/>
		)}
		{analyticsConfig?.la51Analytics?.Id && (
			<La51Analytics
				analyticsId={analyticsConfig.la51Analytics.Id}
				sdkUrl={analyticsConfig.la51Analytics?.sdkUrl}
				ck={analyticsConfig.la51Analytics?.ck}
				autoTrack={analyticsConfig.la51Analytics?.autoTrack}
				hashMode={analyticsConfig.la51Analytics?.hashMode}
				screenRecord={analyticsConfig.la51Analytics?.screenRecord}
			/>
		)}

		<title data-locale-title-zh={pageTitle} data-locale-title-en={titleEn}>
			{pageTitle}
		</title>
		<meta
			name="description"
			content={description || siteConfig.description || pageTitle}
			data-locale-description-zh={description || siteConfig.description || pageTitle}
			data-locale-description-en={descriptionEn}
		/>
		<link rel="canonical" href={canonicalUrl} />
		{localeZhAbsoluteUrl && (
			<link rel="alternate" hreflang="zh-CN" href={localeZhAbsoluteUrl} />
		)}
		{localeEnAbsoluteUrl && (
			<link rel="alternate" hreflang="en" href={localeEnAbsoluteUrl} />
		)}
		{localeZhAbsoluteUrl && (
			<link rel="alternate" hreflang="x-default" href={localeZhAbsoluteUrl} />
		)}
		{siteConfig.keywords && siteConfig.keywords.length > 0 && (
			<meta name="keywords" content={siteConfig.keywords.join(", ")} />
		)}
		<meta name="author" content={profileConfig.name} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={canonicalUrl} />
		<meta
			property="og:title"
			content={pageTitle}
			data-locale-title-zh={pageTitle}
			data-locale-title-en={titleEn}
		/>
		<meta
			property="og:description"
			content={description || siteConfig.description || pageTitle}
			data-locale-description-zh={description || siteConfig.description || pageTitle}
			data-locale-description-en={descriptionEn}
		/>
		<meta property="og:image" content={ogImageUrl || brandOgImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="枫语 — RSI → AGI" />
		<meta property="og:locale" content={siteLang.replace("-", "_")} />
		{setOGTypeArticle ? (
			<meta property="og:type" content="article" />
		) : (
			<meta property="og:type" content="website" />
		)}

		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalUrl} />
		<meta
			name="twitter:title"
			content={pageTitle}
			data-locale-title-zh={pageTitle}
			data-locale-title-en={titleEn}
		/>
		<meta
			name="twitter:description"
			content={description || siteConfig.description || pageTitle}
			data-locale-description-zh={description || siteConfig.description || pageTitle}
			data-locale-description-en={descriptionEn}
		/>
		<meta name="twitter:image" content={ogImageUrl || brandOgImageUrl} />
		<meta name="twitter:image:alt" content="枫语 — RSI → AGI" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{favicons.map((favicon) => (
			<link
				rel="icon"
				href={favicon.src.startsWith("/") ? url(favicon.src) : favicon.src}
				sizes={favicon.sizes}
				media={favicon.theme && `(prefers-color-scheme: ${favicon.theme})`}
			/>
		))}

		<script
			is:inline
			define:vars={{
				configHue,
				lightTheme: expressiveCodeConfig.lightTheme,
			}}
		>
			document.documentElement.classList.remove("dark");
			document.documentElement.setAttribute("data-theme", lightTheme);
			document.documentElement.style.setProperty("--hue", String(configHue));

			// Resolve preferred locale before first paint to prevent bilingual FOUC.
			(function initEarlyLocale() {
				try {
					var params = new URLSearchParams(window.location.search);
					var req = params.get("locale");
					var preferred =
						req === "en" || req === "zh-CN"
							? req
							: window.location.pathname.indexOf("/en/") === 0
								? "en"
								: localStorage.getItem("feng-yu-locale") ||
									(navigator.language &&
									navigator.language.toLowerCase().indexOf("en") === 0
										? "en"
										: "zh-CN");
					document.documentElement.lang =
						preferred === "en" ? "en" : "zh-CN";
				} catch (_e) {}
			})();
		</script>
		<style
			define:vars={{
				configHue,
				"page-width": `${siteConfig.pageWidth ?? PAGE_WIDTH}rem`,
			}}
		></style>

		<slot name="head" />

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>

		<FontSetup />

		{Astro.site && (
			<>
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify({
						"@context": "https://schema.org",
						"@type": "WebSite",
						name: siteConfig.title,
						url: Astro.site.toString(),
						description: siteConfig.description || siteConfig.subtitle,
						inLanguage: siteConfig.lang,
					})}
				/>
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify({
						"@context": "https://schema.org",
						"@type": "Person",
						name: profileConfig.name,
						url: Astro.site.toString(),
						description: profileConfig.bio,
						...(profileConfig.links?.length
							? {
									sameAs: profileConfig.links.map(
										(l: { url: string }) => l.url,
									),
								}
							: {}),
					})}
				/>
			</>
		)}
	</head>
	<body
		class="min-h-screen"
		class:list={[
			{
				"enable-card-border": siteConfig.card?.border,
				"card-follow-theme-hue": siteConfig.card?.followTheme,
			},
		]}
	>
		<a class="skip-link" href="#swup-container">跳到主内容 / Skip to content</a>
		<slot />
		<script is:inline>
			// Synchronous pre-paint bilingual text hydration when preferred locale is English.
			(function applyEarlyBilingualDom() {
				if (document.documentElement.lang !== "en") return;
				var nodes = document.querySelectorAll("[data-i18n][data-i18n-en]");
				for (var i = 0; i < nodes.length; i++) {
					var el = nodes[i];
					var val = el.getAttribute("data-i18n-en");
					if (!val) continue;
					if (el.getAttribute("data-i18n-html") === "true") el.innerHTML = val;
					else el.textContent = val;
				}
				var links = document.querySelectorAll("[data-i18n-href-en]");
				for (var j = 0; j < links.length; j++) {
					var href = links[j].getAttribute("data-i18n-href-en");
					if (href) links[j].setAttribute("href", href);
				}
				var notices = document.querySelectorAll("[data-locale-notice]");
				for (var k = 0; k < notices.length; k++) {
					notices[k].removeAttribute("hidden");
				}
			})();
		</script>
		<CommandPalette client:idle />
		<HoverPreviewCard client:idle />
		<BrandMotion />
		<FancyboxManager />
	</body>
</html>

<script>
	function initCustomScrollbar() {
		const katexElements = document.querySelectorAll(
			".katex-display:not([data-scrollbar-initialized])",
		) as NodeListOf<HTMLElement>;
		katexElements.forEach((element) => {
			if (!element.parentNode) return;
			const container = document.createElement("div");
			container.className = "katex-display-container";
			element.parentNode.insertBefore(container, element);
			container.appendChild(element);
			container.style.cssText = "overflow-x: auto;";
			element.setAttribute("data-scrollbar-initialized", "true");
		});
	}

	function initHorizontalOverflowContainers() {
		const markdownTables = document.querySelectorAll(
			".custom-md table:not([data-horizontal-scroll-ready])",
		) as NodeListOf<HTMLElement>;

		markdownTables.forEach((table) => {
			if (
				table.parentElement?.classList.contains("horizontal-scroll-container")
			) {
				table.dataset.horizontalScrollReady = "true";
				return;
			}
			const container = document.createElement("div");
			container.className = "horizontal-scroll-container";
			table.parentNode?.insertBefore(container, table);
			container.appendChild(table);
			table.dataset.horizontalScrollReady = "true";
		});
	}

	function scheduleContentOverflowEnhancements() {
		initCustomScrollbar();
		initHorizontalOverflowContainers();
		requestAnimationFrame(() => {
			initCustomScrollbar();
			initHorizontalOverflowContainers();
		});
	}

	function initImageLoadFadeIn() {
		const placeholders =
			document.querySelectorAll<HTMLElement>(".lqip-placeholder");
		placeholders.forEach((placeholder) => {
			const container = placeholder.parentElement;
			if (!container) return;
			const img = container.querySelector<HTMLImageElement>("img, picture img");
			if (!img) return;

			if (img.complete && img.naturalWidth > 0) {
				img.style.opacity = "1";
				placeholder.classList.add("loaded");
			} else {
				img.addEventListener(
					"load",
					() => {
						img.style.opacity = "1";
						placeholder.classList.add("loaded");
					},
					{ once: true },
				);
				img.addEventListener(
					"error",
					() => {
						placeholder.classList.add("loaded");
					},
					{ once: true },
				);
			}
		});
	}

	function initSkipLinkTarget() {
		const container = document.getElementById("swup-container");
		if (container && !container.hasAttribute("tabindex")) {
			container.setAttribute("tabindex", "-1");
		}
	}

	function initPageEnhancements() {
		scheduleContentOverflowEnhancements();
		initImageLoadFadeIn();
		initSkipLinkTarget();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initPageEnhancements);
	} else {
		initPageEnhancements();
	}
	document.addEventListener("astro:page-load", initPageEnhancements);
	document.addEventListener("password:decrypted", () => {
		setTimeout(scheduleContentOverflowEnhancements, 200);
	});
</script>
