---
import Footer from "@components/layout/Footer.astro";
import Navbar from "@components/layout/Navbar.astro";
import type { MarkdownHeading } from "astro";
import ArticleNavigation from "@/components/features/ArticleNavigation.astro";
import Layout from "./Layout.astro";

import "@/styles/markdown.css";
import "@/styles/expressive-code.css";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	postSlug?: string;
	postCategory?: string;
	localeZhUrl?: string;
	localeEnUrl?: string;
	headings?: MarkdownHeading[];
	bannerPostMeta?: {
		title: string;
		published: Date;
		updated?: Date;
		words?: number;
		minutes?: number;
	};
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	postSlug,
	postCategory,
	localeZhUrl,
	localeEnUrl,
	headings = [],
} = Astro.props;

const isPostPage = !!postSlug;
---

<Layout
	title={title}
	banner={banner}
	description={description}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
	postSlug={postSlug}
	localeZhUrl={localeZhUrl}
	localeEnUrl={localeEnUrl}
>
	<slot slot="head" name="head" />
	<Navbar />

	<div id="main-grid" class="reading-shell">
		<main
			id="swup-container"
			class="transition-main"
			lang={lang || "zh-CN"}
			data-current-post-category={postCategory || ""}
			data-locale-zh-url={localeZhUrl}
			data-locale-en-url={localeEnUrl}
		>
			{!isPostPage && <h1 class="sr-only">{title}</h1>}
			{isPostPage && (
				<ArticleNavigation
					headings={headings}
					english={lang?.startsWith("en")}
				/>
			)}
			<div id="content-wrapper" class="onload-animation transition-leaving">
				{isPostPage && !lang?.toLowerCase().startsWith("en") && (
					<p data-locale-notice hidden class="post-language-note">
						English interface selected · this article is currently written in
						Chinese.
					</p>
				)}
				<slot />
			</div>
		</main>
		<Footer />
	</div>
</Layout>

<style is:global>
	.reading-shell {
		min-height: calc(100vh - 78px);
		display: flex;
		flex-direction: column;
	}
	.reading-shell > main#swup-container {
		flex: 1;
		width: min(100%, 980px);
		margin: 0 auto;
	}
	#content-wrapper {
		padding: clamp(28px, 6vw, 76px) clamp(20px, 6vw, 72px) 0;
	}
	@media (max-width: 700px) {
		#content-wrapper {
			padding: 35px 7vw 0;
		}
	}
	.post-language-note {
		margin: 0 0 1rem;
		padding: 0.7rem 0.9rem;
		border: 1px solid var(--brand-line);
		border-radius: 0.75rem;
		background: var(--brand-surface);
		color: var(--brand-muted);
		font-size: 0.8rem;
	}
	.post-language-note[hidden] {
		display: none;
	}
</style>
