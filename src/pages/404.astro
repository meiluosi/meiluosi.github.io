---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/layout/Navbar.astro";
---

<Layout title="迷路了 — 枫语" titleEn="Not Found — Feng Yu" description="页面没有找到。" descriptionEn="This page could not be found. Head back and keep exploring.">
	<div class="not-found" id="swup-container"><Navbar /><main><span class="number">404</span><p class="eyebrow">A SMALL DETOUR</p><h1 data-i18n="404.heading" data-i18n-html="true" data-i18n-zh="这条路暂时<br/><em>还没有通。</em>" data-i18n-en="This path<br/><em>ends here.</em>">这条路暂时<br/><em>还没有通。</em></h1><p class="copy" data-i18n="404.copy" data-i18n-zh="可能地址写错了，也可能它还没被建出来。回到主页继续探索吧。" data-i18n-en="The address may be wrong, or this page may not exist yet. Head back and keep exploring.">可能地址写错了，也可能它还没被建出来。回到主页继续探索吧。</p><a class="back-home" href="/" data-i18n="404.home" data-i18n-zh="回到起点 ↗" data-i18n-en="Back to the beginning ↗">回到起点 ↗</a></main><footer><span>LOST IS JUST ANOTHER WAY TO EXPLORE.</span><a href="/notes/" data-i18n="404.notes" data-i18n-zh="打开笔记 ↗" data-i18n-en="Open the notes ↗">打开笔记 ↗</a></footer></div>
	<style>
		:global(html){background:var(--brand-paper)}:global(body){margin:0!important;background:var(--brand-paper)!important;color:var(--brand-ink)!important;font-family:Inter,"Helvetica Neue",Arial,sans-serif}.not-found{min-height:100vh;background:radial-gradient(ellipse at 70% 50%,rgba(129,151,86,.12),transparent 36%),var(--brand-paper);color:var(--brand-ink);display:flex;flex-direction:column}.not-found main{position:relative;flex:1;min-height:620px;width:min(800px,80vw);margin:auto;display:flex;flex-direction:column;justify-content:center}.number{position:absolute;right:2%;top:16%;font:clamp(100px,24vw,250px)/1 "JetBrains Mono",monospace;color:rgba(65,99,79,.08);letter-spacing:-.1em}.eyebrow,.not-found footer{font:9px/1.7 "JetBrains Mono",monospace;letter-spacing:.13em;color:var(--brand-muted)}.not-found h1{position:relative;font-size:clamp(60px,9vw,115px);line-height:1;letter-spacing:-.08em;font-weight:450;margin:38px 0 22px}.not-found h1 em{font:italic 400 .9em Georgia,"Songti SC",serif;color:var(--brand-accent)}.copy{max-width:420px;color:var(--brand-body);font-size:13px;line-height:2}.back-home{display:inline-flex;gap:30px;align-items:center;align-self:flex-start;margin-top:25px;padding:14px 21px;border-radius:30px;background:var(--brand-peach);color:var(--brand-ink);text-decoration:none;font-size:11px}.back-home span{font-size:14px}.not-found footer{padding:22px 8vw;border-top:1px solid rgba(37,60,52,.13);display:flex;justify-content:space-between}.not-found footer a{font:10px Inter,sans-serif;color:var(--brand-accent);text-decoration:none}@media(max-width:700px){.not-found main{width:84vw;min-height:600px}.number{top:22%;right:0}.not-found h1{font-size:64px}.copy{font-size:12px}.not-found footer{font-size:7px}.not-found footer a{font-size:9px}}
	</style>
</Layout>
