---
import LanguageSwitcher from "@/components/features/LanguageSwitcher.svelte";
import Layout from "@/layouts/Layout.astro";
import CopyEmail from "@/components/features/CopyEmail.svelte";
---

<Layout title="联系我 — 枫语" titleEn="Contact — Feng Yu" description="联系枫语，聊聊 AI、研究、合作或任何有意思的问题。" descriptionEn="Get in touch with Feng Yu about AI, research, collaboration, or an interesting question.">
	<main class="contact-page" data-brand-motion id="swup-container">
		<header class="topbar">
			<a class="wordmark" href="/"><span class="mark">F.</span><span>FENG YU <i>·</i> <span class="brand-descriptor" data-i18n="contact.brand" data-i18n-zh="个人主页" data-i18n-en="PERSONAL SITE">个人主页</span></span></a>
			<div class="contact-actions"><a class="back" href="/" data-i18n="contact.back">← BACK TO EXPLORING</a><LanguageSwitcher client:load /></div>
		</header>
		<section class="contact-content">
			<p class="eyebrow" data-motion-intro><span></span><span class="eyebrow-text" data-i18n="contact.channel.title" data-i18n-zh="联系 / 保持交流" data-i18n-en="CONTACT / OPEN CHANNEL">联系 / 保持交流</span></p>
			<h1 data-motion-intro data-i18n="contact.title" data-i18n-html="true">世界很大，<br/><em>不妨聊聊。</em></h1>
			<p class="intro" data-motion-intro data-i18n="contact.intro">如果你也在做有意思的事，或者有一个值得认真讨论的问题，欢迎来信。我会尽量亲自回复。</p>
			<a class="email" data-motion-intro href="mailto:1160337988@qq.com"><span data-i18n="contact.email">写信给我</span><strong>1160337988@qq.com</strong><b>↗</b></a>
			<CopyEmail client:load email="1160337988@qq.com" />
			<div class="details" data-motion-reveal>
				<div><span class="label" data-i18n="contact.topics" data-i18n-zh="可以一起聊聊" data-i18n-en="LET’S TALK ABOUT">可以一起聊聊</span><p data-i18n="contact.topics.body" data-i18n-zh="论文讨论与实验复现 · 因果推理与效果评估 · Agent、科研系统与 RSI" data-i18n-en="Papers and reproductions · Causal reasoning and evaluation · Agents, research systems, and RSI">论文讨论与实验复现 · 因果推理与效果评估 · Agent、科研系统与 RSI</p></div>
				<div><span class="label" data-i18n="contact.elsewhere" data-i18n-zh="其他地方" data-i18n-en="ELSEWHERE">其他地方</span><p><a href="https://github.com/meiluosi" target="_blank" rel="noreferrer">GitHub ↗</a><br/><a href="/rss/" data-i18n="contact.rss" data-i18n-zh="订阅笔记 / RSS ↗" data-i18n-en="Field notes / RSS ↗">订阅笔记 / RSS ↗</a></p></div>
				<div><span class="label" data-i18n="contact.start" data-i18n-zh="从一个问题开始" data-i18n-en="START WITH A QUESTION">从一个问题开始</span><p data-i18n="contact.start.body" data-i18n-zh="可以附上你正在思考的问题、一篇文章，或希望一起推进的方向。" data-i18n-en="Share a question, an article, or a direction you would like to explore together.">可以附上你正在思考的问题、一篇文章，或希望一起推进的方向。</p></div>
			</div>
			<div class="footnote"><span data-i18n="contact.channel" data-i18n-zh="一封邮件，开启一次交流。" data-i18n-en="A CONVERSATION STARTS WITH AN EMAIL.">一封邮件，开启一次交流。</span><a href="/" data-i18n="contact.explore">KEEP EXPLORING ↓</a></div>
		</section>
		<div class="halo halo-one"></div><div class="halo halo-two"></div>
	</main>
	<style>
		.eyebrow .eyebrow-text{width:auto;height:auto;border-radius:0;background:none;box-shadow:none}
		:global(html){background:var(--brand-paper)}:global(body){margin:0!important;background:var(--brand-paper)!important;color:var(--brand-ink)!important;font-family:Inter,"Helvetica Neue",Arial,sans-serif}.contact-page{--lime:var(--brand-accent);--line:rgba(37,60,52,.14);min-height:100svh;position:relative;overflow:hidden;background:radial-gradient(ellipse at 83% 55%,rgba(129,151,86,.11),transparent 35%),var(--brand-paper)}.topbar{height:82px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);position:relative;z-index:2}.wordmark{display:flex;align-items:center;gap:12px;color:var(--brand-ink);font-size:10px;letter-spacing:.18em;font-weight:600;text-decoration:none}.wordmark i{color:var(--lime);font-style:normal}.mark{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--brand-muted);border-radius:50%;color:var(--lime);font:italic 16px Georgia;letter-spacing:-.08em}.contact-actions{display:flex;align-items:center;gap:18px}.back,.eyebrow,.label,.footnote{font:9px/1.7 "JetBrains Mono",monospace;letter-spacing:.13em;color:var(--brand-muted);text-decoration:none}.back:hover,.footnote a:hover{color:var(--lime)}.contact-content{position:relative;z-index:1;width:min(900px,78vw);margin:0 auto;padding:15vh 0 8vh}.eyebrow{display:flex;align-items:center;gap:10px}.eyebrow span{width:6px;height:6px;border-radius:50%;background:var(--lime);box-shadow:0 0 12px var(--lime)}h1{font-size:clamp(64px,10vw,132px);line-height:.98;letter-spacing:-.08em;font-weight:450;margin:55px 0 30px}h1 em{font:italic 400 .9em/1 Georgia,"Songti SC",serif;letter-spacing:-.075em;color:var(--lime)}.intro{max-width:450px;color:var(--brand-body);font-size:14px;line-height:2;margin:0 0 55px}.email{max-width:650px;display:grid;grid-template-columns:1fr auto 36px;align-items:center;gap:20px;border-bottom:1px solid var(--line);padding:20px 0 24px;color:var(--brand-ink);text-decoration:none}.email span{font:9px "JetBrains Mono",monospace;letter-spacing:.12em;color:var(--brand-muted)}.email strong{font-size:clamp(15px,2.5vw,23px);font-weight:450}.email b{font-size:20px;color:var(--lime);font-weight:400;justify-self:end;transition:transform .2s}.email:hover b{transform:translate(4px,-4px)}.details{display:grid;grid-template-columns:1.3fr 1fr .8fr;gap:35px;padding-top:50px}.label{font-size:8px}.details p{font:10px/2.2 "JetBrains Mono",monospace;color:var(--brand-body)}.details a{color:inherit;text-decoration:none}.details a:hover{color:var(--lime)}.footnote{display:flex;justify-content:space-between;border-top:1px solid var(--line);margin-top:8vh;padding-top:18px;font-size:8px}.footnote a{color:var(--lime);text-decoration:none}.halo{position:absolute;pointer-events:none;border:1px solid rgba(65,99,79,.1);border-radius:50%;transform:rotate(-25deg) scaleY(.45)}.halo-one{width:620px;height:620px;right:-220px;top:21%}.halo-two{width:470px;height:470px;right:-145px;top:30%;border-color:rgba(37,60,52,.07)}@media(max-width:700px){.topbar{height:67px;padding:0 6vw}.wordmark{font-size:8px;gap:8px}.mark{height:30px;width:30px}.back{font-size:7px}.contact-actions{gap:8px}.contact-content{width:84vw;padding:17vh 0 7vh}h1{font-size:clamp(58px,15vw,88px);margin:43px 0 25px}.intro{font-size:12px;margin-bottom:42px}.email{grid-template-columns:1fr 27px;gap:7px}.email span{grid-column:1/-1}.email strong{font-size:16px}.details{grid-template-columns:1fr 1fr;gap:22px;padding-top:35px}.details>div:first-child{grid-column:1/-1}.details p{font-size:9px}.footnote{margin-top:7vh;font-size:7px}.halo-one{right:-440px;top:28%}.halo-two{right:-390px;top:35%}}
	</style>
</Layout>
