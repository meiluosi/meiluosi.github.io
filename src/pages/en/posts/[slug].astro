---
import { getCollection, render } from "astro:content";
import Mindmap from "@/components/features/Mindmap.svelte";
import { buildConceptGraph } from "@/utils/article-concept-graph";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import ReadingProgress from "@/components/features/ReadingProgress.svelte";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	const [entries, sources] = await Promise.all([
		getCollection("enPosts"),
		getCollection("posts", ({ data }) => !data.draft && !data.password),
	]);
	const publicSources = new Map(sources.map((source) => [removeFileExtension(source.id), source]));
	// A translation follows the publication state of its Chinese source.
	// Keep drafts and protected articles out of public routes and search output.
	return entries.flatMap((entry) => {
		const source = publicSources.get(removeFileExtension(entry.data.sourceId));
		if (!source) return [];
		return [{
			params: { slug: entry.data.slug },
			props: {
				entry,
				source,
				localeZhUrl: `/posts/${removeFileExtension(source.id)}/`,
				localeEnUrl: `/en/posts/${entry.data.slug}/`,
			},
		}];
	});
}

const { entry, source, localeZhUrl, localeEnUrl } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const minutes = Math.max(
	1,
	Math.ceil((remarkPluginFrontmatter.words ?? 0) / 220),
);
---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description}
	lang="en"
	setOGTypeArticle={true}
	postSlug={entry.id}
	postCategory={entry.data.category || undefined}
	localeZhUrl={localeZhUrl}
	localeEnUrl={localeEnUrl}
	headings={headings}
	bannerPostMeta={{
		title: entry.data.title,
		published: entry.data.published,
		words: remarkPluginFrontmatter.words,
		minutes,
	}}
>
	<ReadingProgress client:load />
	<article id="post-container" class="mx-auto w-full max-w-4xl rounded-(--radius-large) px-5 py-8 md:px-10 md:py-12">
		<header class="mb-10 border-b border-(--line-divider) pb-8">
			<p class="edition-label mb-3 text-xs text-(--primary)">{entry.data.editionLabel || "English edition"}</p>
			<h1 class="mb-4 text-3xl font-bold leading-tight text-black/80 dark:text-white/90 md:text-5xl" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title">{entry.data.title}</h1>
			<p class="text-sm text-black/45 dark:text-white/45">
				{entry.data.published.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
				{entry.data.category && <span> · {entry.data.category}</span>}
			</p>
			{source && (
				<a class="mt-5 inline-flex text-sm text-(--primary) hover:underline" href={`${localeZhUrl}?locale=zh-CN`} lang="zh-CN">
					Read the original in Chinese <span class="ml-2">↗</span>
				</a>
			)}
		</header>
		<div class="prose prose-neutral max-w-none dark:prose-invert custom-md markdown-content" data-pagefind-body>
			<Content />
		</div>
		<Mindmap graph={buildConceptGraph(entry.data.title, entry.body ?? "", headings)} english client:load />
	</article>
</MainGridLayout>
