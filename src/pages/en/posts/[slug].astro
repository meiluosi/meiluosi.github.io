---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ArticleBrandStyle from "@/components/features/ArticleBrandStyle.astro";
import KatexManager from "@/components/features/KatexManager.astro";
import Mindmap from "@/components/features/Mindmap.svelte";
import ReadingProgress from "@/components/features/ReadingProgress.svelte";
import PostMetadata from "@/components/layout/PostMeta.astro";
import { profileConfig } from "@/config/profileConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { buildConceptGraph } from "@/utils/article-concept-graph";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	const [entries, sources] = await Promise.all([
		getCollection("enPosts"),
		getCollection("posts", ({ data }) => !data.draft && !data.password),
	]);
	const publicSources = new Map(
		sources.map((source) => [removeFileExtension(source.id), source]),
	);
	// A translation follows the publication state of its Chinese source.
	// Keep drafts and protected articles out of public routes and search output.
	return entries.flatMap((entry) => {
		const source = publicSources.get(removeFileExtension(entry.data.sourceId));
		if (!source) return [];
		return [
			{
				params: { slug: entry.data.slug },
				props: {
					entry,
					source,
					localeZhUrl: `/posts/${removeFileExtension(source.id)}/`,
					localeEnUrl: `/en/posts/${entry.data.slug}/`,
				},
			},
		];
	});
}

const { entry, source, localeZhUrl, localeEnUrl } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const words = Math.round(Number(remarkPluginFrontmatter.words ?? 0));
const minutes = Math.max(1, Math.ceil(words / 220));

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	wordCount: words,
	inLanguage: "en",
	url: Astro.url.href,
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": Astro.url.href,
	},
	...(source
		? {
				translationOfWork: {
					"@type": "CreativeWork",
					"@id": new URL(localeZhUrl, Astro.site).toString(),
				},
			}
		: {}),
};
---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description}
	lang="en"
	setOGTypeArticle={true}
	postSlug={entry.id}
	postCategory={entry.data.category || undefined}
	localeZhUrl={localeZhUrl}
	localeEnUrl={localeEnUrl}
	headings={headings}
	bannerPostMeta={{
		title: entry.data.title,
		published: entry.data.published,
		words,
		minutes,
	}}
>
	<ArticleBrandStyle />
	<KatexManager slot="head" />
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>

	<ReadingProgress client:load />

	<article id="post-container" class="relative w-full mb-4">
		<!-- words and reading time -->
		<div class="flex flex-wrap text-(--content-meta) gap-5 mb-3 transition onload-animation">
			<div class="flex flex-row items-center">
				<div class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2">
					<Icon is:inline name="material-symbols:notes-rounded" />
				</div>
				<div class="text-sm">{words.toLocaleString("en-US")} words</div>
			</div>
			<div class="flex flex-row items-center">
				<div class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2">
					<Icon is:inline name="material-symbols:schedule-outline-rounded" />
				</div>
				<div class="text-sm">{minutes} min read</div>
			</div>
		</div>

		<!-- title -->
		<div class="relative onload-animation">
			<p class="edition-label mb-3">{entry.data.editionLabel || "English edition"}</p>
			<h1
				data-pagefind-body
				data-pagefind-weight="10"
				data-pagefind-meta="title"
				class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-(--brand-ink)"
			>
				{entry.data.title}
			</h1>
			{source && (
				<a
					href={`${localeZhUrl}?locale=zh-CN`}
					lang="zh-CN"
					hreflang="zh-CN"
					class="inline-flex items-center text-[13px] leading-6 text-(--content-meta) hover:text-(--brand-accent) transition-colors mb-3"
				>
					中文原文 ↗
				</a>
			)}
		</div>

		<!-- metadata -->
		<div class="onload-animation">
			<PostMetadata
				className="mb-5"
				published={entry.data.published}
				tags={entry.data.tags}
				category={entry.data.category || undefined}
				id={entry.id}
			/>
			<div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
		</div>

		<Markdown class="mb-6 markdown-content onload-animation">
			<Content />
		</Markdown>

		<Mindmap
			graph={buildConceptGraph(entry.data.title, entry.body ?? "", headings)}
			english
			client:load
		/>
	</article>
</MainGridLayout>
