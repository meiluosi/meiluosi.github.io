---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import Markdown from "@/components/common/Markdown.astro";
import ArticleBrandStyle from "@/components/features/ArticleBrandStyle.astro";
import InteractiveMathEnhancer from "@/components/features/InteractiveMathEnhancer.astro";
import KatexManager from "@/components/features/KatexManager.astro";
import Mindmap from "@/components/features/Mindmap.svelte";
import ReadingChain from "@/components/features/ReadingChain.astro";
import ReadingProgress from "@/components/features/ReadingProgress.svelte";
import RelatedArticles from "@/components/features/RelatedArticles.astro";
import SeriesNav from "@/components/features/SeriesNav.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { buildConceptGraph } from "@/utils/article-concept-graph";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { buildReadingChain } from "@/utils/reading-chain";
import { buildRelatedByTags } from "@/utils/related-articles";
import { removeFileExtension } from "@/utils/url-utils";

export async function getStaticPaths() {
	const [entries, sources] = await Promise.all([
		getCollection("enPosts"),
		getCollection("posts", ({ data }) => !data.draft && !data.password),
	]);
	const publicSources = new Map(
		sources.map((source) => [removeFileExtension(source.id), source]),
	);
	// A translation follows the publication state of its Chinese source.
	// Keep drafts and protected articles out of public routes and search output.
	return entries.flatMap((entry) => {
		const source = publicSources.get(removeFileExtension(entry.data.sourceId));
		if (!source) return [];
		return [
			{
				params: { slug: entry.data.slug },
				props: {
					entry,
					source,
					localeZhUrl: `/posts/${removeFileExtension(source.id)}/`,
					localeEnUrl: `/en/posts/${entry.data.slug}/`,
				},
			},
		];
	});
}

const { entry, source, localeZhUrl, localeEnUrl } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

const words = Math.round(Number(remarkPluginFrontmatter.words ?? 0));
const minutes = Math.max(1, Math.ceil(words / 220));

// 英文页的阅读链只包含真正发布的译文，顺序与中文页一致（同主题优先）。
const [englishEntries, publicSources] = await Promise.all([
	getCollection("enPosts"),
	getCollection("posts", ({ data }) => !data.draft && !data.password),
]);
const publicSourceIds = new Set(
	publicSources.map((item) => removeFileExtension(item.id)),
);
const visibleTranslations = englishEntries.filter((item) =>
	publicSourceIds.has(removeFileExtension(item.data.sourceId)),
);
const readingChain = buildReadingChain(
	visibleTranslations.map((item) => ({
		slug: item.data.slug,
		title: item.data.title,
		published: item.data.published,
		category: item.data.category,
	})),
).get(entry.data.slug);

// 系列导航：英文译文只有在 frontmatter 里声明了 series 时才显示。
const seriesName = entry.data.series?.trim() ?? "";
const seriesOrder = entry.data.seriesOrder ?? 0;
const seriesItems =
	seriesName && seriesOrder > 0
		? visibleTranslations
				.filter(
					(item) =>
						item.data.series?.trim() === seriesName &&
						typeof item.data.seriesOrder === "number",
				)
				.map((item) => ({
					slug: item.data.slug,
					title: item.data.title,
					order: item.data.seriesOrder as number,
				}))
				.sort((a, b) => a.order - b.order)
		: [];

// 相关阅读：跨分类，按共同标签；开关在 siteConfig.post.showRelatedByTags。
// 上/下一篇已在阅读链里，这里去重，避免同一页重复推荐同一篇。
const chainNeighbours = new Set<string>(
	[readingChain?.prev?.slug ?? "", readingChain?.next?.slug ?? ""].filter(
		Boolean,
	),
);
const relatedArticles = siteConfig.post.showRelatedByTags
	? buildRelatedByTags(
			visibleTranslations.map((item) => ({
				slug: item.data.slug,
				title: item.data.title,
				tags: item.data.tags ?? [],
				published: item.data.published,
			})),
			entry.data.slug,
		).filter((item) => !chainNeighbours.has(item.slug))
	: [];

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	wordCount: words,
	inLanguage: "en",
	url: Astro.url.href,
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": Astro.url.href,
	},
	...(source
		? {
				translationOfWork: {
					"@type": "CreativeWork",
					"@id": new URL(localeZhUrl, Astro.site).toString(),
				},
			}
		: {}),
};
---

<MainGridLayout
	title={entry.data.title}
	description={entry.data.description}
	lang="en"
	setOGTypeArticle={true}
	postSlug={entry.id}
	postCategory={entry.data.category || undefined}
	localeZhUrl={localeZhUrl}
	localeEnUrl={localeEnUrl}
	headings={headings}
	bannerPostMeta={{
		title: entry.data.title,
		published: entry.data.published,
		words,
		minutes,
	}}
>
	<ArticleBrandStyle />
	<KatexManager slot="head" />
	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>

	<ReadingProgress client:load />

	<article id="post-container" class="relative w-full mb-4">
		<!-- words and reading time -->
		<div class="flex flex-wrap text-(--content-meta) gap-5 mb-3 transition onload-animation">
			<div class="flex flex-row items-center">
				<div class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2">
					<Icon is:inline name="material-symbols:notes-rounded" />
				</div>
				<div class="text-sm">{words.toLocaleString("en-US")} words</div>
			</div>
			<div class="flex flex-row items-center">
				<div class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2">
					<Icon is:inline name="material-symbols:schedule-outline-rounded" />
				</div>
				<div class="text-sm">{minutes} min read</div>
			</div>
		</div>

		<!-- title -->
		<div class="relative onload-animation">
			<p class="edition-label mb-3">{entry.data.editionLabel || "English edition"}</p>
			<h1
				data-pagefind-body
				data-pagefind-weight="10"
				data-pagefind-meta="title"
				class="transition w-full block font-bold mb-3 text-3xl md:text-[2.25rem]/[2.75rem] text-(--brand-ink)"
			>
				{entry.data.title}
			</h1>
			{source && (
				<a
					href={`${localeZhUrl}?locale=zh-CN`}
					lang="zh-CN"
					hreflang="zh-CN"
					class="inline-flex items-center text-[13px] leading-6 text-(--content-meta) hover:text-(--brand-accent) transition-colors mb-3"
				>
					中文原文 ↗
				</a>
			)}
		</div>

		<!-- metadata -->
		<div class="onload-animation">
			<PostMetadata
				className="mb-5"
				published={entry.data.published}
				tags={entry.data.tags}
				category={entry.data.category || undefined}
				id={entry.id}
			/>
			<div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
		</div>

		{seriesItems.length > 0 && (
			<div class="onload-animation mb-6">
				<SeriesNav
					series={seriesName}
					order={seriesOrder}
					items={seriesItems}
					basePath="/en/posts/"
					lang="en"
				/>
			</div>
		)}

		<Markdown class="mb-6 markdown-content onload-animation">
			<Content />
		</Markdown>
		<InteractiveMathEnhancer />

		<Mindmap
			graph={buildConceptGraph(entry.data.title, entry.body ?? "", headings)}
			english
			client:load
		/>

		<ReadingChain
			prev={readingChain?.prev ?? null}
			next={readingChain?.next ?? null}
			basePath="/en/posts/"
			allHref="/notes/"
			lang="en"
		/>

		{relatedArticles.length > 0 && (
			<RelatedArticles items={relatedArticles} basePath="/en/posts/" lang="en" />
		)}
	</article>
</MainGridLayout>
