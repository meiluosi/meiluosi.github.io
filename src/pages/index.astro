---
import { getCollection } from "astro:content";
import Text from "@/components/common/BilingualText.astro";
import ExploreWorldCompact from "@/components/features/ExploreWorldCompact.astro";
import Navbar from "@/components/layout/Navbar.astro";
import { siteConfig } from "@/config/siteConfig";
import { now } from "@/data/now";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/content-utils";

// Keep private drafts out of the introduction, including in development.
const published = (await getSortedPosts()).filter(
	(post) => !post.data.draft && !post.data.password,
);
const englishPosts = await getCollection("enPosts");
const postId = (id: string) => id.replace(/\.mdx?$/, "");
const translationFor = (id: string) =>
	englishPosts.find((entry) => entry.data.sourceId === postId(id));

// 「最近」的日期取手写 now.updatedAt 与最新一篇已发布文章的较大者，
// 新文章一发布日期就自动推进，不必再改 now.ts。
const siteDate = new Intl.DateTimeFormat("en-CA", {
	timeZone: siteConfig.timezone || "Asia/Shanghai",
	year: "numeric",
	month: "2-digit",
	day: "2-digit",
});
const toSiteIsoDate = (date: Date): string => {
	const parts = siteDate.formatToParts(date);
	const value = (type: string) =>
		parts.find((part) => part.type === type)?.value ?? "";
	return `${value("year")}-${value("month")}-${value("day")}`;
};
// 使用 UTC 正午作为手写日期的锚点，避免时区把日期推前一天。
const nowDate = new Date(`${now.updatedAt}T12:00:00Z`);
const latestPublished = published.reduce(
	(latest, post) =>
		post.data.published.getTime() > latest.getTime()
			? post.data.published
			: latest,
	new Date(0),
);
const lastActive =
	latestPublished.getTime() > nowDate.getTime() ? latestPublished : nowDate;
const lastActiveIso = toSiteIsoDate(lastActive);
const lastActiveLabel = lastActiveIso.replaceAll("-", ".");

// 最新两篇按发布时间倒序；旧笔记从其余文章中挑选。
const recent = [...published]
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
	.slice(0, 2);
const recentIds = new Set(recent.map((post) => post.id));
const notRecent = [...published]
	.filter((post) => !recentIds.has(post.id))
	.sort((a, b) => a.data.published.getTime() - b.data.published.getTime());
// 旧笔记规则：pinned > 最早的 reflection > 全站最早；
// 与「最新两篇」冲突时已被 notRecent 排除，自动顺延到下一篇。
const picked =
	notRecent.find((post) => post.data.pinned) ??
	notRecent.find((post) => post.data.format === "reflection") ??
	notRecent[0];
const reading = picked ? [picked, ...recent] : recent;
const cards = reading.map((post) => {
	const id = postId(post.id);
	const translation = translationFor(post.id);
	// 历史字段名 isReflection 保留，语义已改为「被挑出的那篇旧笔记」。
	const isReflection = picked?.id === post.id;
	return {
		...post,
		href: `/posts/${id}/`,
		hrefEn: translation
			? `/en/posts/${translation.data.slug}/`
			: `/posts/${id}/`,
		titleEn: translation?.data.title ?? post.data.title,
		isReflection,
		intro: post.data.description,
		introEn: translation?.data.description ?? post.data.description,
	};
});
---

<Layout
	title="人工智能研究与工程实践"
	titleEn="AI research and engineering"
	description="你好，我是枫语。研究范围，记录对智能、机械与世界的好奇。浏览文章，也拨弄一件小作品。"
	descriptionEn="Feng Yu’s research and engineering notes on model training, reinforcement learning, causal inference, and interactive experiments."
>
	<Navbar />
	<main class="journal" id="swup-container" data-brand-motion>
		<section class="welcome compact-page-heading"><h1><Text zh="人工智能研究与工程实践" en="AI research and engineering" /></h1></section>



		<section id="notes" class="writing" aria-labelledby="writing-title">
			<div class="section-heading"><h2 id="writing-title"><Text zh="最新文章" en="Latest articles" /></h2><a href="/notes/"><Text zh="全部文章" en="All writing" /> <span aria-hidden="true">↗</span></a></div>
			<div class="writing-grid">
				{cards.map((post) => <article class:list={["writing-entry", { "picked-entry": post.isReflection }]}>
					<p class="entry-context">{post.isReflection ? <Text zh="翻开一篇旧笔记" en="From the notebook" /> : <Text zh="最近写下" en="Recent writing" />}<span aria-hidden="true"> · </span><time datetime={post.data.published.toISOString().slice(0, 10)}>{post.data.published.getFullYear()}</time></p>
					<h3><a href={post.href} data-i18n-href-zh={post.href} data-i18n-href-en={post.hrefEn}><Text zh={post.data.title} en={post.titleEn} /></a></h3>
					<Text as="p" class="entry-intro" zh={post.intro} en={post.introEn} />
					<a class="entry-link" href={post.href} data-i18n-href-zh={post.href} data-i18n-href-en={post.hrefEn}><Text zh="继续读" en="Read on" /> <span aria-hidden="true">↗</span></a>
				</article>)}
			</div>
		</section>

		<section class="a-small-world" id="work" aria-labelledby="world-heading">
			<div class="world-intro">
				<Text as="p" class="overline" zh="交互实验" en="Interactive experiments" />
				<h2 id="world-heading"><Text zh="研究与实验工作台" en="Research and experimentation" /></h2>
				<Text as="p" zh="通过交互实验查看模型训练流程、蒙特卡洛树搜索与因果效应估计。" en="Explore model training workflows, Monte Carlo tree search, and causal effect estimation through interactive experiments." />
				<a class="read-link" href="/world/"><Text zh="打开研究工作台" en="Open the research workspace" /> <span aria-hidden="true">↗</span></a>
				<div class="world-footpaths"><a href="/lab/model-pipeline/"><Text zh="从文字到模型" en="From text to a model" /></a><a href="/lab/mcts/"><Text zh="蒙特卡洛树搜索" en="Monte Carlo tree search" /></a><a href="/lab/cfr-poker/"><Text zh="Kuhn 扑克与 CFR" en="Kuhn Poker & CFR" /></a><a href="/lab/preference-alignment/"><Text zh="DPO 偏好对齐" en="DPO Alignment" /></a><a href="/lab/rope-attention/"><Text zh="RoPE 旋转星盘" en="RoPE Astrolabe" /></a><a href="/lab/attention-lens/"><Text zh="注意力归纳回路" en="Attention Lens" /></a><a href="/lab/causal-playground/"><Text zh="因果效应估计" en="Causal effect estimation" /></a></div>
			</div>
			<div class="world-preview"><ExploreWorldCompact /></div>
		</section>

		<section class="now-letter" id="now" aria-labelledby="now-title">
			<div class="letter-meta"><h2 id="now-title"><Text zh="最近" en="Lately" /></h2><time datetime={lastActiveIso}>{lastActiveLabel}</time></div>
			<div class="letter-copy"><Text as="p" zh={now.mission} en={now.missionEn} /><Text as="p" zh="有些问题适合写成长文，有些暂时只是一段笔记。先把它们留下，再慢慢连接起来。" en="Some questions grow into essays. Others are still a few lines in a notebook. I leave room for both, and for the connections that come later." /><div class="letter-links"><a href="/library/"><Text zh="翻翻资料架" en="Browse the reading shelf" /> ↗</a><a href="/rsi/"><Text zh="一个长期问题：智能如何改进自身" en="A longer question: how intelligence improves itself" /> ↗</a></div></div>
		</section>

		<footer class="journal-footer" id="contact">
			<div><Text as="p" class="footer-title" zh="写封信，或者下次再来。" en="Write a note, or come back sometime." /><Text as="p" zh="如果某篇文章让你想到什么，欢迎告诉我。" en="If something here gives you an idea, I’d love to hear it." /></div>
			<div class="footer-links"><a href="/contact/"><Text zh="联系我" en="Get in touch" /></a><a href="/rss/">RSS</a><a href="https://github.com/meiluosi" target="_blank" rel="noreferrer">GitHub ↗</a><span>© {new Date().getFullYear()} <Text zh="枫语" en="Feng Yu" /></span></div>
		</footer>
	</main>
</Layout>

<style>
	:global(body) { margin: 0 !important; }
	.journal { max-width: 1240px; margin-inline: auto; padding-inline: clamp(22px, 6vw, 76px); color: var(--brand-ink); font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif); }
	.journal a { color: inherit; text-decoration: none; text-underline-offset: 5px; }
	.journal a:hover { color: var(--brand-clay); }
	.journal h1, .journal h2, .journal h3 { font-family: var(--font-serif, "Songti SC", "Noto Serif SC", "STSong", Georgia, serif); font-weight: 400; text-wrap: balance; }
	.journal p { margin: 0; }
	:global(.journal .overline) { font-size: 13px; line-height: 1.8; letter-spacing: .035em; color: var(--brand-clay); }
	.read-link { min-height: 44px; display: inline-flex; align-items: center; gap: 15px; font-size: 15px; text-decoration: underline !important; text-decoration-color: var(--brand-clay) !important; text-decoration-thickness: 1px !important; }
	.writing { padding-block: 33px 70px; }
	.section-heading { display: flex; justify-content: space-between; gap: 24px; align-items: baseline; padding-bottom: 24px; }
	.section-heading h2 { font-size: 27px; margin: 0; line-height: 1.5; }
	.section-heading > a { font-size: 13px; flex-shrink: 0; padding-block: 10px; }
	.writing-grid { display: grid; grid-template-columns: 1.18fr 1fr 1fr; gap: 34px; }
	.writing-entry { display: flex; flex-direction: column; align-items: start; border-top: 1px solid var(--brand-line); padding-top: 23px; min-width: 0; }
	.entry-context { font-size: 12px; color: var(--brand-muted); }
	.writing-entry h3 { font-size: 22px; line-height: 1.65; margin: 15px 0; }
	.writing-entry :global(.entry-intro) { font-size: 15px; line-height: 1.95; color: var(--brand-body); margin-bottom: 17px; }
	.entry-link { margin-top: auto; padding-block: 10px; font-size: 13px; }
	.picked-entry { border-top-color: var(--brand-clay); }
	.a-small-world { border-block: 1px solid var(--brand-line); display: grid; grid-template-columns: .92fr 1.4fr; gap: 37px; align-items: center; padding-block: 54px; }
	.world-intro h2 { font-size: 35px; line-height: 1.5; margin: 17px 0; }
	.world-intro > :global(p:not(.overline)) { max-width: 29em; font-size: 16px; line-height: 2; color: var(--brand-body); }
	.world-intro > a { margin-top: 18px; }
	.world-footpaths { display: flex; flex-direction: column; align-items: start; gap: 9px; margin-top: 19px; font-size: 13px; color: var(--brand-muted); }
	.world-footpaths a { padding-block: 5px; border-bottom: 1px solid var(--brand-line); }
	.world-preview { min-width: 0; }
	.now-letter { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; padding-block: 68px 77px; }
	.letter-meta h2 { font-size: 26px; margin: 0 0 14px; }
	.letter-meta time { color: var(--brand-muted); font-size: 12px; }
	.letter-copy :global(p) { font-size: 16px; line-height: 2.1; color: var(--brand-body); margin-bottom: 16px; max-width: 42em; }
	.letter-links { display: flex; gap: 12px 23px; flex-wrap: wrap; font-size: 13px; color: var(--brand-accent); margin-top: 22px; }
	.letter-links a { padding-block: 7px; }
	.journal-footer { padding-block: 31px 37px; border-top: 1px solid var(--brand-line); display: flex; justify-content: space-between; align-items: end; gap: 25px; }
	.journal-footer :global(.footer-title) { font: 22px/1.7 var(--font-serif, "Songti SC", "STSong", Georgia, serif); margin-bottom: 7px; }
	.journal-footer :global(p:not(.footer-title)) { font-size: 13px; line-height: 1.8; color: var(--brand-muted); }
	.footer-links { display: flex; flex-wrap: wrap; justify-content: end; gap: 12px 23px; max-width: 280px; font-size: 13px; }
	.footer-links a { padding-block: 6px; }
	.footer-links > span { width: 100%; text-align: right; color: var(--brand-muted); font-size: 12px; }
	@media (max-width: 900px) {
		.writing-grid { gap: 23px; }
		.a-small-world { grid-template-columns: 1fr; gap: 20px; }
		.world-intro h2 br { display: none; }
		.world-intro > :global(p:not(.overline)) { max-width: 45em; }
		.world-footpaths { flex-direction: row; flex-wrap: wrap; gap: 10px 25px; }
	}
	@media (max-width: 620px) {
		.writing { padding-block: 20px 42px; }
		.section-heading { align-items: start; gap: 17px; padding-bottom: 18px; }
		.section-heading h2 { font-size: 24px; }
		.writing-grid { grid-template-columns: 1fr; gap: 26px; }
		.writing-entry { padding-top: 22px; }
		.writing-entry h3 { font-size: 23px; margin-block: 10px; }
		.writing-entry :global(.entry-intro) { margin-bottom: 7px; }
		.a-small-world { padding-block: 35px; }
		.world-intro h2 { font-size: 31px; }
		.now-letter { grid-template-columns: 1fr; gap: 20px; padding-block: 38px 42px; }
		.letter-meta { display: flex; align-items: baseline; gap: 18px; }
		.letter-meta h2 { font-size: 24px; margin: 0; }
		.journal-footer { display: block; padding-block: 28px; }
		.footer-links { justify-content: start; max-width: none; margin-top: 21px; }
		.footer-links > span { text-align: left; width: auto; padding-block: 6px; }
	}
</style>
