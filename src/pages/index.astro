---
import ExploreWorld from "@/components/features/ExploreWorld.svelte";
import ExploreMenu from "@/components/features/ExploreMenu.astro";
import ResearchVisual from "@/components/features/ResearchVisual.astro";
import TrainingBudgetPreview from "@/components/features/TrainingBudgetPreview.svelte";
import StudioRoutes from "@/components/features/StudioRoutes.astro";
import Text from "@/components/common/BilingualText.astro";
import LanguageSwitcher from "@/components/features/LanguageSwitcher.svelte";
import { now } from "@/data/now";
import { researchThreads } from "@/data/researchThreads";
import { researchArchive } from "@/data/researchArchive";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getSortedPosts } from "@/utils/content-utils";

const allPosts = await getSortedPosts();
const englishPosts = await getCollection("enPosts");
const posts = allPosts.slice(0, 3);
const normalize = (value: string) =>
	value.toLowerCase().replace(/[^\p{L}\p{N}]/gu, "");
const archive = researchArchive
	.flatMap((item, index) => {
		const post = allPosts.find((entry) =>
			normalize(entry.id).includes(normalize(item.match)),
		);
		if (!post) return [];
		const translation = englishPosts.find(
			(entry) => entry.data.sourceId === post.id,
		);
		const href = `/posts/${post.id.replace(/\.mdx?$/, "")}/`;
		return [
			{
				...item,
				number: (index + 1).toString().padStart(2, "0"),
				title: post.data.title,
				caseHref: `/work/${item.caseSlug}/`,
				href,
				hrefEn: translation ? `/en/posts/${translation.data.slug}/` : href,
				color: ["var(--brand-accent)", "var(--brand-clay)", "var(--brand-blue)", "var(--brand-accent)"][index],
			},
		];
	})
	.slice(0, 3);
---

<Layout title="枫语 — RSI / AGI Research" titleEn="Feng Yu — RSI / AGI Research" description="以递归自我改进为长期问题，探索通向 AGI 的路径。" descriptionEn="Exploring a path toward AGI through recursive self-improvement, learning systems, and careful evaluation.">
	<main class="folio" data-brand-motion id="swup-container">
		<div class="grain" aria-hidden="true"></div>
		<header class="topbar" id="top">
			<a class="wordmark" href="#top" aria-label="回到首页" data-i18n-aria-label-zh="回到首页" data-i18n-aria-label-en="Back to home"><span class="mark">F.</span><span>FENG YU <i>·</i> <span class="brand-descriptor">RESEARCH STUDIO</span></span></a>
			<nav aria-label="主导航" data-i18n-aria-label-zh="主导航" data-i18n-aria-label-en="Main navigation"><a href="#work" data-i18n="nav.work">研究档案</a><a href="#notes" data-i18n="nav.notes">笔记</a><a class="nav-contact" href="/contact/"><span data-i18n="nav.contact">联系</span> <span>↗</span></a><ExploreMenu /><LanguageSwitcher client:load /></nav>
		</header>
		<section class="hero" aria-labelledby="hero-title">
			<ExploreWorld client:visible />
			<div class="hero-copy">
				<p class="eyebrow" data-motion-intro><span class="status-dot"></span> LONG-TERM QUESTION <span class="slash">/</span> RSI → AGI</p>
				<h1 data-motion-intro id="hero-title" data-i18n="home.hero.title" data-i18n-html="true">让智能，<br/><span class="serif">递归地变得更好</span><span class="period">.</span></h1>
				<p class="intro" data-motion-intro data-i18n="home.hero.intro" data-i18n-html="true">你好，我是枫语。<br/>我把学习、实验与系统构建，放在通向递归自我改进（RSI）与 AGI 的同一条路径上。</p>
				<div class="hero-actions" data-motion-intro><a class="pill primary" href="/world/"><span data-i18n="home.hero.explore">进入研究岛</span> <span>↗</span></a><a class="text-link" href="/paths/"><Text zh="开始阅读" en="START READING" /> <span>→</span></a></div>
			</div>
			<div class="hero-bottom"><span>INDEPENDENTLY THINKING<br/>SINCE ALWAYS</span><span>INTERACTIVE RESEARCH WORLD</span></div>
		</section>
		<section class="featured-study section-pad" id="model-workbench">
			<div class="section-kicker" data-motion-reveal><span>FEATURED STUDY — THE WHOLE CHAIN</span><span>DATA → MODEL</span></div>
			<div class="featured-grid" data-motion-reveal><div><p class="featured-overline"><Text zh="小模型 · 全链路训练" en="SMALL MODEL · END-TO-END TRAINING" /></p><Text as="h2" zh="从一段文字，到一个模型。" en="From a piece of text to a model." /><Text as="p" class="featured-copy" zh="数据、分词、预训练、后训练、评测与部署。沿着一个小模型的完整旅程，理解每一步如何连接，试着安排自己的第一份训练预算。" en="Data, tokenization, pretraining, post-training, evaluation, and deployment. Follow a small model's complete journey and plan a first training budget." /><div class="featured-links"><a class="pill primary" href="/lab/model-pipeline/"><Text zh="打开模型工作台" en="Open the model workbench" /> ↗</a><a class="arrow-link" href="/posts/2026-07-08-1b模型全链路实验计划/" data-i18n-href-zh="/posts/2026-07-08-1b模型全链路实验计划/" data-i18n-href-en="/en/posts/local-1b-model-workflow/"><Text zh="阅读实验方案" en="Read the plan" /> →</a></div><TrainingBudgetPreview client:visible /></div><a href="/lab/model-pipeline/" class="featured-visual" aria-label="打开小模型全链路互动工作台" data-i18n-aria-label-zh="打开小模型全链路互动工作台" data-i18n-aria-label-en="Open the small-model pipeline workbench"><span class="visual-corner">01 / MODEL WORKBENCH</span><ResearchVisual kind="model" /><div class="featured-stages"><span>DATA</span><i>→</i><span>TRAIN</span><i>→</i><span>EVAL</span><i>↺</i></div><div class="featured-scale"><span><b>~30M</b><Text zh="首轮实验目标" en="FIRST EXPERIMENT TARGET" /></span><span class="visual-arrow">↗</span></div></a></div>
		</section>
		<StudioRoutes />
		<section class="about section-pad" id="about">
			<div class="section-kicker" data-motion-reveal><span>01 — THE QUESTION</span><span>RSI · AGI</span></div>
			<div class="about-grid" data-motion-reveal><h2 data-i18n="home.about.heading" data-i18n-html="true">所有尝试，<br/><span>都指向同一个问题。</span></h2><div class="about-copy"><p data-i18n="home.about.question" data-i18n-zh={now.question} data-i18n-en={now.questionEn}>{now.question}</p><p data-i18n="home.about.mission" data-i18n-zh={now.aboutMission} data-i18n-en={now.aboutMissionEn}>{now.aboutMission}</p><a class="arrow-link" href="/about/"><span data-i18n="home.about.link">多了解一点关于我</span> <span>↗</span></a></div></div>
		</section>
		<section class="now section-pad" id="now">
			<div class="section-kicker" data-motion-reveal><span>02 — NOW / UPDATED {now.updatedAt}</span><span>THE LONG VIEW</span></div>
			<div class="now-grid"><h2 data-i18n="home.now.heading" data-i18n-html="true">把长期问题<br/><span>变成眼前的工作。</span></h2><div><p data-i18n="home.now.mission" data-i18n-zh={now.mission} data-i18n-en={now.missionEn}>{now.mission}</p><div class="now-threads" aria-label="研究问题及其相关文章" data-i18n-aria-label-zh="研究问题及其相关文章" data-i18n-aria-label-en="Research questions and related writing">{researchThreads.map((thread, index) => <article class="now-thread" data-motion-reveal><a class="now-thread-main" href={thread.href} data-i18n-href-zh={thread.href} data-i18n-href-en={thread.href}><span class="now-thread-number">0{index + 1}</span><span class="now-thread-copy"><strong data-i18n={`now.thread.${thread.id}.label`} data-i18n-zh={thread.label} data-i18n-en={thread.labelEn}>{thread.label}</strong><span data-i18n={`now.thread.${thread.id}.question`} data-i18n-zh={thread.question} data-i18n-en={thread.questionEn}>{thread.question}</span></span><b aria-hidden="true">↗</b></a><div class="now-sources"><span class="now-source-kicker" data-i18n="home.now.sources" data-i18n-zh="相关记录" data-i18n-en="RELATED WRITING">相关记录</span>{thread.sources.map((source: (typeof researchThreads)[number]["sources"][number]) => <a href={source.href} data-i18n-href-zh={source.href} data-i18n-href-en={source.hrefEn} data-i18n={`now.source.${thread.id}.${source.href}`} data-i18n-zh={source.label} data-i18n-en={source.labelEn}>{source.label}</a>)}</div></article>)}</div></div></div>
		</section>
		<section class="work section-pad" id="work">
			<div class="section-kicker" data-motion-reveal><span>03 — RESEARCH ARCHIVE</span><a href="/work/"><span data-i18n="home.work.link">查看完整研究档案</span> ↗</a></div>
			<div class="section-heading" data-motion-reveal><h2 data-i18n="home.work.heading" data-i18n-html="true">把想法，变成<span class="serif">实验。</span></h2><p data-i18n="home.work.copy" data-i18n-html="true">模型工作流、自我对弈、博弈学习与因果分析。<br/>四条路径，回答同一个长期问题。</p></div>
			<div class="work-list">{archive.map((item) => <a class="work-card" data-motion-hover data-motion-reveal href={item.caseHref} data-i18n-href-zh={item.caseHref} data-i18n-href-en={item.caseHref} style={`--accent:${item.color}`}><span class="work-number">{item.number}</span><div class="work-visual"><ResearchVisual kind={item.caseSlug === "local-1b-model-workflow" ? "model" : item.caseSlug === "alphazero-gomoku" ? "search" : "causal"} /></div><div class="work-main"><span class="work-type"><span data-i18n={`archive.${item.match}.kind`} data-i18n-zh={item.kindZh} data-i18n-en={item.kind}>{item.kindZh}</span> · <span data-i18n={`archive.${item.match}.thread`} data-i18n-zh={item.threadZh} data-i18n-en={item.thread}>{item.threadZh}</span></span><h3 data-i18n={`archive.${item.match}.title`} data-i18n-zh={item.title} data-i18n-en={item.titleEn}>{item.title}</h3><p data-i18n={`archive.${item.match}.summary`} data-i18n-zh={item.summary} data-i18n-en={item.summaryEn}>{item.summary}</p></div><span class="work-arrow">↗</span><span class="work-orb"></span></a>)}</div>
		</section>
		<section class="notes section-pad" id="notes">
			<div class="section-kicker" data-motion-reveal><span>04 — FROM THE NOTEBOOK</span><a href="/notes/"><span data-i18n="home.notes.link">全部文章</span> ↗</a></div>
			<div class="section-heading" data-motion-reveal><h2 data-i18n="home.notes.heading" data-i18n-html="true">边走，<span class="serif">边记录。</span></h2><p data-i18n="home.notes.copy">阅读、实验、踩坑，然后把它们写下来。</p></div>
			<div class="notes-list">{posts.map((post, i) => { const translation = englishPosts.find((entry) => entry.data.sourceId === post.id); const postHref = `/posts/${post.id.replace(/\.mdx?$/, "")}/`; const dateZh = post.data.published?.toLocaleDateString("zh-CN", { year: "numeric", month: "short" }) ?? ""; const dateEn = post.data.published?.toLocaleDateString("en-US", { year: "numeric", month: "short" }) ?? ""; return <a href={postHref} data-i18n-href-zh={postHref} data-i18n-href-en={translation ? `/en/posts/${translation.data.slug}/` : postHref} class="note-row" data-motion-reveal><span class="note-index">0{i + 1}</span><span class="note-title" data-i18n={`home.note.${i}`} data-i18n-zh={post.data.title} data-i18n-en={translation?.data.title}>{post.data.title}</span><span class="note-date" data-i18n={`home.note.date.${i}`} data-i18n-zh={dateZh} data-i18n-en={dateEn}>{dateZh}</span><span class="note-arrow">↗</span></a>; })}</div>
		</section>
		<section class="contact section-pad" id="contact">
			<div class="section-kicker" data-motion-reveal><span>05 — YOUR TURN</span><span>OPEN TO GOOD CONVERSATIONS</span></div>
			<p class="contact-pre" data-i18n="home.contact.pre">有想法？有问题？或者只是想打个招呼？</p><h2 data-i18n="home.contact.heading" data-i18n-html="true">那就<span class="serif">聊聊吧。</span></h2>
			<a class="contact-button" href="mailto:1160337988@qq.com"><span data-i18n="home.contact.button">给我写封邮件</span> <span>↗</span></a>
			<div class="contact-meta"><a href="https://github.com/meiluosi" target="_blank" rel="noreferrer">GITHUB ↗</a><a href="/rss/">RSS ↗</a><span>MADE WITH CURIOSITY · © 2026</span></div>
		</section>
		<footer class="footer"><a class="wordmark" href="#top"><span class="mark">F.</span><span>FENG YU</span></a><span>KEEP WANDERING. KEEP WONDERING.</span><a href="#top">BACK TO TOP ↑</a></footer>
	</main>
	<style>
		:global(html){scroll-behavior:smooth;background:var(--brand-paper)}:global(body){margin:0!important;background:var(--brand-paper)!important;color:var(--brand-ink)!important;font-family:Inter,"Helvetica Neue",Arial,sans-serif}:global(body>div){max-width:none!important}.folio{--ink:var(--brand-ink);--muted:var(--brand-muted);--lime:var(--brand-accent);--line:rgba(37,60,52,.13);position:relative;overflow:hidden;background:var(--brand-paper);color:var(--ink);min-height:100vh}.grain{position:absolute;inset:0;z-index:1;pointer-events:none;opacity:.035;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E")}.topbar,.hero,.section-pad,.footer{position:relative;z-index:2}.topbar{height:82px;padding:0 6vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.wordmark{display:flex;align-items:center;gap:12px;color:var(--ink);font-size:10px;letter-spacing:.18em;font-weight:600;text-decoration:none}.wordmark i{color:var(--lime);font-style:normal}.mark{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--brand-muted);border-radius:50%;color:var(--lime);font:italic 16px Georgia;letter-spacing:-.08em}.topbar nav{display:flex;align-items:center;gap:36px}.topbar nav a,.footer>a:last-child{font-size:9px;letter-spacing:.15em;color:var(--brand-body);text-decoration:none;transition:color .2s}.topbar nav a:hover,.footer a:hover{color:var(--lime)}.topbar .nav-contact{color:var(--lime)}.topbar nav span{font-size:13px;margin-left:5px}.hero{height:min(790px,calc(100svh - 82px));min-height:620px;padding:0 11vw;display:flex;align-items:center;border-bottom:1px solid var(--line);isolation:isolate}.world{position:absolute;z-index:-2;inset:0;width:100%;height:100%;opacity:.9}.hero:before{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 85% 25%,rgba(243,199,172,.35),transparent 42%),radial-gradient(ellipse at 65% 60%,rgba(213,228,216,.6),transparent 50%),linear-gradient(90deg,var(--brand-paper) 0%,rgba(243,246,241,.88) 40%,rgba(243,246,241,.26) 100%)}.hero-copy{max-width:730px;position:relative;z-index:1}.hero-copy:before{content:"";position:absolute;z-index:-1;inset:-42px -115px -38px -38px;pointer-events:none;background:linear-gradient(90deg,var(--brand-paper) 0%,rgba(243,246,241,.94) 56%,rgba(243,246,241,.5) 82%,transparent 100%);filter:blur(12px)}.eyebrow,.section-kicker,.work-type,.world-label,.coordinates,.hero-bottom,.note-index,.note-date,.contact-meta,.footer>span{font:9px/1.6 "JetBrains Mono",monospace;letter-spacing:.13em;color:var(--muted)}.status-dot{display:inline-block;width:6px;height:6px;background:var(--lime);border-radius:50%;box-shadow:0 0 12px var(--lime);margin-right:9px}.slash{color:var(--brand-muted);margin:0 8px}.hero h1{font-size:clamp(56px,6.3vw,88px);line-height:1.05;letter-spacing:-.075em;margin:36px 0 30px;font-weight:500}.serif{font-family:Georgia,"Songti SC",serif;font-weight:400;font-style:italic;letter-spacing:-.07em}.period{color:var(--lime)}.intro{font-size:15px;line-height:2;color:var(--brand-body);letter-spacing:.03em}.hero-actions{display:flex;align-items:center;gap:28px;margin-top:40px}.pill{height:46px;padding:0 22px;border-radius:30px;display:inline-flex;align-items:center;gap:25px;text-decoration:none;font-size:12px}.pill.primary{color:var(--brand-ink);background:var(--brand-peach);transition:transform .2s,background .2s}.pill.primary:hover{transform:translateY(-3px);background:var(--brand-peach-hover)}.text-link{color:var(--brand-body);font:9px "JetBrains Mono",monospace;letter-spacing:.12em;text-decoration:none}.text-link span{color:var(--lime);margin-left:5px}.world-label{position:absolute;right:13%;top:29%;display:flex;flex-direction:column;gap:7