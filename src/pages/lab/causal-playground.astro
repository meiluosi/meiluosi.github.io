---
import Navbar from "@/components/layout/Navbar.astro";
import Layout from "@/layouts/Layout.astro";
import ResearchQuestion from "@/components/features/ResearchQuestion.astro";
import CausalPlayground from "@/components/features/CausalPlayground.svelte";
---
<Layout title="因果效应与选择偏差实验— 枫语" titleEn="Causal effects and selection bias — Feng Yu" description="改变优惠券的发放方式，看看人群差异怎样影响你看到的效果。" descriptionEn="Change who receives a coupon and see how selection changes the apparent effect.">
	<Navbar />
	<main class="lab-page" id="swup-container">
		<header class="compact-page-heading"><h1 data-i18n="lab.title" data-i18n-zh="因果效应与选择偏差实验" data-i18n-en="Causal effects and selection bias">因果效应与选择偏差实验</h1></header>
		<ResearchQuestion question="如果把券随机地发出去，看到的提升还一样吗？" questionEn="Would the gain look the same if coupons were assigned at random?" hint="先保持优惠券的真实效果不变，只按一下“试试随机分配”。猜猜哪个数会改变，再看人群构成如何解释差异。" hintEn="Keep the actual coupon effect fixed and select “Try random assignment”. Predict which number will change, then see how the composition explains the difference." />
		<CausalPlayground client:load />
		<noscript><p>请启用 JavaScript 操作实验。默认设定下，直接比较为 +68，组内比较为 +20；其中 +48 来自人群构成差异。 / Enable JavaScript to use the sliders. The default raw difference is +68; the within-type effect is +20.</p></noscript>
		<footer><div><h2 data-i18n="lab.next.title" data-i18n-zh="相关研究与方法" data-i18n-en="Related research and methods">相关研究与方法</h2><p data-i18n="lab.next.body" data-i18n-zh="同样的问题也出现在模型评估里：表现变好了，究竟是干预有效，还是比较的条件变了？" data-i18n-en="The same question appears in model evaluation: did an intervention help, or did the conditions of comparison change?">同样的问题也出现在模型评估里：表现变好了，究竟是干预有效，还是比较的条件变了？</p></div><nav><a href="/work/ylearn-causal-inference/" data-i18n="lab.case" data-i18n-zh="阅读 YLearn 案例 ↗" data-i18n-en="Read the YLearn case ↗">阅读 YLearn 案例 ↗</a><a href="/posts/2024-6-30-应用ylearn框架实现因果推断/" data-i18n-href-zh="/posts/2024-6-30-应用ylearn框架实现因果推断/" data-i18n-href-en="/en/posts/ylearn-causal-inference/" data-i18n="lab.note" data-i18n-zh="继续读方法与代码 ↗" data-i18n-en="Continue to methods and code ↗">继续读方法与代码 ↗</a><a href="/rsi/#judgment" data-i18n="lab.notebook" data-i18n-zh="回到智能手记：怎样判断更好？ ↗" data-i18n-en="Back to the notebook: what counts as better? ↗">回到智能手记：怎样判断更好？ ↗</a></nav></footer>
	</main>
	<style>
		:global(body){margin:0!important;background:var(--brand-paper);color:var(--brand-ink);font-family:Inter,"Helvetica Neue",Arial,sans-serif}.lab-page{max-width:1200px;margin:auto;padding:65px 6vw 50px}header{max-width:760px;margin-bottom:42px}header>a{font-size:12px;color:var(--brand-accent);text-decoration:none}.eyebrow{font:10px "JetBrains Mono",monospace;color:var(--brand-muted);letter-spacing:.1em;margin:48px 0 22px}h1{font:400 clamp(38px,6vw,68px)/1.2 Georgia,"Songti SC",serif;letter-spacing:-.04em;margin:0 0 24px}.lead{font-size:17px;line-height:2;color:var(--brand-body)}footer{display:flex;justify-content:space-between;gap:40px;padding:40px 0 0}footer>div{max-width:540px}footer h2{font-size:23px;font-weight:450}footer p{font-size:16px;line-height:2;color:var(--brand-body)}footer nav{display:grid;align-content:center;gap:20px;flex-shrink:0}footer a{color:var(--brand-accent);font-size:14px;text-decoration:none}@media(max-width:700px){.lab-page{padding:40px 7vw}.eyebrow{margin-top:36px}.lead{font-size:16px}footer{display:block}footer nav{margin-top:24px}}
	</style>
</Layout>
