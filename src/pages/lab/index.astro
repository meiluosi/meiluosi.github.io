---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import ResearchVisual from "@/components/features/ResearchVisual.astro";
const experiments = [
	{ href: "/lab/mcts/", code: "01 / SEARCH & FEEDBACK", title: "一棵树，怎样学会选择？", titleEn: "How does a tree learn to choose?", question: "有限的搜索次数，应该花在看起来最好的分支，还是尚未探索的分支上？", questionEn: "Should a limited search budget go to the best-looking branch or an unexplored one?", control: "改变预算、探索权重与随机种子", controlEn: "Change budget, exploration weight, and seed", outcome: "观察四个搜索阶段、访问次数与根动作的变化。", outcomeEn: "Watch the four search phases, visits, and root decision change.", tag: "MCTS / UCT", path: "search-to-self-play" },
	{ href: "/lab/causal-playground/", code: "02 / CAUSAL EVALUATION", title: "相关，还是因果？", titleEn: "Correlation or causation?", question: "拿到优惠券的人消费更多，是券起了作用，还是两组人本来就不同？", questionEn: "Do coupon recipients spend more because of the coupon, or because the groups were different?", control: "改变发券偏好与真实效果", controlEn: "Change assignment bias and the actual effect", outcome: "观察直接比较与组内比较怎样产生差异。", outcomeEn: "See the raw difference diverge from the within-type effect.", tag: "SELECTION BIAS / ATE", path: "evaluating-improvement" },
];
---
<ExploreLayout title="实验室" titleEn="Lab" description="从全链路模型训练到搜索与因果评估，用互动工作台理解智能系统。" descriptionEn="Interactive workbenches for end-to-end model training, search, and causal evaluation.">
	<header class="explore-hero"><p class="explore-kicker">SMALL EXPERIMENTS / BIG QUESTIONS</p><Text as="h1" zh="改一个参数，换一种理解。" en="Change a parameter. Find a new perspective." /><Text as="p" class="explore-lead" zh="把抽象方法拆成可以观察的过程。先做一次选择，看看结果，再带着直觉回到文章。" en="Make an abstract method observable. Try a choice, see what happens, then take that intuition back to the writing." /></header>
	<article class="pipeline-feature"><div><p class="explore-kicker">FEATURED / FROM DATA TO MODEL</p><Text as="h2" zh="一个小模型，走完一整条路。" en="A small model. The whole journey." /><Text as="p" zh="数据、分词、随机初始化预训练、SFT、DPO、评测与部署。选择阶段，检查输入输出，再安排第一次训练的预算。" en="Data, tokenization, pretraining from random weights, SFT, DPO, evaluation, and deployment. Choose a stage, inspect its inputs and outputs, and plan a first training budget." /><a class="explore-link" href="/lab/model-pipeline/"><Text zh="打开模型工作台" en="Open the model workbench" /> ↗</a></div><a class="pipeline-picture" href="/lab/model-pipeline/" aria-label="小模型全链路互动工作台" data-i18n-aria-label-zh="小模型全链路互动工作台" data-i18n-aria-label-en="Small-model pipeline workbench"><ResearchVisual kind="model" /><span>~30M → ~100M → ?</span></a></article>
	<div class="lab-cards">{experiments.map((item) => <article class="explore-card"><p class="explore-kicker">{item.code}</p><div class="lab-illustration" aria-hidden="true">{item.path === "search-to-self-play" ? <svg viewBox="0 0 300 110"><path d="M150 12L60 65M150 12L240 65M60 65L25 98M60 65L95 98M240 65L205 98M240 65L275 98" fill="none" stroke="currentColor" stroke-width="1.5"/>{[[150,12],[60,65],[240,65],[25,98],[95,98],[205,98],[275,98]].map(([x,y]) => <circle cx={x} cy={y} r="7" fill="currentColor" />)}</svg> : <div class="mini-bars"><span><i style="width:80%"></i></span><span><i style="width:20%"></i></span><b>Δ ?</b></div>}</div><Text as="h2" zh={item.title} en={item.titleEn} /><Text as="p" zh={item.question} en={item.questionEn} /><Text as="p" class="lab-control" zh={item.control} en={item.controlEn} /><Text as="p" zh={item.outcome} en={item.outcomeEn} /><div class="lab-links"><a class="explore-link" href={item.href}><Text zh="开始实验" en="Try the experiment" /> ↗</a><a class="explore-link" href={`/paths/${item.path}/`}><Text zh="对应阅读路线" en="Reading path" /> →</a></div></article>)}</div>
	<section class="explore-section" style="margin-top:42px"><Text as="h2" zh="从直觉走向方法。" en="From intuition to method." /><Text as="p" class="explore-body" zh="实验使用简化的教学模型，规则写在每个实验的说明里。可以先猜测改变参数会发生什么，再运行观察；把意外的结果记下来，往往就是下一次阅读的起点。" en="These experiments use simplified teaching models, with assumptions explained on each page. Predict what a parameter change will do, then run it. An unexpected result often becomes a useful starting point for further reading." /></section>
</ExploreLayout>
<style>.lab-cards{display:grid;grid-template-columns:1fr 1fr;gap:24px}.lab-cards :global(h2){font-size:28px;margin-top:28px}.lab-illustration{height:150px;display:grid;place-items:center;background:var(--brand-paper);border-radius:10px;color:var(--brand-accent);margin:24px 0}.lab-illustration svg{width:80%;height:110px}.mini-bars{width:75%;position:relative;padding-right:45px}.mini-bars>span{display:block;height:20px;background:var(--brand-peach);border-radius:4px;overflow:hidden;margin:12px 0}.mini-bars i{display:block;height:100%;background:var(--brand-accent)}.mini-bars b{position:absolute;right:0;top:24px;font:20px Georgia}.lab-control{padding-top:20px;border-top:1px solid var(--brand-line)}.lab-links{display:flex;flex-wrap:wrap;gap:12px 25px}@media(max-width:760px){.lab-cards{grid-template-columns:1fr}.lab-cards :global(h2){font-size:26px}}</style>

<style>.pipeline-feature{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:center;padding:35px;background:var(--brand-surface);border:1px solid var(--brand-line);border-radius:18px;margin-bottom:25px}.pipeline-feature :global(h2){font:400 34px/1.4 Georgia,"Songti SC",serif;margin:15px 0}.pipeline-feature :global(p:not(.explore-kicker)){font-size:13px;line-height:1.95;color:var(--brand-body)}.pipeline-feature .explore-kicker{margin-bottom:12px}.pipeline-picture{text-decoration:none;text-align:center;color:var(--brand-accent);min-width:0}.pipeline-picture>span{display:block;margin-top:20px;font:11px "JetBrains Mono",monospace;letter-spacing:.06em}.pipeline-picture :global(.research-visual){background:transparent}@media(max-width:760px){.pipeline-feature{grid-template-columns:1fr;gap:15px;padding:25px}.pipeline-feature :global(h2){font-size:29px}.pipeline-picture{max-width:320px;width:100%;justify-self:center}.pipeline-picture>span{margin-top:8px}}</style>
