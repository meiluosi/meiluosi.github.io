---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import ResearchQuestion from "@/components/features/ResearchQuestion.astro";
import MctsPlayground from "@/components/features/MctsPlayground.svelte";
---
<ExploreLayout title="MCTS 互动实验" titleEn="MCTS playground" description="逐步观察蒙特卡洛树搜索，比较搜索预算与探索权重对决策的影响。" descriptionEn="Step through Monte Carlo tree search and explore how budget and exploration affect decisions.">
	<header class="explore-hero compact-page-heading"><Text as="h1" zh="蒙特卡洛树搜索实验" en="Monte Carlo tree search" /></header>
	<ResearchQuestion question="多想几次，答案就一定更好吗？" questionEn="Will a few more tries always lead to a better answer?" hint="先用 10 次预算跑完搜索，记住首选动作，再在相同种子下改为 50 次。观察访问次数与建议怎样变化；这里改变的是搜索树的记忆，模型参数没有更新。" hintEn="Finish a budget of 10 trials and note the recommended action. Keep the seed and try 50. Watch the visits and recommendation change: this updates search statistics, not model parameters." />
	<MctsPlayground client:load /><noscript><p>请启用 JavaScript 操作实验，或阅读下方的方法笔记。 / Enable JavaScript to use the experiment, or read the notes below.</p></noscript>
	<section class="explore-section" style="margin-top:40px"><Text as="h2" zh="搜索与策略学习" en="Search and policy learning" /><Text as="p" class="explore-body" zh="这个实验更新的是搜索树上的统计量。结合 AlphaZero 的实现案例，可以进一步理解搜索结果怎样成为训练信号，以及模型更新怎样影响下一轮搜索。" en="This experiment updates statistics in a search tree. Review the AlphaZero implementation case to see how search results become training signals and how updated models affect the next search." /><a class="explore-link" href="/work/alphazero-gomoku/"><Text zh="从搜索到自我对弈" en="From search to self-play" /> ↗</a><p><a class="explore-link" href="/rsi/#change"><Text zh="回到智能手记：这次改变了什么？" en="Back to the notebook: what changed?" /> ↗</a></p></section>
</ExploreLayout>
