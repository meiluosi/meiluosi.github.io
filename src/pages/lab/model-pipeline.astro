---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import ModelPipeline from "@/components/features/ModelPipeline.svelte";
const article = "/posts/2026-07-08-1b模型全链路实验计划/";
const articleEn = "/en/posts/local-1b-model-workflow/";
const readingSteps = [
	{ title: "数据", titleEn: "Data", text: "记录来源和许可，先去重，再按文档关联组划分 train / validation / test。训练集更新参数，验证集选配置，测试集留给最终比较。", textEn: "Record sources and licenses, deduplicate, then split related document groups into train / validation / test. Training updates parameters, validation guides configurations, and test data is reserved for final comparisons." },
	{ title: "分词", titleEn: "Tokenization", text: "只在训练集上拟合词表并冻结版本，验证编解码与特殊 token。教学 BPE 可演示高频组合合并；工程分词器必须另行验证文本回环与数据打包。", textEn: "Fit a vocabulary only on training data, freeze its version, and verify decoding and special tokens. The teaching BPE demonstrates frequent-pair merges; the engineering tokenizer needs separate round-trip and packing checks." },
	{ title: "随机初始化预训练", titleEn: "Pretraining from random weights", text: "用随机初始化的 decoder-only Transformer 预测下一个 token。先用 tiny 做少量更新，验证有限损失、梯度、保存和恢复；再测量约 30M 首个完整实验的成本。", textEn: "Train a randomly initialized decoder-only Transformer to predict the next token. First run a few tiny updates to verify finite loss, gradients, saving, and resuming; then measure the cost of a first complete experiment around 30M parameters." },
	{ title: "SFT", titleEn: "SFT", text: "从自己的基座继续训练，固定对话模板，提示词作为上下文，assistant 回答与结束符计入损失，padding 不计入。保存模板与掩码规则。", textEn: "Continue from your own base model with a fixed chat template. Prompts provide context; assistant responses and stop tokens contribute to loss while padding does not. Save the template and mask rules." },
	{ title: "DPO", titleEn: "DPO", text: "为同一提示准备 chosen / rejected，固定 SFT 参考模型。相对参考的回答对数概率差进入偏好损失；训练后仍要检查长度、格式与基础任务能力。", textEn: "Pair chosen/rejected responses to the same prompt and freeze an SFT reference. The response log-probability gap relative to the reference determines preference loss. Check length, format, and base-task performance afterwards." },
	{ title: "评测", titleEn: "Evaluation", text: "固定数据、分词器与掩码，按目标 token 数汇总 NLL，perplexity = exp(NLL)。分别报告任务、格式和偏好指标，保留样本数与原始输出。", textEn: "Fix the data, tokenizer, and masks. Aggregate NLL by target-token count; perplexity = exp(NLL). Report task, format, and preference metrics separately, keeping sample counts and raw outputs." },
	{ title: "部署与下一轮", titleEn: "Deployment and the next iteration", text: "一起导出权重、配置、分词器、模板、环境与模型说明。干净环境独立加载并核对固定输入；量化单独复测。把失败样例送回下一轮数据与评测设计。", textEn: "Export weights, configuration, tokenizer, template, environment, and model card together. Load independently in a clean environment and compare fixed inputs; re-evaluate quantization separately. Feed failure cases into the next data and evaluation design." },
];
---
<ExploreLayout title="小模型全链路训练" titleEn="A small model, end to end" description="从数据与分词开始，连接随机初始化预训练、SFT、DPO、评测与本地部署。面向 Apple M4 Air / 16 GiB 的教学互动与测量驱动规划。" descriptionEn="Connect data, tokenization, pretraining from random weights, SFT, DPO, evaluation, and local deployment. Teaching interactions and a measurement-led plan for MacBook Air M4 with 16 GiB memory.">
	<header class="explore-hero pipeline-hero"><p class="explore-kicker">FEATURED EXPERIMENT / FROM DATA TO MODEL</p><Text as="h1" zh="一个小模型，走完一整条路。" en="A small model. The whole journey." /><Text as="p" class="explore-lead" zh="从原始文本到可交付的模型，把数据、训练、后训练和评测连接起来。先用 tiny 验证工程链路，把约 30M 作为首个完整实验；100M 与 0.5B 都以资源实测为前提。" en="Connect raw text, training, post-training, and evaluation into a deliverable model. Start with a tiny engineering smoke test and plan approximately 30M for the first full experiment. Both 100M and 0.5B depend on measured resources." /><div class="hero-tags"><span>DATA → TOKENIZE → PRETRAIN → POST-TRAIN → EVALUATE → DEPLOY</span><span>RSI / THE MODEL SYSTEM</span></div></header>
	<div class="interactive-workbench"><ModelPipeline client:load /></div>
	<noscript><style is:inline>.interactive-workbench { display: none; }</style><p class="no-script-note">互动计算需要 JavaScript；展开下方静态导读即可阅读全部阶段，也可以直接进入完整方案。 / Interactive calculations require JavaScript. Expand the static guide below to read every stage, or open the full plan.</p></noscript>
	<details class="static-guide">
		<summary><Text zh="静态导读与一手资料：无需 JavaScript，也能走完整条路" en="Static guide and primary sources: the full path without JavaScript" /></summary>
		<ol>{readingSteps.map((step) => <li><Text as="h3" zh={step.title} en={step.titleEn} /><Text as="p" zh={step.text} en={step.textEn} /></li>)}</ol>
		<p class="source-note"><Text zh="互动区中的概率、偏好和评测对照均为给定数值的教学计算，预算是公式估算。它们不构成模型训练结果。算法说明参考：" en="Probabilities, preference values, and evaluation comparisons in the workbench are teaching calculations with given inputs; budgets are formula estimates. They are not model training results. Primary references: " /> <a href="https://huggingface.co/learn/llm-course/en/chapter6/5">Hugging Face · BPE</a> · <a href="https://docs.pytorch.org/docs/stable/generated/torch.nn.CrossEntropyLoss.html">PyTorch · CrossEntropyLoss</a> · <a href="https://arxiv.org/abs/2305.18290">DPO paper</a></p>
	</details>
	<section class="explore-section next-reading"><div><p class="explore-kicker">ONE MAIN TRACK / ONE OPTIONAL BRANCH</p><Text as="h2" zh="从零训练，与现成基座微调。" en="From-scratch training and pretrained-model adaptation." /><Text as="p" class="explore-body" zh="主线从自己的语料、分词器和随机初始化模型出发，贯穿预训练、SFT、DPO 与评测。0.5B 现成基座的 LoRA 微调可以单独开展，用来学习后训练工具链；它有不同的起点、成本和实验问题。" en="The main track starts with your corpus, tokenizer, and a randomly initialized model, continuing through pretraining, SFT, DPO, and evaluation. LoRA on an existing 0.5B base model can be a separate study of post-training tools, with a different starting point, cost, and research question." /></div><aside><span class="reading-label">THE NOTEBOOK</span><Text as="h3" zh="把每一步，落到可复现的记录。" en="Make each step reproducible." /><Text as="p" zh="文章记录实验范围、实现顺序和验收条件。可迁移项目从 tiny 工程验证起步；真实运行的配置、数据版本、原始日志与模型产物单独记录，不能由这里的教学数值代替。" en="The article records scope, implementation order, and acceptance criteria. The portable project starts with tiny engineering checks. Actual configurations, data versions, raw logs, and model artifacts are recorded separately from these teaching values." /><a class="explore-link" href={article} data-i18n-href-zh={article} data-i18n-href-en={articleEn}><Text zh="阅读完整实验方案" en="Read the full experiment plan" /> ↗</a></aside></section>
	<div class="related-routes"><a href="/paths/models-to-systems/"><Text zh="继续：从模型到可检验的系统" en="Continue: from models to testable systems" /> →</a><a href="/world/"><Text zh="回到研究岛" en="Back to the research island" /> ↗</a></div>
</ExploreLayout>
<style>
	.pipeline-hero{max-width:950px}.pipeline-hero :global(h1){max-width:850px}.hero-tags{display:flex;flex-wrap:wrap;gap:12px 25px;margin-top:30px;font:8px/1.8 "JetBrains Mono",monospace;letter-spacing:.05em;color:var(--brand-muted)}.hero-tags>span:first-child{color:var(--brand-accent)}.next-reading{display:grid;grid-template-columns:1.2fr .8fr;gap:50px;margin-top:48px}.next-reading :global(h2){font-size:30px;margin:15px 0}.next-reading aside{padding:25px 28px;background:var(--brand-peach);border-radius:14px;align-self:start}.reading-label{font:8px monospace;color:var(--brand-clay);letter-spacing:.1em}.next-reading aside :global(h3){font-size:21px;margin:15px 0}.next-reading aside :global(p){font-size:12px;line-height:1.95;color:var(--brand-body)}.next-reading aside .explore-link{color:var(--brand-ink);border-color:rgba(37,60,52,.25)}.related-routes{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:22px 0;border-top:1px solid var(--brand-line)}.related-routes a{font-size:12px;line-height:1.8;color:var(--brand-accent);text-decoration:none}@media(max-width:760px){.next-reading{grid-template-columns:1fr;gap:25px;margin-top:32px}.next-reading :global(h2){font-size:26px}.hero-tags{font-size:7px;gap:8px}.next-reading aside{padding:23px}}

	.static-guide{margin-top:22px;padding:20px 25px;border:1px solid var(--brand-line);border-radius:14px}.static-guide summary{cursor:pointer;font-size:12px;line-height:1.9;color:var(--brand-accent)}.static-guide summary:focus-visible{outline:2px solid var(--brand-accent);outline-offset:5px}.static-guide ol{padding-left:24px;margin:24px 0}.static-guide li{padding-left:5px;margin:0 0 20px}.static-guide :global(h3){font-size:14px;margin:0 0 7px}.static-guide :global(p),.no-script-note{font-size:12px;line-height:1.9;color:var(--brand-body)}.source-note{padding-top:15px;border-top:1px solid var(--brand-line)}.source-note a{color:var(--brand-accent)}@media(max-width:600px){.static-guide{padding:17px}.static-guide summary{font-size:11px}}
</style>
