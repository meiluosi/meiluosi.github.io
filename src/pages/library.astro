---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import { library } from "@/data/library";
import { readingPaths } from "@/data/readingPaths";
import { getResearchNotes, requireResearchNote } from "@/utils/research-content";
const notes = await getResearchNotes();
---
<ExploreLayout title="文献架" titleEn="Library" description="连接原始论文、教材、工具与站内笔记的研究文献架。" descriptionEn="Original papers, textbooks, and tools connected to the site’s research notes.">
	<header class="explore-hero"><p class="explore-kicker">BACK TO THE SOURCES / LIBRARY</p><Text as="h1" zh="带着问题，读原始资料。" en="Read the sources with a question." /><Text as="p" class="explore-lead" zh="把论文、教材与工具放到同一张阅读地图上。每份资料附有一个阅读切口，以及可以接着读的站内笔记。" en="Papers, textbooks, and tools on one reading map. Each source comes with a suggested focus and links to notes that continue the question." /></header>
	<div class="library-filter"><label for="library-path"><Text zh="按阅读路线筛选" en="Filter by reading path" /></label><select id="library-path"><Text as="option" zh="全部资料" en="All sources" />{readingPaths.map((path) => <option value={path.slug} data-i18n="library.path" data-i18n-zh={path.title} data-i18n-en={path.titleEn}>{path.title}</option>)}</select><output id="library-count" aria-live="polite">6 / 6</output></div>
	<div class="library-list">{library.map((item) => <article id={item.id} data-library-path={item.path} class="explore-card"><div class="source-meta"><Text zh={item.kind} en={item.kindEn} /> / {item.year} · {item.authors}</div><h2><a href={item.url}>{item.title} <span aria-hidden="true">↗</span></a></h2><Text as="p" zh={item.focus} en={item.focusEn} /><div class="source-notes"><Text as="small" zh="关联笔记" en="CONNECTED NOTES" />{item.notes.map((id) => { const note = requireResearchNote(notes, id); return <a href={note.href} data-i18n-href-zh={note.href} data-i18n-href-en={note.hrefEn}><Text zh={note.title} en={note.titleEn} /> →</a>; })}</div></article>)}</div>
</ExploreLayout>
<script>
	const select = document.querySelector<HTMLSelectElement>("#library-path");
	if (select) {
		select.options[0].value = "";
		const apply = () => { const value = select.value; let count = 0; document.querySelectorAll<HTMLElement>("[data-library-path]").forEach((item) => { item.hidden = Boolean(value && item.dataset.libraryPath !== value); if (!item.hidden) count++; }); const output = document.querySelector("#library-count"); if (output) output.textContent = `${count} / 6`; };
		const restore = () => { const value = new URL(location.href).searchParams.get("path") ?? ""; select.value = [...select.options].some((option) => option.value === value) ? value : ""; apply(); };
		select.addEventListener("change", () => { const url = new URL(location.href); if (select.value) url.searchParams.set("path", select.value); else url.searchParams.delete("path"); history.pushState({}, "", url); apply(); });
		window.addEventListener("popstate", restore); restore();
	}
</script>
<style>.library-filter{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:0 0 24px;font-size:12px;color:var(--brand-body)}select{max-width:100%;border:1px solid var(--brand-line);border-radius:8px;padding:12px;background:var(--brand-surface);color:var(--brand-ink)}output{margin-left:auto;font:11px monospace}.library-list{display:grid;grid-template-columns:1fr 1fr;gap:18px}.library-list article[hidden]{display:none}.source-meta{font:10px/1.9 monospace;color:var(--brand-muted)}.library-list h2{font:400 24px/1.45 Georgia,serif;margin:20px 0}.library-list a{color:var(--brand-ink);text-decoration:none}.library-list a:hover{color:var(--brand-accent)}.source-notes{display:grid;gap:10px;padding-top:18px;margin-top:22px;border-top:1px solid var(--brand-line);font-size:12px;line-height:1.8}.source-notes :global(small){font-size:9px;letter-spacing:.06em;color:var(--brand-muted)}@media(max-width:700px){.library-list{grid-template-columns:1fr}.library-list h2{font-size:22px}}</style>
