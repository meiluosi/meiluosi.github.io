---
import { getCollection } from "astro:content";
import Text from "@/components/common/BilingualText.astro";
import NoteSearch from "@/components/features/NoteSearch.astro";
import Navbar from "@/components/layout/Navbar.astro";
import {
	categoryLabelsEn,
	categoryLabels as categoryLabelsShared,
} from "@/data/category-labels";
import { ROUTE_CLUSTERS } from "@/data/intelligenceRoutes";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostMaturity, MATURITY_DEFINITIONS } from "@/utils/digital-garden";
import { resolvePostRoute } from "@/utils/route-matcher";
import { removeFileExtension } from "@/utils/url-utils";

const posts = (await getSortedPosts()).filter(
	(post) => !post.data.draft && !post.data.password,
);
const englishPosts = await getCollection("enPosts");
const postUrl = (id: string) => `/posts/${id.replace(/\.mdx?$/, "")}/`;
const dateLabel = (date: Date) =>
	new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "short" }).format(
		date,
	);
const dateLabelEn = (date: Date) =>
	new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short" }).format(
		date,
	);
const categoryLabels: Record<string, string> = categoryLabelsShared;
const tagLabels: Record<string, string> = {
	Agent与RAG: "Agents & RAG",
	"Apple Silicon": "Apple Silicon",
	LLM全链路: "Full-stack LLM",
	MLX: "MLX",
	QLoRA: "QLoRA",
	"后训练(RLHF/DPO)": "Post-training (RLHF/DPO)",
	因果推断: "Causal Inference",
	大模型训练: "LLM Training",
	实验计划: "Experiment Plan",
	工程实践: "Engineering",
	强化学习: "Reinforcement Learning",
	推理优化: "Inference Optimization",
	数据处理: "Data Processing",
	模型架构: "Model Architecture",
	游戏AI与搜索: "Game AI & Search",
};
const categories = [
	...new Set(
		posts.map((post) => post.data.category?.trim() || "Uncategorized"),
	),
].sort();
const formatLabels: Record<string, string> = {
	plan: "实验计划",
	"code-example": "代码示例",
	application: "应用拆解",
	technical: "技术讲解",
	experiment: "实验方法",
	reflection: "学习与思考",
};
const formats = Object.keys(formatLabels);
const maturities: Array<keyof typeof MATURITY_DEFINITIONS> = [
	"seedling",
	"budding",
	"evergreen",
	"speculative",
];
---

<Layout title="文章 — 枫语" titleEn="Writing — Feng Yu" description="学习时的笔记、动手做过的尝试，以及还在琢磨的问题。" descriptionEn="Notes from learning, things I’ve tried making, and questions still taking shape.">
	<div class="notes-page" data-brand-motion data-note-view="cards">
		<Navbar />
		<header class="notes-hero"><h1><Text zh="技术文章与研究笔记" en="Technical articles and research notes" /></h1></header>

		<main class="entries" id="swup-container"><NoteSearch /><div class="entries-head"><div class="head-left"><Text zh="全部文章" en="All writing" /><a class="cosmos-link-badge" href="/graph/" title="进入全站知识星系"><span>🌌</span><Text zh="认知星系" en="Knowledge Cosmos" /></a></div><div class="view-switch" role="group" aria-label="文章显示方式" data-i18n-aria-label-zh="文章显示方式" data-i18n-aria-label-en="Article display"><button type="button" data-note-view-button="cards" aria-pressed="true"><Text zh="卡片" en="Cards" /></button><button type="button" data-note-view-button="list" aria-pressed="false"><Text zh="列表" en="List" /></button></div></div><section class="filters" aria-label="筛选研究笔记" data-i18n-aria-label-zh="筛选研究笔记" data-i18n-aria-label-en="Filter notes"><div class="filter-group"><span class="filter-label" data-i18n="notes.maturity">成熟度</span><div class="filter-options"><button type="button" data-note-maturity-filter="all" aria-pressed="true" data-i18n="notes.all">全部</button>{maturities.map((mat) => <button type="button" data-note-maturity-filter={mat} aria-pressed="false" data-i18n={`notes.maturity.${mat}`} data-i18n-zh={`${MATURITY_DEFINITIONS[mat].icon} ${MATURITY_DEFINITIONS[mat].labelZh}`} data-i18n-en={`${MATURITY_DEFINITIONS[mat].icon} ${MATURITY_DEFINITIONS[mat].labelEn}`}>{MATURITY_DEFINITIONS[mat].icon} {MATURITY_DEFINITIONS[mat].labelZh}</button>)}</div></div><div class="filter-group"><span class="filter-label" data-i18n="notes.format">形式</span><div class="filter-options"><button type="button" data-note-format-filter="all" aria-pressed="true" data-i18n="notes.all">全部</button>{formats.map((format) => <button type="button" data-note-format-filter={format} aria-pressed="false" data-i18n={`notes.format.${format}`}>{formatLabels[format]}</button>)}</div></div><div class="filter-group"><span class="filter-label"><Text zh="路线" en="Routes" /></span><div class="filter-options"><button type="button" data-note-cluster-filter="all" aria-pressed="true" data-i18n="notes.all">全部</button>{ROUTE_CLUSTERS.map((cluster) => <button type="button" data-note-cluster-filter={cluster.id} aria-pressed="false" title={cluster.descZh}><Text zh={cluster.nameZh} en={cluster.nameEn} /></button>)}</div></div><div class="filter-group"><span class="filter-label" data-i18n="notes.topic">方向</span><div class="filter-options"><button type="button" data-note-topic-filter="all" aria-pressed="true" data-i18n="notes.all">全部</button>{categories.map((category) => <button type="button" data-note-topic-filter={category} aria-pressed="false" data-i18n="notes.topic.category" data-i18n-zh={categoryLabels[category] ?? category} data-i18n-en={categoryLabelsEn[category] ?? category}>{categoryLabels[category] ?? category}</button>)}</div></div></section><p class="note-results" data-note-results role="status" aria-live="polite" aria-atomic="true"></p><div class="note-empty" data-note-empty hidden><p data-i18n="notes.empty" data-i18n-zh="没有匹配的笔记，试试其他关键词或筛选条件。" data-i18n-en="No matching notes. Try another keyword or filter.">没有匹配的笔记，试试其他关键词或筛选条件。</p><button type="button" data-note-reset data-i18n="notes.reset" data-i18n-zh="清空搜索与筛选" data-i18n-en="Reset search and filters">清空搜索与筛选</button></div><div class="note-grid">{posts.map((post, index) => {
				const category = post.data.category?.trim() || "Uncategorized";
				const translation = englishPosts.find(
					(entry) => entry.data.sourceId === removeFileExtension(post.id),
				);
				const maturityMeta = getPostMaturity(post);
				const postRoute = resolvePostRoute(post.data);
				return (
					<a
						class="entry"
						href={postUrl(post.id)}
						data-i18n-href-zh={postUrl(post.id)}
						data-i18n-href-en={translation ? `/en/posts/${translation.data.slug}/` : postUrl(post.id)}
						data-note-id={post.id}
						data-note-format={post.data.format}
						data-note-maturity={maturityMeta.level}
						data-note-category={category}
						data-note-cluster={postRoute?.cluster || ""}
						data-note-route={postRoute?.id || ""}
					>
						<span class="entry-n">{(index + 1).toString().padStart(2, "0")}</span>
						<div class="entry-content">
							<div class="entry-labels">
								{postRoute && (
									<span class="route-badge" title={`智能探索路线 ${postRoute.roman}: ${postRoute.nameZh}`}>
										🧭 {postRoute.roman} {postRoute.nameZh}
									</span>
								)}
								<span class="maturity-badge" style={`color: ${maturityMeta.color}`}>
									<span class="maturity-icon">{maturityMeta.icon}</span>
									<span data-i18n={`notes.maturity.${maturityMeta.level}`} data-i18n-zh={maturityMeta.labelZh} data-i18n-en={maturityMeta.labelEn}>{maturityMeta.labelZh}</span>
								</span>
								<span class="category" data-i18n={`notes.format.${post.data.format}`}>
									{formatLabels[post.data.format]}
								</span>
								<span class="topic-label" data-i18n="notes.topic.category" data-i18n-zh={categoryLabels[category] ?? category} data-i18n-en={categoryLabelsEn[category] ?? category}>{categoryLabels[category] ?? category}</span>
								{!translation && (
									<span class="topic-label locale-badge" data-locale-notice hidden data-i18n="notes.originalChinese">中文原文</span>
								)}
							</div>
							<h2
								data-i18n={translation ? `notes.title.${translation.data.slug}` : undefined}
								data-i18n-zh={post.data.title}
								data-i18n-en={translation?.data.title}
							>
								{post.data.title}
							</h2>
							{post.data.description && (
								<p data-i18n={translation ? `notes.description.${translation.data.slug}` : undefined} data-i18n-zh={post.data.description} data-i18n-en={translation?.data.description}>
									{post.data.description}
								</p>
							)}
							<p class="search-excerpt" data-note-excerpt hidden></p>
							<div class="tags">
									{post.data.tags.slice(0, 3).map((tag) => <span data-i18n="notes.tag" data-i18n-zh={tag} data-i18n-en={tagLabels[tag] ?? tag}>{tagLabels[tag] ?? tag}</span>)}
							</div>
						</div>
						<time data-i18n="notes.date" data-i18n-zh={dateLabel(post.data.published)} data-i18n-en={dateLabelEn(post.data.published)}>{dateLabel(post.data.published)}</time>
						<b>↗</b>
					</a>
				);
			})}</div></main>

	</div>
	<script>
		import { mountNoteFilters } from "@/utils/note-filters";
		let cleanup = mountNoteFilters();
		window.addEventListener("pagehide", () => cleanup());
		window.addEventListener("pageshow", (event) => {
			if (event.persisted) { cleanup(); cleanup = mountNoteFilters(); }
		});
	</script>
	<style>
		:global(html) { background: var(--brand-paper); }
		:global(body) { margin: 0 !important; background: var(--brand-paper) !important; color: var(--brand-ink) !important; font-family: Inter, "PingFang SC", "Microsoft YaHei", sans-serif; }
		.notes-page { min-height: 100vh; background: var(--brand-paper); color: var(--brand-ink); }
		.notes-hero { padding: 68px 11vw 42px; border-bottom: 1px solid var(--brand-line); }
		.notes-hero h1 { font-size: clamp(38px, 5.5vw, 68px); line-height: 1.4; letter-spacing: -.025em; margin: 25px 0 20px; }
		.notes-hero h1 em { color: var(--brand-accent); font-style: normal; }
		.entries { padding: 0 11vw; }
		.entries-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; border-bottom: 1px solid var(--brand-line); color: var(--brand-muted); font-size: 13px; line-height: 1.8; }
		.head-left { display: flex; align-items: center; gap: 14px; }
		.cosmos-link-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; background: rgba(92, 122, 107, 0.12); color: var(--brand-accent); font-size: 12px; text-decoration: none; border: 1px solid rgba(92, 122, 107, 0.3); transition: all 0.15s ease; }
		.cosmos-link-badge:hover { background: var(--brand-accent); color: #fff; }
		.route-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; font-weight: 500; padding: 2px 8px; border-radius: 4px; background: rgb(243 199 172 / 20%); border: 1px solid rgb(145 86 56 / 22%); color: var(--brand-clay); font-family: var(--font-serif, serif); }
		.maturity-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600; padding: 2px 7px; border-radius: 4px; background: var(--brand-surface); border: 1px solid var(--brand-line); }
		.filters { display: grid; gap: 12px; padding: 18px 0; border-bottom: 1px solid var(--brand-line); }
		.filter-group { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 10px; align-items: start; }
		.filter-label { padding-top: 9px; font-size: 13px; line-height: 1.5; color: var(--brand-muted); }
		.filter-options { display: flex; gap: 7px; flex-wrap: wrap; min-width: 0; }
		.filters button { border: 1px solid var(--brand-line); border-radius: 20px; background: transparent; padding: 8px 12px; color: var(--brand-body); font: 13px/1.5 Inter, "PingFang SC", sans-serif; cursor: pointer; }
		.filters button[aria-pressed="true"], .filters button:hover { border-color: var(--brand-accent); color: var(--brand-accent); background: var(--brand-surface); }
		.entry[hidden], .search-excerpt[hidden] { display: none; }
		.entry { display: grid; grid-template-columns: minmax(0, 1fr) 110px 24px; gap: 24px; align-items: start; padding: 29px 0; border-bottom: 1px solid var(--brand-line); color: var(--brand-ink); text-decoration: none; }
		.entry:hover h2 { color: var(--brand-accent); }
		.entry-n { display: none; }
		.entry-labels { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
		.entry-content .category, .topic-label { font-size: 13px; line-height: 1.7; color: var(--brand-muted); }
		.topic-label::before { content: "·"; margin-right: 8px; }
		.locale-badge { color: var(--brand-clay); }
		.entry h2 { font-size: 24px; line-height: 1.5; margin: 10px 0; overflow-wrap: anywhere; }
		.entry p { font-size: 16px; line-height: 1.9; color: var(--brand-body); margin: 0; max-width: 640px; }
		.entry time { padding-top: 5px; text-align: right; color: var(--brand-muted); font-size: 13px; line-height: 1.8; }
		.entry > b { font-weight: 400; color: var(--brand-accent); justify-self: end; padding-top: 2px; }
		.tags { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 13px; }
		.tags span { font-size: 13px; line-height: 1.7; color: var(--brand-muted); border: 1px solid var(--brand-line); border-radius: 20px; padding: 2px 9px; }
		.entry .search-excerpt { margin-top: 12px; padding: 12px 14px; border-left: 2px solid var(--brand-accent); background: var(--brand-surface); color: var(--brand-body); overflow-wrap: anywhere; }
		@media (max-width: 700px) {
			.notes-hero { padding: 42px 8vw 30px; }
			.notes-hero h1 { margin-block: 20px; }
			.entry { grid-template-columns: minmax(0, 1fr) 20px; gap: 12px; padding-block: 25px; }
			.entry h2 { font-size: 22px; }
			.entry time { display: none; }
			.filter-group { grid-template-columns: 30px minmax(0, 1fr); gap: 8px; }
		}

 .view-switch{display:flex;gap:4px;padding:3px;border:1px solid var(--brand-line);border-radius:10px}
 .view-switch button{padding:7px 15px;border:0;border-radius:7px;background:transparent;color:var(--brand-muted);font:inherit;cursor:pointer}
 .view-switch button[aria-pressed="true"]{background:var(--brand-sage);color:var(--brand-ink)}
 .entries-head{align-items:center}.note-grid{padding-bottom:40px}
 [data-note-view="cards"] .note-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
 [data-note-view="cards"] .entry{position:relative;display:flex;flex-direction:column;gap:16px;padding:22px;border:1px solid var(--brand-line);border-radius:16px;background:var(--site-glass);box-shadow:var(--site-glass-shadow);backdrop-filter:blur(12px);transition:border-color .18s,background .18s}
 [data-note-view="cards"] .entry[hidden]{display:none}
 [data-note-view="cards"] .entry:hover{border-color:var(--brand-accent);background:var(--site-glass-hover)}
 [data-note-view="cards"] .entry-content{flex:1;min-width:0}
 [data-note-view="cards"] .entry h2{font-size:18px!important;margin:12px 0}
 [data-note-view="cards"] .entry p:not(.search-excerpt){display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;font-size:14px;line-height:1.8}
 [data-note-view="cards"] .entry time{display:block;text-align:left;padding-top:12px;border-top:1px solid var(--brand-line);width:100%;margin-top:auto}
 [data-note-view="cards"] .entry>b{position:absolute;right:22px;bottom:24px}
 [data-note-view="cards"] .tags span{font-size:11px}
 @media(max-width:1100px){[data-note-view="cards"] .note-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
 @media(max-width:700px){.entries{padding-inline:8vw}}
 @media(max-width:560px){[data-note-view="cards"] .note-grid{grid-template-columns:1fr}}
 @media(prefers-reduced-motion:reduce){[data-note-view="cards"] .entry{transition:none}}
		/* 移动端触控目标不小于 44px；按钮换行，避免 320px 下横向溢出。 */
		@media (max-width: 700px) {
			.filters button,
			.view-switch button {
				min-height: 44px;
				padding-block: 10px;
			}
			.entries-head {
				flex-wrap: wrap;
			}
		}
 </style>
</Layout>
