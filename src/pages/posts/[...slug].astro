---
import { getCollection, render } from "astro:content";
import Comment from "@components/comment/index.astro";
import Markdown from "@components/common/Markdown.astro";
import EncryptedPost from "@components/features/EncryptedPost.astro";
import KatexManager from "@components/features/KatexManager.astro";
import BibTeXCitation from "@components/misc/BibTeXCitation.astro";
import License from "@components/misc/License.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPosts } from "@utils/content-utils";
import { getFileDirFromPath, removeFileExtension } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import AiSummary from "@/components/common/AiSummary.astro";
import CoverImage from "@/components/common/CoverImage.astro";
import ArticleBrandStyle from "@/components/features/ArticleBrandStyle.astro";
import ArticleLocalGraph from "@/components/features/ArticleLocalGraph.svelte";
import GardenMaturityBadge from "@/components/features/GardenMaturityBadge.astro";
import InteractiveMathEnhancer from "@/components/features/InteractiveMathEnhancer.astro";
import Mindmap from "@/components/features/Mindmap.svelte";
import ReadingChain from "@/components/features/ReadingChain.astro";
import ReadingProgress from "@/components/features/ReadingProgress.svelte";
import RelatedArticles from "@/components/features/RelatedArticles.astro";
import SeriesNav from "@/components/features/SeriesNav.astro";
import PostMetadata from "@/components/layout/PostMeta.astro";
import { coverImageConfig } from "@/config/coverImageConfig";
import { licenseConfig } from "@/config/licenseConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import { brandTranslations } from "@/i18n/brand";
import { buildConceptGraph } from "@/utils/article-concept-graph";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { findConnectedLabs } from "@/utils/digital-garden";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { buildReadingChain } from "@/utils/reading-chain";
import { buildRelatedByTags } from "@/utils/related-articles";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const englishEntries = await getCollection("enPosts");
	return blogEntries.map((entry) => {
		// 将 id 转换为 slug（移除扩展名）以匹配路由参数
		const slug = removeFileExtension(entry.id);
		const translation = englishEntries.find(
			(englishEntry) => englishEntry.data.sourceId === slug,
		);
		return {
			params: { slug },
			props: {
				entry,
				localeZhUrl: `/posts/${slug}/`,
				localeEnUrl: translation
					? `/en/posts/${translation.data.slug}/`
					: undefined,
			},
		};
	});
}

const { entry, localeZhUrl, localeEnUrl } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);

// 全站已发布文章只取一次，阅读链、系列导航与相关阅读都从这一份数据派生。
// 加密文章不进入任何导航，避免把读者带到需要密码的页面。
const currentSlug = removeFileExtension(entry.id);
const publishedPosts = (await getSortedPosts()).filter(
	(post) => !post.data.draft && !post.data.password,
);
const chainSource = publishedPosts.map((post) => ({
	slug: removeFileExtension(post.id),
	title: post.data.title,
	published: post.data.published,
	category: post.data.category,
}));

// 阅读链：同主题优先，分类内没有邻居时退回发布时间相邻。
const readingChain = buildReadingChain(chainSource).get(currentSlug);

// 系列导航：只有 frontmatter 声明了 series 的文章才显示。
const seriesName = entry.data.series?.trim() ?? "";
const seriesOrder = entry.data.seriesOrder ?? 0;
const seriesItems =
	seriesName && seriesOrder > 0
		? publishedPosts
				.filter(
					(post) =>
						post.data.series?.trim() === seriesName &&
						typeof post.data.seriesOrder === "number",
				)
				.map((post) => ({
					slug: removeFileExtension(post.id),
					title: post.data.title,
					order: post.data.seriesOrder as number,
				}))
				.sort((a, b) => a.order - b.order)
		: [];

// 相关阅读：跨分类，按共同标签；开关在 siteConfig.post.showRelatedByTags。
// 上/下一篇已经出现在阅读链里，这里去重，避免同一页重复推荐同一篇。
const chainNeighbours = new Set<string>(
	[readingChain?.prev?.slug ?? "", readingChain?.next?.slug ?? ""].filter(
		Boolean,
	),
);
const relatedArticles = siteConfig.post.showRelatedByTags
	? buildRelatedByTags(
			publishedPosts.map((post) => ({
				slug: removeFileExtension(post.id),
				title: post.data.title,
				tags: post.data.tags ?? [],
				published: post.data.published,
			})),
			currentSlug,
		).filter((item) => !chainNeighbours.has(item.slug))
	: [];

const connectedLabs = findConnectedLabs(
	entry.data.tags ?? [],
	entry.data.category ?? "",
	entry.data.title,
);

const bannerPostMeta = {
	title: entry.data.title,
	published: entry.data.published,
	updated: entry.data.updated,
	words: remarkPluginFrontmatter.words,
	minutes: remarkPluginFrontmatter.minutes,
};

const wordCountMeta = {
	zh: brandTranslations["zh-CN"]["post.wordsMeta"].replace(
		"{words}",
		String(remarkPluginFrontmatter.words),
	),
	en: brandTranslations.en["post.wordsMeta"].replace(
		"{words}",
		String(remarkPluginFrontmatter.words),
	),
};
const readingTimeMeta = {
	zh: `${remarkPluginFrontmatter.minutes} 分钟阅读`,
	en: brandTranslations.en["post.readMeta"].replace(
		"{minutes}",
		String(remarkPluginFrontmatter.minutes),
	),
};

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(entry.data.image, entry.id);
const apiUrls = getApiUrlList(entry.data.image, entry.id);

dayjs.extend(utc);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	...(entry.data.updated
		? { dateModified: formatDateToYYYYMMDD(entry.data.updated) }
		: {}),
	wordCount: remarkPluginFrontmatter.words,
	inLanguage: entry.data.lang
		? entry.data.lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	...(processedImage
		? { image: new URL(processedImage, Astro.site).toString() }
		: {}),
	url: Astro.url.href,
	publisher: {
		"@type": "Person",
		name: profileConfig.name,
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": Astro.url.href,
	},
};
---

<MainGridLayout
  banner={processedImage}
  title={entry.data.title}
  description={entry.data.description}
  lang={entry.data.lang}
  setOGTypeArticle={true}
  postSlug={entry.id}
  postCategory={entry.data.category || undefined}
  localeZhUrl={localeZhUrl}
  localeEnUrl={localeEnUrl}
  headings={entry.data.password ? [] : headings}
  bannerPostMeta={bannerPostMeta}
>
  <ArticleBrandStyle />
  <!-- KaTeX 按需加载 - 仅在文章页面 -->
  <KatexManager slot="head" />
  
  <ReadingProgress client:load />

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative mb-4"
  >
    <div
      id="post-container"
      class:list={[
        "card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full ",
        {},
      ]}
    >
      <!-- word count and reading time -->
      <div
        class="flex flex-wrap text-(--content-meta) gap-5 mb-3 transition onload-animation"
      >
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2"
          >
            <Icon is:inline name="material-symbols:notes-rounded" />
          </div>
          <div
            class="text-sm"
            data-i18n="post.wordsMeta"
            data-i18n-zh={wordCountMeta.zh}
            data-i18n-en={wordCountMeta.en}
          >
            {wordCountMeta.zh}
          </div>
        </div>
        <div class="flex flex-row items-center">
          <div
            class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2"
          >
            <Icon is:inline name="material-symbols:schedule-outline-rounded" />
          </div>
          <div
            class="text-sm"
            data-i18n="post.readMeta"
            data-i18n-zh={readingTimeMeta.zh}
            data-i18n-en={readingTimeMeta.en}
          >
            {readingTimeMeta.zh}
          </div>
        </div>
        {entry.data.password && (
          <div class="flex flex-row items-center">
            <div
              class="transition h-6 w-6 rounded-md bg-(--brand-surface) text-(--brand-muted) flex items-center justify-center mr-2"
            >
              <Icon is:inline name="material-symbols:lock-outline" />
            </div>
            <div class="text-sm">
              {i18n(I18nKey.postEncrypted)}
            </div>
          </div>
        )}
      </div>

      <!-- title -->
      <div class="relative onload-animation">
        <h1
          data-pagefind-body
          data-pagefind-weight="10"
          data-pagefind-meta="title"
          class="transition w-full block font-bold mb-3
                    text-3xl md:text-[2.25rem]/[2.75rem]
                    text-black/90 dark:text-white/90
                    md:before:w-1 before:h-5 before:rounded-md before:bg-(--primary)
                    before:absolute before:top-3 before:-left-4.5"
        >
          {entry.data.title}
        </h1>
        {localeEnUrl && (
          <a
            href={localeEnUrl}
            lang="en"
            hreflang="en"
            class="inline-flex items-center text-[13px] leading-6 text-(--content-meta) hover:text-(--brand-accent) transition-colors mb-3"
          >
            English overview →
          </a>
        )}
      </div>

      <!-- metadata -->
      <div class="onload-animation">
        <PostMetadata
          className="mb-5"
          published={entry.data.published}
          updated={entry.data.updated}
          tags={entry.data.tags}
          category={entry.data.category || undefined}
          id={entry.id}
        />
        {
          !processedImage && (
            <div class="border-(--line-divider) border-dashed border-b mt-3 mb-5" />
          )
        }
      </div>

      <!-- 数字花园思想演进成熟度 -->
      <GardenMaturityBadge post={entry} lang="zh" />

      <!-- 系列导航 -->
      {seriesItems.length > 0 && (
        <div class="onload-animation mb-6">
          <SeriesNav
            series={seriesName}
            order={seriesOrder}
            items={seriesItems}
            basePath="/posts/"
            lang="zh"
          />
        </div>
      )}

      <!-- AI 摘要 -->
      {
        entry.data.aiSummary && (
          <div class="onload-animation">
            <AiSummary aiSummary={entry.data.aiSummary} />
          </div>
        )
      }

      <!-- always show cover as long as it has one -->

      {
        processedImage && coverImageConfig.enableInPost && (
          <div style="margin-top:1rem;">
            <CoverImage
              id="post-cover"
              src={processedImage}
              basePath={getFileDirFromPath(entry.filePath || '')}
              class="mb-8 rounded-xl banner-container onload-animation"
              preview={false}
              apiUrls={apiUrls}
            />
          </div>
        )
      }

      {entry.data.password ? (
        <EncryptedPost password={entry.data.password} slug={entry.id} hint={entry.data.passwordHint}>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 license-container onload-animation"
              />
            )
          }
        </EncryptedPost>
      ) : (
        <>
          <Markdown class="mb-6 markdown-content onload-animation">
            <Content />
          </Markdown>
          <InteractiveMathEnhancer />

          {/* 思维导图 */}
          <Mindmap graph={buildConceptGraph(entry.data.title, entry.body ?? "", headings)} client:load />

          {
            licenseConfig.enable && (
              <License
                title={entry.data.title}
                id={entry.id}
                pubDate={entry.data.published}
                author={entry.data.author}
                sourceLink={entry.data.sourceLink}
                licenseName={entry.data.licenseName}
                licenseUrl={entry.data.licenseUrl}
                class="mb-6 license-container onload-animation"
              />
            )
          }
        </>
      )}
    </div>
  </div>

  <!-- 上次编辑时间 -->
  {
    siteConfig.post.showLastModified && (() => {
      const lastModified = dayjs(entry.data.updated || entry.data.published);
      const dateStr = lastModified.format("YYYY-MM-DD");
      const outdatedThreshold = siteConfig.post.outdatedThreshold ?? 1;

      // 1. 預設加上 hidden 隱藏，並把時間與閾值綁在 data-* 屬性
      return (
        <div
          id="outdated-card"
          class="hidden mt-2 mb-8 border-l-2 py-3.5 pl-4"
          style="border-color: var(--brand-accent)"
          data-date={lastModified.toISOString()}
          data-threshold={outdatedThreshold}
        >
          <p class="m-0 text-[13px] leading-relaxed" style="color: var(--brand-body)">
            {i18n(I18nKey.lastModifiedPrefix)}
            <span style="color: var(--brand-muted)">{dateStr}</span>
            <span id="days-ago-text" data-template={i18n(I18nKey.lastModifiedDaysAgo)}></span>
          </p>
          <p
            id="outdated-warning"
            class="mt-1 mb-0 hidden text-[12px] leading-relaxed"
            style="color: var(--brand-muted)"
          >
            {i18n(I18nKey.lastModifiedOutdated)}
          </p>
        </div>
      );
    })()
  }

  <script>
    import dayjs from "dayjs";

    const card = document.getElementById('outdated-card');
    
    if (card) {
      // 讀取伺服器給的日期，並用 dayjs 直接算出差異天數
      const lastModified = dayjs(card.dataset.date);
      const daysDiff = dayjs().diff(lastModified, "day");
      const threshold = Number(card.dataset.threshold);

      // 如果超過閾值，就顯示卡片與提示文字
      if (daysDiff >= threshold) {
        card.classList.remove('hidden');

        if (daysDiff >= 1) {
          const textEl = document.getElementById('days-ago-text');
          if (textEl && textEl.dataset.template) {
            textEl.textContent = `，${textEl.dataset.template.replace("{days}", daysDiff.toString())}`;
          }
          
          const warningEl = document.getElementById('outdated-warning');
          if (warningEl) {
            warningEl.classList.remove('hidden');
          }
        }
      }
    }
  </script>

  <!-- BibTeX 引用 -->
  <BibTeXCitation
    title={entry.data.title}
    authors={entry.data.author}
    pubDate={entry.data.published}
    url={Astro.url.href}
    slug={removeFileExtension(entry.id)}
  />

  <!-- 知识邻域拓扑与 Andy Matuschak 滑动侧栈 -->
  <ArticleLocalGraph
    currentPost={{
      slug: currentSlug,
      title: entry.data.title,
      category: entry.data.category || undefined,
      tags: entry.data.tags,
      maturity: entry.data.maturity,
    }}
    relatedArticles={relatedArticles}
    seriesArticles={seriesItems}
    connectedLabs={connectedLabs}
    lang="zh"
    client:load
  />

  <ReadingChain
    prev={readingChain?.prev ?? null}
    next={readingChain?.next ?? null}
    basePath="/posts/"
    allHref={url("/notes/")}
    lang="zh"
  />

  {relatedArticles.length > 0 && (
    <RelatedArticles items={relatedArticles} basePath="/posts/" lang="zh" />
  )}

  <!-- 评论 -->
  {entry.data.comment && !entry.data.password && <Comment post={entry} />}
</MainGridLayout>
