---
import roundSix from "../../../../docs/intelligence-history/round-six/research.json";
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import {
	researchArticles,
	researchReview,
	classificationLabels,
	graphLabels,
	researchSourceForClaim,
	researchArticleForConclusion,
	type ResearchArticle,
} from "@/data/intelligenceResearch";
import { getRouteById } from "@/data/intelligenceRoutes";
import "@/styles/intelligence-research.css";
export function getStaticPaths() {
	return researchArticles.map((article) => ({
		params: { id: article.id },
		props: { article },
	}));
}
interface Props {
	article: ResearchArticle;
}
const { article } = Astro.props;
const reviews = researchReview.reviews.filter(
	(review) => review.article === article.id,
);
---
<ExploreLayout title={article.title} titleEn={article.titleEn} description={article.data.synthesis[0].text} descriptionEn="A Chinese-language research synthesis with reviewed conclusions and source locations.">
	<article class="research-page" lang="zh-CN" data-pagefind-body>
		<nav class="research-nav"><a href="/research/intelligence/">← 综合研究</a><a href="#conclusions">6条结论</a><a href="#figures">可编辑图</a><a href={`/research/intelligence/sources/?article=${article.id}`}>文献与原文定位</a></nav>
		<header><p class="kicker">REVIEWED SYNTHESIS · 2026.10.28</p><h1>{article.title}</h1><p class="lead">先固定解释对象，再比较证据与竞争解释。以下正文与结论按第四阶段共同复核呈现，来源阅读范围保持原记录。</p></header>
		<div class="text-column">{article.data.synthesis.map((section, index) => <section><h2>{section.title}</h2><p>{article.id === "evidence" && index === 5 ? "这组结论建立了有条件的比较起点。系统边界、意义与体验已由另外两篇综述展开；跨篇联系仍须明确桥接前提。共同复核保留尚未区分的模型与下一项检验，不把一个更大的总分当成对本质的回答。" : section.text}</p></section>)}</div>
		<section id="conclusions"><h2>六条结论：条件、反方与下一问</h2><p class="quiet">每条原文定位指向来源页的具体主张；这里的“原文转述”与“本站综合判断”分别呈现。</p>{reviews.map(review => { const original = article.data.conclusions.find(c => c.id === review.id)!; return <section class="conclusion" id={review.id}><span class="tag">{review.id.toUpperCase()}</span><span class="tag">{classificationLabels[review.classification]}</span><h3>{review.title}</h3><p class="lead">{review.revised}</p>{roundSix.revisions.filter(item => item.id === review.id).map(item => <p class="scope-note"><strong>第六轮补充：</strong>{item.change} <a href="/research/intelligence/revisit/">查看新证据与范围 →</a></p>)}{["p4", "p5"].includes(review.id) && <p class="scope-note"><strong>第七轮复核：</strong>群体研究的版本、数据与两阶段模型已复核：三任务载荷平方均值四舍五入后与更正值一致，八任务不同且原因尚未查明。<a href="/research/intelligence/verification/">查看进度与范围 →</a></p>}<details><summary>成立前提、强反方与下一项检验</summary><dl><dt>成立前提</dt><dd>{original.assumptions}</dd><dt>强反方</dt><dd>{original.objection}</dd><dt>回应</dt><dd>{original.response}</dd><dt>下一项检验</dt><dd>{original.discriminator}</dd><dt>适用范围</dt><dd>{original.scope}</dd></dl></details><div class="citations">{review.evidence.map(id => { const source = researchSourceForClaim(id); return <a href={`/research/intelligence/sources/${source.id}/#${id}`}>{id}</a>; })}</div><p class="quiet">跨篇对照：{review.related.map(id => <a href={`/research/intelligence/${researchArticleForConclusion(id).id}/#${id}`}>{id}　</a>)} · <a href={`/research/intelligence/review/#${review.id}`}>查看原句与修订理由</a></p></section>; })}</section>
		<section id="figures"><h2>证据关系与演进图</h2><p>图中的历史日期不表示后来的研究已经解决前面的所有问题。关系类型与阅读范围见对应来源。</p>{article.graphs.map(graph => <figure><h3>{graphLabels[graph]}</h3><a href={`/research/intelligence/${article.id}/${graph}.svg`}><img loading="lazy" class="research-map" src={`/research/intelligence/${article.id}/${graph}.svg`} alt={graphLabels[graph]} /></a><figcaption><a href={`/research/intelligence/${article.id}/${graph}.svg`}>打开大图及图内引用</a> · <a href={`/research/intelligence/${article.id}/${graph}.svg`} download>下载SVG</a> · <a href={`/research/intelligence/${article.id}/${graph}.mmd`} download>编辑Mermaid</a></figcaption></figure>)}</section>
		<details><summary>方法核验与维护材料</summary><p>这些检查是有限数学模型，不是人类实验或原始数据复现。</p><nav class="research-nav"><a href={`/research/intelligence/downloads/${article.id}-protocol.md`}>先行协议</a><a href={`/research/intelligence/downloads/${article.id}-results.json`}>精确结果</a><a href={`/research/intelligence/downloads/${article.id}.json`} download>研究源数据</a></nav></details>
		<h2>回到相关路线</h2><nav class="research-nav">{article.routes.map(id => <a href={`/routes/${id}/`}>{getRouteById(id)?.nameZh}</a>)}</nav>
	</article>
</ExploreLayout>
