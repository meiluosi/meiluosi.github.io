---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import ReadingPathCards from "@/components/features/ReadingPathCards.astro";
const loop = [
	{ title: "提出问题", en: "Ask", body: "什么能力值得改进？", bodyEn: "Which capability should improve?", href: "/work/" },
	{ title: "构建实验", en: "Build", body: "把问题变成可操作的系统。", bodyEn: "Turn the question into a working system.", href: "/lab/" },
	{ title: "获得反馈", en: "Observe", body: "从环境、搜索和数据中获得信号。", bodyEn: "Gather signals from environments, search, and data.", href: "/paths/search-to-self-play/" },
	{ title: "评估变化", en: "Evaluate", body: "变化来自哪里，能否复现？", bodyEn: "What caused the change? Can it be reproduced?", href: "/paths/evaluating-improvement/" },
	{ title: "改进系统", en: "Improve", body: "让下一轮有更好的起点。", bodyEn: "Give the next iteration a better starting point.", href: "/paths/models-to-systems/" },
];
---
<ExploreLayout title="RSI 导读" titleEn="RSI guide" description="从反馈学习、因果评估与模型系统，进入递归自我改进这个长期问题。" descriptionEn="Explore recursive self-improvement through learning, causal evaluation, and model systems.">
	<header class="explore-hero"><p class="explore-kicker">A STARTING POINT / RSI → AGI</p><Text as="h1" zh="让改进，成为下一次改进的起点。" en="Let improvement improve what comes next." /><Text as="p" class="explore-lead" zh="我是枫语，从研究生阶段开始关注智能。这里的学习、实验与系统构建，都围绕一个长期方向展开：推进递归自我改进（RSI），探索通向 AGI 的路径。" en="I’m Feng Yu. My interest in intelligence began during graduate school. My learning, experiments, and system building share a long-term direction: advancing recursive self-improvement (RSI) and exploring a path toward AGI." /></header>
	<section class="explore-section"><Text as="h2" zh="先把问题说清楚。" en="First, clarify the question." /><Text as="p" class="explore-body" zh="递归自我改进关心的，是改进后的系统能否进一步提升自身产生改进的能力。一次训练、一次搜索或一次工具调用，可以是这个问题的研究材料；要形成持续的递归过程，还需要可靠的反馈、评估与更新机制。" en="Recursive self-improvement asks whether an improved system can become better at producing further improvements. Training, search, and tool use offer ways to study parts of this question. A sustained recursive process also needs reliable feedback, evaluation, and update mechanisms." /><Text as="p" class="explore-body" zh="AGI 是更广泛的目标：能在多种任务和情境中学习、推理与行动的通用智能。这里把 RSI 作为探索方向；从局部能力提升到通用智能，中间仍有许多开放问题。" en="AGI is the broader goal: general intelligence that can learn, reason, and act across tasks and contexts. RSI is the direction explored here; many questions remain between improving a local capability and reaching general intelligence." /><a class="explore-link" href="/about/"><Text zh="认识这条路径背后的人" en="Meet the person behind this direction" /> ↗</a></section>
	<section class="explore-section"><Text as="h2" zh="把长期问题拆成一个循环。" en="Break the question into a loop." /><Text as="p" class="explore-body" zh="这是组织本站内容的阅读框架。点击每一步，进入对应的问题、实验与笔记。" en="This is a reading framework for the site. Follow each step to its questions, experiments, and notes." /><ol class="research-loop">{loop.map((step, i) => <li><a href={step.href}><span>0{i + 1} <b aria-hidden="true">{i === 4 ? "↻" : "→"}</b></span><Text as="h3" zh={step.title} en={step.en} /><Text as="p" zh={step.body} en={step.bodyEn} /></a></li>)}</ol></section>
	<section class="explore-section"><Text as="h2" zh="从三个具体问题开始。" en="Start with three concrete questions." /><ReadingPathCards /></section>
	<section class="explore-section open-questions"><div><p class="explore-kicker">QUESTIONS TO KEEP OPEN</p><Text as="h2" zh="值得继续追问的事。" en="Questions worth keeping open." /></div><ul class="explore-body"><li><Text zh="能力提升来自更多计算、更好的数据，还是系统改进了自己的学习方式？" en="Does a gain come from more compute, better data, or an improved way of learning?" /></li><li><Text zh="评估能否发现过拟合、能力退化，以及只对某一项指标有效的优化？" en="Can evaluation expose overfitting, regressions, and gains limited to one metric?" /></li><li><Text zh="一轮实验的反馈，怎样可靠地进入下一轮决策，而不让误差不断累积？" en="How can feedback inform the next decision without accumulating errors?" /></li></ul></section>
	<a class="explore-link" href="/library/"><Text zh="带着问题去读原始资料" en="Take these questions to the source material" /> ↗</a>
</ExploreLayout>
<style>.research-loop{list-style:none;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;padding:0;margin:28px 0}.research-loop a{display:block;height:100%;padding:22px 16px;border:1px solid var(--brand-line);border-radius:12px;color:var(--brand-ink);background:var(--brand-surface);text-decoration:none}.research-loop a:hover{border-color:var(--brand-accent)}.research-loop span{display:flex;justify-content:space-between;color:var(--brand-accent);font:11px monospace}.research-loop :global(h3){font-size:17px;margin:22px 0 10px}.research-loop :global(p){font-size:12px;line-height:1.9;color:var(--brand-body)}.open-questions{display:grid;grid-template-columns:1fr 1fr;gap:35px}.open-questions li{margin:15px 0}@media(max-width:850px){.research-loop{grid-template-columns:1fr}.research-loop a{padding:20px}.research-loop :global(h3){margin:12px 0 4px}.research-loop :global(p){margin:0}.open-questions{grid-template-columns:1fr;gap:0}}</style>
