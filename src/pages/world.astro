---
import Text from "@/components/common/BilingualText.astro";
import ExploreWorld from "@/components/features/ExploreWorld.svelte";
import ExploreLayout from "@/layouts/ExploreLayout.astro";

const stations = [
	{
		number: "01",
		title: "文本编码与模型训练",
		titleEn: "Text encoding and model training",
		text: "在文字桌前，把一句话拆开，看看它怎样走向预测、训练与评测。",
		textEn:
			"At the word desk, take a sentence apart and follow it into prediction, training, and evaluation.",
		href: "/lab/model-pipeline/",
		link: "从一句话开始",
		linkEn: "Start with a sentence",
	},
	{
		number: "02",
		title: "搜索预算与决策质量",
		titleEn: "Search budget and decision quality",
		text: "在棋盘旁停一会儿，沿着搜索树看看，下一步还有哪些可能。",
		textEn:
			"Pause beside the board and follow a search tree to see what the next move could be.",
		href: "/lab/mcts/",
		link: "沿着棋局想一想",
		linkEn: "Think through a move",
	},
	{
		number: "03",
		title: "因果效应与干预评估",
		titleEn: "Causal effects and intervention evaluation",
		text: "换一种安排，观察两组人的差异。这里用模拟数据，把问题放慢一点。",
		textEn:
			"Change the assignment and observe two groups. Simulated data lets us slow the question down.",
		href: "/lab/causal-playground/",
		link: "换个角度观察",
		linkEn: "Try another point of view",
	},
];
---
<ExploreLayout title="研究花园" titleEn="Research garden" description="文字桌、棋盘与观星台。在自由漫步的数字花园中，沿着好奇心动手看看。" descriptionEn="A word desk, a board, and an observation table. Wander freely in Feng Yu's 3D knowledge garden.">
	<header class="world-heading compact-page-heading"><Text as="h1" zh="三维探索花园与研究工作台" en="3D Research Garden & Workspace" /></header>
	<div class="world-stage"><ExploreWorld immersive client:idle /><noscript><p>请启用 JavaScript 探索三维场景，也可以从下方直接进入实验。 / Enable JavaScript for the 3D scene, or open an experiment below.</p></noscript></div>
	<div class="world-caption"><Text as="span" zh="模型训练、搜索决策与因果评估的交互实验入口。" en="Interactive experiments in model training, search, and causal evaluation." /><a href="/notes/"><Text zh="查看技术文章" en="Browse technical articles" /> ↗</a></div>
	<section class="world-stations" aria-label="研究装置" data-i18n-aria-label-zh="研究装置" data-i18n-aria-label-en="Research installations">{stations.map((station) => <article><span class="station-number">{station.number} /</span><Text as="h2" zh={station.title} en={station.titleEn} /><Text as="p" zh={station.text} en={station.textEn} /><a class="explore-link" href={station.href}><Text zh={station.link} en={station.linkEn} /> ↗</a></article>)}</section>
	<aside class="world-margin-note"><div><p class="margin-kicker"><Text zh="纸边的另一个问题" en="Another question in the margin" /></p><Text as="h2" zh="Strandbeest 连杆机构与轨迹分析" en="Strandbeest linkage and trajectory analysis" /><Text as="p" zh="从几何到运动，再到制造的设想。实体打印、装配与行走仍待验证。" en="From geometry to motion, and towards making. Physical printing, assembly, and walking remain unverified." /></div><a href="/essays/strandbeest/"><Text zh="看看会走路的连杆" en="Explore the walking linkage" /> <span aria-hidden="true">↗</span></a></aside>
</ExploreLayout>
<style>
	.world-heading{display:grid;grid-template-columns:1.3fr .7fr;gap:40px;align-items:end;padding:45px 0 30px}.world-heading :global(h1){font:400 clamp(30px,4.2vw,50px)/1.4 Georgia,"Songti SC",serif;letter-spacing:-.04em;margin:0}.world-heading :global(p:last-child){font-size:15px;line-height:1.9;color:var(--brand-body);max-width:360px;margin:0}.world-heading .explore-kicker{margin-bottom:16px;font-size:12px;letter-spacing:.04em}.world-stage{position:relative;height:clamp(560px,74svh,820px);border:1px solid var(--brand-line);border-radius:16px;overflow:hidden;background:radial-gradient(ellipse at 76% 20%,var(--brand-peach),transparent 48%),var(--brand-surface)}.world-stage noscript p{position:relative;z-index:2;padding:30px;font-size:15px}.world-caption{display:flex;justify-content:space-between;gap:20px;padding:18px 3px;font-size:12px;line-height:1.8;color:var(--brand-muted)}.world-caption a{color:var(--brand-accent);text-decoration:none}.world-caption a:hover{text-decoration:underline;text-underline-offset:4px}.world-stations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:30px}.world-stations article{border-top:1px solid var(--brand-line);padding-top:25px}.station-number{font:12px monospace;color:var(--brand-clay)}.world-stations :global(h2){font:400 22px/1.6 Georgia,"Songti SC",serif;margin:15px 0 10px}.world-stations :global(p){font-size:15px;line-height:1.9;color:var(--brand-body)}.world-stations .explore-link{font-size:14px;min-height:44px}.world-margin-note{display:flex;align-items:end;justify-content:space-between;gap:32px;border-top:1px solid var(--brand-line);margin-top:54px;padding:28px 0 6px}.world-margin-note>div{max-width:640px}.world-margin-note .margin-kicker{font-size:12px;color:var(--brand-clay);margin:0 0 12px}.world-margin-note :global(h2){font:400 25px/1.6 Georgia,"Songti SC",serif;margin:0}.world-margin-note :global(p){font-size:15px;line-height:1.9;color:var(--brand-body)}.world-margin-note>a{display:inline-flex;align-items:center;gap:15px;min-height:44px;flex-shrink:0;color:var(--brand-accent);font-size:14px;text-decoration:none;border-bottom:1px solid var(--brand-line)}.world-margin-note>a:hover{border-color:var(--brand-accent)}@media(max-width:760px){.world-heading{grid-template-columns:1fr;gap:20px;padding-top:30px}.world-stage{height:590px;border-radius:12px}.world-stations{grid-template-columns:1fr;gap:25px}.world-caption{flex-direction:column;gap:7px}.world-margin-note{align-items:start;flex-direction:column;gap:8px;margin-top:35px}}
</style>
