---
import ExploreLayout from "@/layouts/ExploreLayout.astro";
import Text from "@/components/common/BilingualText.astro";
import ExploreWorld from "@/components/features/ExploreWorld.svelte";
const stations = [
	{ number: "01", title: "从随机权重到一个模型", titleEn: "From random weights to a model", text: "在互动导读中串起数据、分词、从零预训练、后训练、评测与部署。", textEn: "Connect data, tokenization, pretraining from scratch, post-training, evaluation, and deployment in an interactive guide.", href: "/lab/model-pipeline/", link: "进入模型工作台", linkEn: "Open the model workbench" },
	{ number: "02", title: "让反馈参与下一次选择", titleEn: "Let feedback shape the next choice", text: "展开搜索树，观察有限预算下的探索与利用。", textEn: "Expand a search tree and observe exploration and exploitation under a limited budget.", href: "/lab/mcts/", link: "运行一次搜索", linkEn: "Run a search" },
	{ number: "03", title: "怎样知道改变有效？", titleEn: "How do we know a change works?", text: "调整分配方式，看看观察到的差异从哪里来。", textEn: "Change the assignment mechanism and see where an observed difference comes from.", href: "/lab/causal-playground/", link: "打开因果实验", linkEn: "Open the causal experiment" },
];
---
<ExploreLayout title="研究岛" titleEn="Research island" description="探索枫语的智能研究工作室：模型训练、反馈学习与因果评估。" descriptionEn="Explore Feng Yu's research workshop: model training, learning from feedback, and causal evaluation.">
	<header class="world-heading"><div><p class="explore-kicker">A SMALL WORLD / A LONG-TERM QUESTION</p><Text as="h1" zh="欢迎来到，研究岛。" en="Welcome to the research island." /></div><Text as="p" zh="三个装置，沿着尝试、反馈与评估相连。选一个方向，开始探索。" en="Three installations connected by experiments, feedback, and evaluation. Choose a direction and explore." /></header>
	<div class="world-stage"><ExploreWorld immersive client:idle /><noscript><p>请启用 JavaScript 探索三维场景，也可以从下方直接进入实验。 / Enable JavaScript for the 3D scene, or open an experiment below.</p></noscript></div>
	<div class="world-caption"><span>MODEL → FEEDBACK → EVALUATION ↺</span><a href="/paths/"><Text zh="沿阅读路线深入" en="Continue with a reading path" /> ↗</a></div>
	<section class="world-stations" aria-label="研究装置" data-i18n-aria-label-zh="研究装置" data-i18n-aria-label-en="Research installations">{stations.map((station) => <article><span class="station-number">{station.number} /</span><Text as="h2" zh={station.title} en={station.titleEn} /><Text as="p" zh={station.text} en={station.textEn} /><a class="explore-link" href={station.href}><Text zh={station.link} en={station.linkEn} /> ↗</a></article>)}</section>
</ExploreLayout>
<style>
	.world-heading{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:end;padding:45px 0 30px}.world-heading :global(h1){font:400 clamp(30px,4.5vw,53px)/1.3 Georgia,"Songti SC",serif;letter-spacing:-.04em;margin:0}.world-heading :global(p:last-child){font-size:13px;line-height:1.9;color:var(--brand-body);max-width:340px;margin:0}.world-heading .explore-kicker{margin-bottom:16px}.world-stage{position:relative;height:clamp(540px,74svh,820px);border:1px solid var(--brand-line);border-radius:24px;overflow:hidden;background:radial-gradient(ellipse at 76% 20%,var(--brand-peach),transparent 48%),var(--brand-surface)}.world-stage noscript p{position:relative;z-index:2;padding:30px;font-size:13px}.world-caption{display:flex;justify-content:space-between;gap:20px;padding:18px 3px;font:9px/1.8 "JetBrains Mono",monospace;color:var(--brand-muted)}.world-caption a{color:var(--brand-accent);text-decoration:none}.world-stations{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;margin-top:30px}.world-stations article{border-top:1px solid var(--brand-line);padding-top:25px}.station-number{font:10px monospace;color:var(--brand-clay)}.world-stations :global(h2){font-size:21px;line-height:1.6;margin:15px 0 10px}.world-stations :global(p){font-size:12px;line-height:1.9;color:var(--brand-body)}@media(max-width:760px){.world-heading{grid-template-columns:1fr;gap:20px;padding-top:30px}.world-stage{height:570px;border-radius:16px}.world-stations{grid-template-columns:1fr;gap:25px}.world-caption{flex-direction:column;gap:7px}}
</style>
